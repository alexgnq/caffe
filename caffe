def treat_sprite(bites, k):
    """A fish-shaped treat, eaten head first by the cat on its right."""
    img = ground_img(2, k)
    fish = union(ellipse(9, 12.6, 4.6, 2.4), poly((5, 12.6), (1.5, 10), (1.5, 15.2)))
    eaten = rbox(0, 0, 14.5 - bites * 3.5, 16, 0)
    img.fill(clip(grow(fish, 0.8), eaten), INK, 0.25)
    img.fill(clip(fish, eaten), (214, 160, 96))
    if bites == 0:
        img.fill(circle(11.8, 12, 0.5), INK)
    return img


def bun_sprite(kind, bites=0):
    """Fika: a kanelbulle, or a saffron lussekatt in December, on a little plate.
    The cat sits to its left, so the bites come out of that side."""
    img = Img(6, 3)
    cx, cy = CUP_X, CUP_Y
    img.fill(circle(cx + 1.4, cy + 2, 16), INK, 0.3)
    img.fill(circle(cx, cy, 15.5), SAUCER)
    img.fill(ring(cx, cy, 12, 0.7), SAUCER_RING)
    marks = [circle(cx - 11 + i * 5, cy + (2.5 if i % 2 else -2.5), 5.5) for i in range(bites)]

    def fill(shape, *paint):
        if marks:
            shape = clip(shape, (lambda x, y: max(-m[0](x, y) for m in marks), shape[1]))
        img.fill(shape, *paint)

    if kind == "lussekatt":
        # An S: a strand coiled one way at the top, and the other way at the bottom.
        coil = [
            (a * 0.75 * math.cos(a), a * 0.75 * math.sin(a)) for a in (i / 3 for i in range(19))
        ]
        strand = [(cx - 4 + x, cy - 4 + y) for x, y in coil] + [
            (cx + 4 - x, cy + 4 - y) for x, y in coil[::-1]
        ]
        fill(path(strand, 2.8), (196, 128, 36))
        fill(path(strand, 2.1), (240, 182, 62))
        for x, y in ((cx - 4, cy - 4), (cx + 4, cy + 4)):
            fill(circle(x, y, 1.3), (70, 30, 30))
        return img
    fill(circle(cx, cy, 10.5), (206, 140, 70))
    spiral = [
        (cx + a * 0.95 * math.cos(a), cy + a * 0.95 * math.sin(a))
        for a in (i / 3 for i in range(3, 31))
    ]
    fill(path(spiral, 0.9), (140, 82, 38))
    for x, y in ((-4, -5), (3, -6), (6, 2), (-2, 6), (-7, 1), (1, 0)):
        fill(rbox(cx + x - 0.7, cy + y - 0.4, cx + x + 0.7, cy + y + 0.4, 0.3), WHITE)
    return img


class Png:
    """A ready-made PNG picture, shown `cols` x `rows` cells big."""

    def __init__(self, data, cols, rows):
        self.data, self.cols, self.rows = data, cols, rows


def icon_sprite(pid, kind, png=True):
    """An open app's icon, 2 cols x 1 row: its own, if the terminal can show a
    PNG, or a tile in its colour."""
    data = app_icon(pid) if png else None
    if data:
        return Png(data, 2, 1)
    img, glaze = Img(2, 1), DRINKS[kind][2]
    img.fill(rbox(2, 2, 14, 14, 3.2), mix(glaze, INK, 0.3))
    img.fill(rbox(2, 1.5, 14, 13, 3.2), glaze)
    img.fill(rbox(4, 3.5, 12, 6, 1.2), mix(glaze, WHITE, 0.45), 0.8)
    return img


