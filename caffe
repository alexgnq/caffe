def cat_sit(tail=0, closed=False, groom=0, yawn=False, slap=False):  # noqa: PLR0913
    cx, sway = 28, (0, 2, -1)[tail]
    eyes = [(cx - 4.3, 21.2), (cx + 4.3, 21.2)]
    pose = {
        "tail": path(((35, 46), (42, 44.5), (45.5, 38.5), (44 + sway, 31 + sway / 2)), 2.6),
        "body": ellipse(cx, 37, 10.5, 11),
        "head": ellipse(cx, 21.5, 10, 8.5),
        "ears": [
            poly((cx - 9.6, 19), (cx - 8, 8.5), (cx - 2.4, 14.6)),
            poly((cx + 2.4, 14.6), (cx + 8, 8.5), (cx + 9.6, 19)),
        ],
        "inner": [
            poly((cx - 8, 16.5), (cx - 7.4, 11.6), (cx - 4.4, 15)),
            poly((cx + 4.4, 15), (cx + 7.4, 11.6), (cx + 8, 16.5)),
        ],
        "light": [
            ellipse(cx, 38.5, 5.6, 8),
            ellipse(cx - 2, 26, 2.9, 2.2),
            ellipse(cx + 2, 26, 2.9, 2.2),
        ],
        "paws": [ellipse(cx - 4, 46.2, 3.3, 2), ellipse(cx + 4, 46.2, 3.3, 2)],
        "nose": poly((cx - 1.4, 24.1), (cx + 1.4, 24.1), (cx, 25.6)),
        "eyes": [] if closed or groom or yawn else eyes,
        "closed": [path(((x - 1.7, y), (x, y + 1), (x + 1.7, y)), 0.6) for x, y in eyes],
        "stripes": [
            capsule(cx, 14, cx, 16.8, 0.75),
            capsule(cx - 2.8, 14.6, cx - 2.2, 17, 0.7),
            capsule(cx + 2.8, 14.6, cx + 2.2, 17, 0.7),
            *(
                capsule(cx + s * 10.3, y, cx + s * 6.5, y + 1, 0.8)
                for s in (-1, 1)
                for y in (33, 37.5)
            ),
        ],
    }
    if slap:
        px, py = (cx - 6, 29) if slap == 1 else (cx - 13.5, 37.5)
        pose["legs"] = [capsule(cx - 6, 36, px, py, 2.4)]
        pose["paws"] = [ellipse(px, py, 2.8, 2.3), pose["paws"][1]]
    if slap == 3:
        pose["legs"] = []
        pose["paws"] = [ellipse(cx - 4, 46.2, 3.3, 2), pose["paws"][1]]
        pose["eyes"] = [(x - 1, y + 0.5) for x, y in eyes]
    if groom:
        pose["paws"] = [pose["paws"][0], ellipse(cx + 2.5, 29.5 - groom, 2.6, 3.2)]
    if yawn:
        pose["mouth"] = ellipse(cx, 28, 2.1, 2.5)
    return pose


