]
CAT_NAMES = ["Mocha", "Miso", "Biscotti", "Pixel", "Bean", "Cortado", "Nibs", "Ristretto"]
CALICO_ORANGE = (232, 140, 60)


def cat_sit(tail=0, closed=False, groom=0, yawn=False, slap=0):  # noqa: PLR0913
    """Sitting on the table and looking up at you."""
    cx, hy, sway = 30, 17, (0, 2.5, -2)[tail]
    eyes = [(cx - 4, hy + 0.5), (cx + 4, hy + 0.5)]
    pose = {
        "tail": path(
            ((cx + 8, 42), (cx + 13.5, 39), (cx + 15 + sway, 31), (cx + 13 + sway, 25)), 2.4
        ),
        "body": ellipse(cx, 33, 11, 11.5),
        "head": ellipse(cx, hy, 10, 9.3),
        "ears": [
            poly((cx - 9.5, hy - 2), (cx - 8, hy - 12.5), (cx - 2.5, hy - 8.5)),
            poly((cx + 2.5, hy - 8.5), (cx + 8, hy - 12.5), (cx + 9.5, hy - 2)),
        ],
        "inner": [
            poly((cx - 8, hy - 4), (cx - 7.2, hy - 10), (cx - 4, hy - 8)),
            poly((cx + 4, hy - 8), (cx + 7.2, hy - 10), (cx + 8, hy - 4)),
        ],
        "light": [ellipse(cx, 36.5, 5.5, 5.5), ellipse(cx, hy + 5.2, 3.8, 2.7)],
        "paws": [ellipse(cx - 4.5, 43.6, 3, 2), ellipse(cx + 4.5, 43.6, 3, 2)],
        "nose": poly((cx - 1.4, hy + 3.4), (cx + 1.4, hy + 3.4), (cx, hy + 4.8)),
        "eyes": [] if closed or groom or yawn else eyes,
        "eye": 1.25,
        "closed": [path(((x - 1.9, y), (x, y + 1.1), (x + 1.9, y)), 0.6) for x, y in eyes],
        "stripes": [
            capsule(cx, hy - 9.4, cx, hy - 6.2, 0.75),
            capsule(cx - 2.8, hy - 8.8, cx - 2.3, hy - 5.9, 0.7),
            capsule(cx + 2.8, hy - 8.8, cx + 2.3, hy - 5.9, 0.7),
            *(
                capsule(cx + s * 10.6, y, cx + s * 7, y + 1, 0.8)
                for s in (-1, 1)
                for y in (29.5, 34)
            ),
        ],
        "patches": [
            (ellipse(cx - 6, 30, 6, 5), CALICO_ORANGE),
            (ellipse(cx + 5, hy - 4, 5, 4), None),
            (ellipse(cx + 6, 39, 4.5, 4), CALICO_ORANGE),
        ],
    }
    if slap:  # a paw reaching out to the left, to push a cup off the table
        px, py = (cx - 10, 27) if slap == 1 else (cx - 17, 35)
        pose["legs"] = [capsule(cx - 6, 34, px, py, 2.4)]
        pose["paws"] = [ellipse(px, py, 2.9, 2.4), pose["paws"][1]]
    if slap == 3:
        pose["legs"] = []
        pose["paws"] = [ellipse(cx - 4.5, 43.6, 3, 2), pose["paws"][1]]
        pose["eyes"] = [(x - 1, y + 0.5) for x, y in eyes]  # watching it fall
    if groom:
        pose["paws"] = [pose["paws"][0], ellipse(cx + 3, hy + 6 - groom, 2.8, 3.4)]
    if yawn:
        pose["mouth"] = ellipse(cx, hy + 6.6, 2.2, 2.6)
    return pose


def cat_hiss():
    """Ears flat, eyes wide, mouth open."""
    cx, hy = 30, 17
    pose = cat_sit()
    pose["ears"] = [
        poly((cx - 9.5, hy - 1), (cx - 15, hy - 6), (cx - 5, hy - 7.5)),
        poly((cx + 5, hy - 7.5), (cx + 15, hy - 6), (cx + 9.5, hy - 1)),
    ]
    pose["inner"] = []
    pose["mouth"] = ellipse(cx, hy + 6.6, 2.2, 2.6)
    return pose


