#!/usr/bin/env python3
"""caffe: keep the Mac awake, with a coffee bar of your running agent sessions.

Every interactive Copilot CLI / Codex CLI / Claude Code session is a cup on the
counter. Busy agents steam harder. When a session ends, its cup drains and
leaves the counter. A barista cat wanders behind the cups, hops over to new
and finished ones, and naps when the bar is quiet.
Press q (or Ctrl-C) to close the bar and get your receipt.
"""

import functools
import math
import os
import random
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty


def c256(n):
    return f"\033[38;5;{n}m"


AGENTS = {
    "copilot": ("Copilot", c256(141)),
    "codex": ("Codex", c256(75)),
    "claude": ("Claude", c256(209)),
}
RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
GOLD, WOOD, COFFEE, CREMA, EMPTY = c256(220), c256(94), c256(94), c256(180), c256(240)
STEAM_SHADES = (c256(239), c256(244), c256(250))  # top row fades out
POLL_S, FRAME_S, IDLE_FRAME_S, POUR_S, LEAVE_S = 3.0, 0.15, 0.5, 2.0, 3.0
CUP_W, CELL = 9, 14
BUSY_CPU, WORKING_CPU = 25.0, 3.0

QUIPS = [
    "Brewing tokens, one sip at a time.",
    "Sleep is for laptops without agents.",
    "Espresso yourself.",
    "Decaf? Never heard of it.",
    "This display is held open by pure caffeine.",
    "Your agents are working. Your Mac is vibing.",
    "Bean there, done that.",
    "Mocha progress today.",
    "Latte work getting done.",
    "Frothing the context window.",
]
IDLE_QUIPS = [
    "No orders. The barista polishes an empty cup.",
    "Quiet bar. Start an agent and I'll pour.",
    "Counter's clean. Mac's still awake, as you asked.",
]


def parse_etime(s):
    days, rest = s.split("-", 1) if "-" in s else ("0", s)
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts
    return int(days) * 86400 + h * 3600 + m * 60 + sec


def agent_kind(args):
    for tok in args.split()[:2]:
        name = os.path.basename(tok)
        if name in AGENTS:
            return name
    return None


def scan_agents():
    """Return {pid: (kind, tty, started_at, cpu)} for interactive agent sessions."""
    try:
        out = subprocess.run(
            ["/bin/ps", "-axo", "pid=,ppid=,tty=,%cpu=,etime=,args="],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    now, found = time.time(), {}
    for line in out.splitlines():
        cols = line.split(None, 5)
        if len(cols) < 6 or cols[2] == "??":
            continue
        kind = agent_kind(cols[5])
        if kind:
            try:
                cpu = float(cols[3].replace(",", "."))
            except ValueError:
                cpu = 0.0
            found[int(cols[0])] = [kind, int(cols[1]), cols[2], now - parse_etime(cols[4]), cpu]
    # Fold helper processes whose parent is itself an agent session into that session.
    for _kind, ppid, _tty, _started, cpu in list(found.values()):
        if ppid in found:
            found[ppid][4] += cpu
    return {
        pid: (kind, tty_name, started, cpu)
        for pid, (kind, ppid, tty_name, started, cpu) in found.items()
        if ppid not in found
    }


def fmt_dur(sec):
    sec = int(sec)
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}h {m:02d}m" if h else (f"{m}m {s:02d}s" if m else f"{s}s")


def steam_rows(t, phase, cpu):
    """Three rows of drifting steam above a cup; busier agents get more wisps."""
    wisps = 3 if cpu >= BUSY_CPU else (2 if cpu >= WORKING_CPU else 1)
    columns = {1: (4,), 2: (3, 5), 3: (2, 4, 6)}[wisps]
    grid = [[" "] * CUP_W for _ in range(3)]
    for w, base in enumerate(columns):
        for r in range(3):
            # A calm cup only shows a thin wisp that flickers at the top.
            if wisps == 1 and r == 0 and math.sin(t * 1.3 + phase) < 0.3:
                continue
            angle = t * 2.4 - r * 1.1 + w * 0.6 + phase
            grid[r][base + round(math.sin(angle))] = "(" if math.cos(angle) > 0 else ")"
    return [f"{STEAM_SHADES[r]}{''.join(row)}{RESET}" for r, row in enumerate(grid)]


def pour_rows(t):
    """A coffee stream falling into the cup."""
    return [f"{COFFEE}    {'┃' if (int(t * 10) + r) % 4 else '╏'}    {RESET}" for r in range(3)]


def cup_rows(color, level, liquid=COFFEE, foam=CREMA):
    """A mug filled `level` rows from the bottom (0 to 3, the top row is crema)."""

    def inner(row):
        if level < 3 - row:
            return "     "
        return f"{foam}≈≈≈≈≈{color}" if row == 0 else f"{liquid}▓▓▓▓▓{color}"

    return [
        f"{color}┌─────┐  {RESET}",
        f"{color}│{inner(0)}├╮ {RESET}",
        f"{color}│{inner(1)}││ {RESET}",
        f"{color}│{inner(2)}├╯ {RESET}",
        f"{color}└─────┘  {RESET}",
    ]


def visible_len(s):
    out, esc = 0, False
    for ch in s:
        if ch == "\033":
            esc = True
        elif esc and ch == "m":
            esc = False
        elif not esc:
            out += 1
    return out


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


@functools.lru_cache(maxsize=512)
def ansi_cells(s):
    """Split an ANSI-colored string into ((sgr, char), ...) cells plus its solid span."""
    cells, sgr, i = [], "", 0
    while i < len(s):
        if s[i] == "\033":
            j = s.index("m", i) + 1
            sgr = "" if s[i:j] == RESET else s[i:j]
            i = j
        else:
            cells.append((sgr, s[i]))
            i += 1
    solid = [i for i, (_, ch) in enumerate(cells) if ch != " "]
    return tuple(cells), (solid[0], solid[-1]) if solid else None


class Canvas:
    """A small character grid, so the cat can walk behind the cups."""

    def __init__(self, width, height):
        self.width, self.height = width, height
        self.grid = [[None] * width for _ in range(height)]

    def put(self, x, y, cells):
        """Place pre-built (dx, (sgr, char)) cells in front of everything else."""
        if 0 <= y < self.height:
            row = self.grid[y]
            for dx, cell in cells:
                if 0 <= x + dx < self.width:
                    row[x + dx] = cell

    def draw(self, x, y, text, behind=False):
        if not 0 <= y < len(self.grid):
            return
        cells, span = ansi_cells(text)
        if span is None:
            return
        row = self.grid[y]
        for i in range(span[0], span[1] + 1):
            cx = x + i
            if 0 <= cx < self.width and not (behind and row[cx] is not None):
                row[cx] = cells[i]

    def lines(self):
        out = []
        for row in self.grid:
            parts, cur = [], ""
            for cell in row:
                sgr, ch = cell or ("", " ")
                if sgr != cur:
                    parts.append(RESET + sgr)
                    cur = sgr
                parts.append(ch)
            out.append("".join(parts).rstrip() + RESET)
        return out


# Pixel-art cat, drawn with half-blocks: each terminal cell shows two stacked
# pixels. Sprite keys: F fur, D markings, L light fur, W paws, E eye, C closed eye,
# N nose, M open mouth, . transparent. The nose is the anchor, so poses line up.
COATS = [
    ("orange tabby", {"F": 208, "D": 166, "L": 223, "W": 223, "E": 70, "C": 166}),
    ("black", {"F": 238, "D": 242, "L": 241, "W": 241, "E": 220, "C": 244}),
    ("grey tabby", {"F": 246, "D": 241, "L": 252, "W": 252, "E": 214, "C": 241}),
    ("calico", {"F": 255, "D": 237, "L": 255, "W": 255, "E": 70, "C": 237}),
    ("siamese", {"F": 230, "D": 94, "L": 230, "W": 94, "E": 39, "C": 94}),
    ("white", {"F": 255, "D": 248, "L": 255, "W": 254, "E": 39, "C": 245}),
]
CALICO_PATCHES = (255, 208, 237)
NOSE, MOUTH = 211, 160
CAT_NAMES = ["Mocha", "Miso", "Biscotti", "Pixel", "Bean", "Cortado", "Nibs", "Ristretto"]
CAT_SPEED, CAT_MIN_X, CAT_RIGHT = 9.0, 11, 12  # cols/s, lane edges around the nose

_WALK_TOP = (
    ("..F......F...F", ".F.......FEFEF"),  # tail tip curled
    (".F.......F...F", "F........FEFEF"),  # tail tip swayed
)
_WALK_BODY = (".FFDFFDFFFLNLF", ".FFFFFFFFFFFF.", "..FLLLLLLLF...")
_WALK_LEGS = ("..W.W....W.W..", "...WW.....WW..", ".W...W..W...W.", "...WW.....WW..")
_STRETCH = (
    "F.............",
    ".FF...........",
    ".FFFF....F...F",
    ".FDFFDFF.FEFEF",
    "..F..FFFFFLNLF",
    "..W....WWWW...",
)
_SIT = ("F...F...", "FEFEF...", "FLNLF...", ".FLF....", ".FLLF...", ".WFWFF..")
_SIT_TAILS = (
    ((6, 4), (7, 3), (7, 2), (6, 1)),
    ((6, 4), (6, 3), (7, 2), (7, 1)),
    ((6, 5), (7, 5), (7, 4)),
)
_NAP = ("FCFCFFFFFFF.", "FLNLFDFFDFFF", "WWFFFFFFFFFF")
_NAP_BREATH = (".F.F........", ".F.F.FFFFF..")


def _set(rows, x, y, ch):
    rows[y] = rows[y][:x] + ch + rows[y][x + 1 :]


def cat_walk(step):
    tip, legs = _WALK_TOP[step // 4 % 2], _WALK_LEGS[step % 4]
    return (*tip, *_WALK_BODY, legs)


def cat_sit(eyes="E", tail=0, yawn=False, groom=0):
    rows = list(_SIT)
    rows[1] = rows[1].replace("E", eyes)
    for x, y in _SIT_TAILS[tail]:
        _set(rows, x, y, "F")
    if yawn:
        _set(rows, 2, 2, "M")
        _set(rows, 2, 3, "M")
    if groom:
        _set(rows, 4, 1 + groom, "W")  # paw goes up to the face and back
        _set(rows, 3, 5, "F")
    return tuple(rows)


def cat_nap(breath):
    return (_NAP_BREATH[breath], *_NAP)


@functools.lru_cache(maxsize=256)
def sprite(rows, coat, flip):
    """Turn a pixel sprite into half-block cells once per pose, coat and facing."""
    if flip:
        rows = tuple(r[::-1] for r in rows)
    name, palette = COATS[coat]
    if len(rows) % 2:
        rows = ("." * len(rows[0]), *rows)

    def color(x, y):
        ch = rows[y][x]
        if ch == ".":
            return None
        if ch == "F" and name == "calico":
            return CALICO_PATCHES[(x + 2 * y) // 3 % 3]
        return {"N": NOSE, "M": MOUTH}.get(ch) or palette[ch]

    lines = []
    for y in range(0, len(rows), 2):
        line = []
        for x in range(len(rows[0])):
            top, bottom = color(x, y), color(x, y + 1)
            if top is None and bottom is None:
                continue
            if top is None:
                cell = (c256(bottom), "▄")
            elif bottom is None:
                cell = (c256(top), "▀")
            elif top == bottom:
                cell = (c256(top), "█")
            else:
                cell = (f"{c256(top)}\033[48;5;{bottom}m", "▀")
            line.append((x, cell))
        lines.append(tuple(line))
    nose = next(r.index(c) for r in rows for c in "NM" if c in r)
    return tuple(lines), nose


class Cat:
    """The barista cat. It walks along the counter in front of the cups, hops
    over to new and finished cups, grooms, yawns, stretches, and naps when the
    bar is quiet. `x` is the column of its nose."""

    def __init__(self, now, home):
        self.coat = random.randrange(len(COATS))
        self.name = random.choice(CAT_NAMES)
        self.x = self.goal = float(home)
        self.dir, self.hop, self.hop_at, self.last = 1, False, -1.0, now
        self.plan, self.mode, self.until = [], "nap", now + 4

    @property
    def title(self):
        return f"{self.name} the {COATS[self.coat][0]} cat"

    def go(self, x, hop=False):
        self.goal, self.mode, self.hop, self.plan = float(x), "walk", hop, []

    def moving(self, now):
        return self.mode == "walk" or now - self.hop_at < 0.4

    def _arrive(self, now, calm, free_x, home):
        if self.hop:
            self.hop, self.hop_at = False, now
        u = random.uniform
        if home is not None:
            self.plan = [("nap", u(20, 40)), ("stretch", 1.5), ("groom", u(2, 4))]
        elif calm and self.x >= free_x and random.random() < 0.5:
            self.plan = [("nap", u(8, 16)), ("stretch", 1.5)]
        else:
            self.plan = random.choice(
                [
                    [("sit", u(2, 5))],
                    [("groom", u(2, 3)), ("sit", u(1, 3))],
                    [("sit", u(2, 4)), ("yawn", 1.2)],
                ]
            )
        self._next(now)

    def _next(self, now):
        self.mode, dur = self.plan.pop(0)
        self.until = now + dur

    def step(self, now, lane_w, calm, free_x, home=None):
        dt = min(0.5, now - self.last)
        self.last = now
        max_x = float(max(CAT_MIN_X, lane_w - CAT_RIGHT))
        if home is not None and abs(self.goal - home) > 0.5:
            self.go(home)
        if self.mode == "walk":
            goal = min(max(self.goal, CAT_MIN_X), max_x)
            if abs(goal - self.x) <= CAT_SPEED * dt:
                self.x = goal
                self._arrive(now, calm, free_x, home)
            else:
                self.dir = 1 if goal > self.x else -1
                self.x += self.dir * CAT_SPEED * dt
        elif now >= self.until:
            if self.plan:
                self._next(now)
            elif home is not None:
                self._arrive(now, calm, free_x, home)
            elif free_x <= max_x and random.random() < 0.6:
                self.go(random.uniform(free_x, max_x))
            else:
                self.go(random.uniform(CAT_MIN_X, max_x))
        self.x = min(max(self.x, CAT_MIN_X), max_x)

    def pose(self, now):
        """Pixel rows for the current moment, and whether the sprite faces right."""
        if self.mode == "walk":
            return cat_walk(int(self.x / 1.5)), self.dir == 1
        if self.mode == "stretch":
            return _STRETCH, self.dir == 1
        if self.mode == "nap":
            return cat_nap(int(now / 1.2) % 2), self.dir == -1
        if self.mode == "groom":
            return cat_sit("C", groom=1 + int(now * 3) % 2), self.dir == -1
        if self.mode == "yawn":
            return cat_sit("C", yawn=True), self.dir == -1
        return cat_sit("C" if now % 5 < 0.3 else "E", tail=int(now * 1.5) % 3), self.dir == -1

    def draw(self, canvas, now):
        rows, faces_right = self.pose(now)
        # Base sprites face right when walking and left otherwise.
        flip = not faces_right if self.mode in ("walk", "stretch") else faces_right
        lines, nose = sprite(rows, self.coat, flip)
        left = round(self.x) - nose
        top = canvas.height - len(lines)
        if 0 <= now - self.hop_at < 0.35 and top > 0:
            top -= 1
        for i, line in enumerate(lines):
            canvas.put(left, top + i, line)
        if self.mode == "nap":
            step = int(now * 1.5)
            for i, ch in enumerate("zZ"):
                k = (step + i) % 3
                canvas.draw(round(self.x) + 1 + i, top - 1 - k, f"{STEAM_SHADES[2 - k]}{ch}", True)


# name, cell width, art rows, visible cup width
LAYOUTS = (("full", CELL, 8, 8), ("short", CELL, 6, 8), ("mini", 8, 4, 6))
HOME_X = 13


def mini_steam(t, phase, cpu):
    row = [" "] * 6
    columns = (1, 3) if cpu >= WORKING_CPU else (2,)
    for w, base in enumerate(columns):
        if len(columns) == 1 and math.sin(t * 1.3 + phase) < -0.2:
            continue
        angle = t * 2.4 + w * 0.6 + phase
        row[base + round(math.sin(angle))] = "(" if math.cos(angle) > 0 else ")"
    return f"{STEAM_SHADES[2]}{''.join(row)}{RESET}"


def mini_cup(color, level, liquid=COFFEE):
    inner = f"{liquid}▓▓▓{color}" if level else "   "
    return [f"{color}┌───┐ {RESET}", f"{color}│{inner}├╯{RESET}", f"{color}└───┘ {RESET}"]


def cup_cell(state, pid, now, layout):
    """Art rows and two label lines for one cup on the counter."""
    mini = layout == "mini"
    if pid in state["leaving"]:
        kind, tty_name, ended = state["leaving"][pid]
        progress = min(1.0, (now - ended) / LEAVE_S)
        if mini:
            art = ["", *mini_cup(EMPTY, progress < 0.5, EMPTY)]
        else:
            art = [""] * 3 + cup_rows(EMPTY, round(3 * (1 - progress)), EMPTY, EMPTY)
        status = f"{GOLD}✔ served{RESET}" if not mini else f"{GOLD}✔{RESET}"
    else:
        kind, tty_name, started, cpu = state["live"][pid]
        color = AGENTS[kind][1]
        seen = state["first_seen"].get(pid, 0)
        # Sessions already running at startup are served full; new ones pour in.
        fill = min(1.0, (now - seen) / POUR_S) if seen > state["start"] + 1 else 1.0
        if fill < 1:
            if mini:
                art = [f"{COFFEE}  ┃{RESET}", *mini_cup(color, fill >= 0.5)]
            else:
                art = pour_rows(now) + cup_rows(color, int(fill * 4))
            status = f"{GOLD}pouring…{RESET}"
        else:
            if mini:
                art = [mini_steam(now, pid % 7, cpu), *mini_cup(color, 1)]
            else:
                art = steam_rows(now, pid % 7, cpu) + cup_rows(color, 3)
            status = f"{DIM}{fmt_dur(now - started)}{RESET}"
    if layout == "short":
        art = art[2:]
    name, color = AGENTS[kind]
    label = f"{color}{name}{RESET}"
    if not mini:
        label += f" {DIM}{tty_name.replace('ttys', 's')}{RESET}"
    return art, label, status


def pick_layout(count, width, rows):
    """The roomiest layout whose counters all fit on screen."""
    for name, cell, art_h, cup_w in LAYOUTS:  # noqa: B007 (used after the loop)
        per_row = max(1, (width - 2) // cell)
        if -(-count // per_row) * (art_h + 4) <= rows:
            break
    return name, cell, art_h, cup_w, per_row


def render(state, now):
    """Return the full screen for this moment as a list of lines."""
    cols, term_rows = shutil.get_terminal_size((80, 24))
    width = min(cols, 96)
    counter = f"{WOOD}{'▀' * width}{RESET}"
    cat = state["cat"]
    calm = all(cpu < WORKING_CPU for *_, cpu in state["live"].values())
    out = [
        f"{BOLD}☕ caffe{RESET}  {DIM}Mac awake for{RESET} {BOLD}{fmt_dur(now - state['start'])}"
        f"{RESET}   {DIM}q to close the bar{RESET}",
        DIM + "─" * width + RESET,
    ]

    pids = sorted(state["live"], key=lambda p: state["live"][p][2])
    pids += sorted(state["leaving"], key=lambda p: state["leaving"][p][2])
    if not pids:
        canvas = Canvas(width, 8)
        for r, row in enumerate(cup_rows(EMPTY, 0)):
            canvas.draw(2, 3 + r, row)
        cat.step(now, width, calm=True, free_x=HOME_X, home=HOME_X)
        cat.draw(canvas, now)
        quip = random.Random(int(now // 10)).choice(IDLE_QUIPS)
        out += [*canvas.lines(), counter, f"  {DIM}{quip}{RESET}", ""]
    else:
        layout, cell, art_h, cup_w, per_row = pick_layout(len(pids), width, term_rows - 5)
        # Even mini cups can run out of room: show what fits and count the rest.
        room = max(1, (term_rows - 5) // (art_h + 4)) * per_row
        hidden = len(pids) - room if len(pids) > room else 0
        pids = pids[:room]
        groups = [pids[i : i + per_row] for i in range(0, len(pids), per_row)]
        for gi, group in enumerate(groups):
            cells = [cup_cell(state, pid, now, layout) for pid in group]
            canvas = Canvas(width, art_h)
            for ci, (art, _, _) in enumerate(cells):
                for r, row in enumerate(art):
                    canvas.draw(2 + ci * cell, r, row)
            if gi == len(groups) - 1:
                visit = state.pop("visit", None)
                if visit in group:
                    cat.go(2 + group.index(visit) * cell + cup_w + 2, hop=True)
                cat.step(now, width, calm, free_x=2 + len(group) * cell + 2)
                cat.draw(canvas, now)
            out += canvas.lines()
            out.append(counter)
            out.append("  " + "".join(pad(label, cell) for _, label, _ in cells))
            out.append("  " + "".join(pad(status, cell) for _, _, status in cells))
            out.append("")
        if hidden:
            out[-1] = f"  {DIM}+{hidden} more cups behind the counter{RESET}"

    if state["toast"] and now < state["toast"][1]:
        out.append(f"  {GOLD}{state['toast'][0]}{RESET}")
    else:
        out.append(f"  {DIM}“{QUIPS[int(now // 8) % len(QUIPS)]}”{RESET}")
    return out


def frame_delay(state):
    """Animate smoothly while something moves; tick slowly while everything naps."""
    if state["live"] and any(cpu >= WORKING_CPU for *_, cpu in state["live"].values()):
        return FRAME_S
    if state["leaving"] or state["cat"].moving(time.time()):
        return FRAME_S
    if any(state["first_seen"].get(p, 0) > time.time() - POUR_S for p in state["live"]):
        return FRAME_S
    return IDLE_FRAME_S


def update(state):
    now = time.time()
    for pid, (_, _, ended) in list(state["leaving"].items()):
        if now - ended > LEAVE_S:
            del state["leaving"][pid]
    live = scan_agents()
    if live is None:
        return
    for pid in live.keys() - state["live"].keys():
        state["first_seen"][pid] = now
        if state["initialized"]:
            state["visit"] = pid
            state["toast"] = (f"New order: {AGENTS[live[pid][0]][0]} on {live[pid][1]} ☕", now + 4)
    for pid in state["live"].keys() - live.keys():
        kind, tty_name, started, _ = state["live"][pid]
        dur = now - started
        state["leaving"][pid] = (kind, tty_name, now)
        state["visit"] = pid
        state["served"] += 1
        state["longest"] = max(state["longest"], (dur, AGENTS[kind][0]))
        state["toast"] = (f"Order up: {AGENTS[kind][0]} served after {fmt_dur(dur)} ✔", now + 5)
        state["first_seen"].pop(pid, None)
    state["live"] = live
    state["initialized"] = True


def receipt(state):
    now = time.time()
    w = 34
    line = "-" * w
    rows = [
        ("Mac kept awake", fmt_dur(now - state["start"])),
        ("Cups served", str(state["served"])),
        ("Still brewing", str(len(state["live"]))),
        ("Barista", state["cat"].name),
    ]
    if state["longest"][0] > 0:
        rows.append(("Longest pour", f"{fmt_dur(state['longest'][0])} ({state['longest'][1]})"))
    print(f"\n  {line}\n  {'CAFFE RECEIPT':^{w}}\n  {line}")
    for k, v in rows:
        print(f"  {k:<{w - len(v) - 1}} {v}")
    print(f"  {line}\n  {'Thanks, come again ☕':^{w}}\n  {line}\n")


def start_caffeinate():
    # -w ties caffeinate to our pid, so it stops even if caffe is killed.
    return subprocess.Popen(["/usr/bin/caffeinate", "-dimsu", "-w", str(os.getpid())])


def main():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return
    if sys.argv[1:]:
        sys.exit("usage: caffe   (no arguments; press q to quit)")
    if not sys.stdin.isatty():
        sys.exit("caffe needs an interactive terminal.")
    caf = start_caffeinate()
    cat = Cat(time.time(), HOME_X)
    state = {
        "start": time.time(),
        "live": {},
        "leaving": {},
        "first_seen": {},
        "served": 0,
        "longest": (0, ""),
        "cat": cat,
        "toast": (f"{cat.title} is on shift today.", time.time() + 6),
        "initialized": False,
    }

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    resized = [False]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sys.stdout.write("\033[?1049h\033[?25l")
    try:
        tty.setcbreak(fd)
        last_poll, shown = 0.0, []
        while True:
            now = time.time()
            if now - last_poll >= POLL_S:
                update(state)
                last_poll = now
            if resized[0]:
                resized[0], shown = False, []
                sys.stdout.write("\033[2J")
            lines = render(state, now)[: shutil.get_terminal_size((80, 24)).lines - 1]
            # Only rewrite lines that changed, so a quiet bar costs almost nothing.
            out = [
                f"\033[{y + 1};1H{line}\033[K"
                for y, line in enumerate(lines)
                if y >= len(shown) or shown[y] != line
            ]
            if len(lines) < len(shown):
                out.append(f"\033[{len(lines) + 1};1H\033[J")
            if out:
                sys.stdout.write("".join(out))
                sys.stdout.flush()
            shown = lines
            r, _, _ = select.select([sys.stdin], [], [], frame_delay(state))
            if r and sys.stdin.read(1).lower() == "q":
                break
            if caf.poll() is not None:
                caf = start_caffeinate()
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        caf.terminate()
        receipt(state)


if __name__ == "__main__":
    main()
