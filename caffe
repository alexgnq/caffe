def ui_host(pid, processes, names):
    """Find the outer application owning a backend, through its helper processes."""
    host, seen = None, set()
    while pid in processes and pid not in seen:
        seen.add(pid)
        match = re.search(r"/([^/]+)\.app/Contents/MacOS/[^/]+$", names.get(pid, ""))
        if match and match[1] in UI_APPS:
            host = pid, UI_APPS[match[1]]
        pid = int(processes[pid][1])
    return host


def parse_session_timestamp(value):
    """Convert the session database's ISO timestamp to an epoch value."""
    try:
        timestamp = datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if timestamp.tzinfo is None:
            timestamp = timestamp.astimezone()
        return timestamp.timestamp()
    except (OverflowError, OSError, TypeError, ValueError):
        return time.time()


def scan_copilot_sessions():
    """Read running local Copilot session metadata, never conversation history."""
    try:
        uri = COPILOT_SESSION_DB.resolve().as_uri() + "?mode=ro"
        with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
            connection.execute("PRAGMA query_only = ON")
            rows = connection.execute(
                """
                SELECT id, title, created_at
                FROM sessions
                WHERE execution_location = 'local'
                  AND session_type IN ('project', 'agent', 'general_chat')
                  AND is_running = 1
                  AND archived_at IS NULL
                ORDER BY created_at
                """
            )
            sessions = {}
            for raw_id, raw_title, created_at in rows:
                session_id = str(raw_id)
                title = re.sub(r"\s+", " ", str(raw_title or "")).strip()
                title = re.sub(r"[\x00-\x1f\x7f]", "", title)
                if not title:
                    title = f"Session {session_id[:8]}"
                key = f"{COPILOT_SESSION_KIND}:{session_id}"
                sessions[key] = (
                    COPILOT_SESSION_KIND,
                    title,
                    parse_session_timestamp(created_at),
                    0.0,
                    0.0,
                )
            return sessions
    except (OSError, sqlite3.Error):
        # The app's metadata index is optional and its schema is undocumented.
        return None


T3_SESSIONS = """
    SELECT t.thread_id, t.title, t.created_at, s.provider, s.updated_at,
           r.status, r.requested_at, r.completed_at,
           (SELECT count(*) FROM orchestration_v2_projection_runtime_requests q
             WHERE q.thread_id = t.thread_id AND q.resolved_at IS NULL)
    FROM orchestration_v2_projection_provider_sessions s
    JOIN orchestration_v2_projection_threads t ON t.thread_id = s.thread_id
    LEFT JOIN orchestration_v2_projection_runs r ON r.thread_id = t.thread_id
     AND r.ordinal = (SELECT max(ordinal) FROM orchestration_v2_projection_runs
                       WHERE thread_id = t.thread_id)
    WHERE s.status != 'stopped' AND t.archived_at IS NULL AND t.deleted_at IS NULL
"""


def t3_agent(provider):
    """The agent behind one of T3 Code's providers, such as "acpRegistry_copilot"."""
    provider = provider.lower()
    return next((kind for kind in AGENTS if kind in provider), "t3")


def scan_t3_sessions(now):
    """T3 Code's open sessions, and what each is doing, from its own records:
    ({key: session}, {key: (state, since, note)}). Read-only, and metadata only:
    titles and statuses, never messages. None if they can't be read."""
    try:
        uri = T3_SESSION_DB.resolve().as_uri() + "?mode=ro"
        with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
            connection.execute("PRAGMA query_only = ON")
            rows = connection.execute(T3_SESSIONS).fetchall()
    except (OSError, sqlite3.Error):
        return None  # its records are optional, and their layout undocumented
    sessions, told, when = {}, {}, parse_session_timestamp
    for thread, title, created, provider, updated, run, requested, completed, asks in rows:
        if run == "running":
            word, since, note = "brewing", when(requested), "in T3 Code"
        elif asks:
            word, since, note = "ready", when(updated), "needs your approval"
        elif run:
            word, since = "ready", when(completed or updated)
            note = "run failed" if run == "failed" else "waiting for you"
        else:
            word, since, note = "idle", when(updated), "in T3 Code"
        if word != "brewing" and not asks and now - since > T3_FORGET_S:
            continue
        name = re.sub(r"[\x00-\x1f\x7f]", "", re.sub(r"\s+", " ", str(title or "")).strip())
        key = f"t3:{thread}"
        sessions[key] = (t3_agent(str(provider)), name or "T3 Code", when(created), 0.0, 0.0)
        told[key] = (word, since, note)
    return sessions, told


def scan_agents():
    """CLI sessions by PID, and UI applications by (application PID, app kind)."""
    try:
        out = subprocess.run(
            ["/bin/ps", "-axo", "pid=,ppid=,tty=,%cpu=,rss=,etime=,args="],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
        commands = subprocess.run(
            ["/bin/ps", "-axo", "pid=,comm="],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return agent_sessions(out, commands, time.time())


def scan_cwds(pids):
    """The working directory of each process, by PID. Read once per new session."""
    if not pids:
        return {}
    try:
        out = subprocess.run(
            ["/usr/sbin/lsof", "-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, sorted(pids)))],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,  # lsof fails when any of the processes has already gone
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    cwds, pid = {}, None
    for line in out.splitlines():
        if line[:1] == "p" and line[1:].isdigit():
            pid = int(line[1:])
        elif line[:1] == "n" and pid is not None:
            cwds[pid] = line[1:]
    return cwds


def project_name(path):
    """A session's project: the folder it runs in, or ~ for the home folder."""
    if Path(path) == Path.home():
        return "~"
    name = os.path.basename(path.rstrip("/")) or path
    return re.sub(r"[\x00-\x1f\x7f]", "", name)


def agent_sessions(out, commands, now):
    """Classify a process snapshot without counting renderers as agent sessions."""
    names = {
        int(parts[0]): parts[1]
        for parts in (line.split(None, 1) for line in commands.splitlines())
        if len(parts) == 2
    }
    processes = {
        int(cols[0]): cols
        for cols in (line.split(None, 6) for line in out.splitlines())
        if len(cols) == 7
    }
    found, apps, usage, children = {}, {}, {}, {}
    # UI cups belong to applications, regardless of their underlying agents. An
    # app that runs a copy of itself still gets one latte, for its outermost process.
    for pid, cols in processes.items():
        match = re.search(r"/([^/]+)\.app/Contents/MacOS/[^/]+$", names.get(pid, ""))
        if match and match[1] in UI_APPS and ui_host(pid, processes, names)[0] == pid:
            kind = UI_APPS[match[1]]
            apps[pid, kind] = [kind, f"app:{DRINKS[kind][0]}", now - parse_etime(cols[5]), 0, 0]
    for pid, cols in processes.items():
        try:
            cpu = float(cols[3].replace(",", "."))
        except ValueError:
            cpu = 0.0
        ram_mb = int(cols[4]) / 1024
        usage[pid] = cpu, ram_mb
        children.setdefault(int(cols[1]), []).append(pid)
        host = ui_host(pid, processes, names)
        if host:
            owner, kind = host
            key = owner, kind
            if key not in apps:
                apps[key] = [
                    kind,
                    f"app:{DRINKS[kind][0]}",
                    now - parse_etime(processes[owner][5]),
                    0,
                    0,
                ]
            apps[key][3] += cpu
            apps[key][4] += ram_mb
        kind = agent_kind(cols[6]) or agent_kind(names.get(pid, ""))
        if os.path.basename(names.get(pid, "")) == "copilot-runtime":
            kind = "copilot"
        # CLI sessions in VS Code's or T3 Code's terminals still get individual espressos.
        if kind and cols[2] != "??" and (not host or host[1] in TERMINAL_HOSTS):
            found[pid] = (kind, int(cols[1]), cols[2], now - parse_etime(cols[5]))
    # An agent's helpers belong to its session, rather than getting cups of their own.
    roots = {pid for pid, (_, ppid, _, _) in found.items() if ppid not in found}
    sessions = {}
    for pid in roots:
        kind, _, tty_name, started = found[pid]
        # Its cup counts everything it runs, such as tools, builds and tests, but
        # not another agent session started inside it, which has its own cup.
        cpu = ram_mb = 0.0
        stack, seen = [pid], set()
        while stack:
            child = stack.pop()
            if child in seen:
                continue
            seen.add(child)
            cpu, ram_mb = cpu + usage[child][0], ram_mb + usage[child][1]
            stack += [c for c in children.get(child, ()) if c not in roots]
        sessions[pid] = (kind, tty_name, started, cpu, ram_mb)
    sessions.update((key, tuple(value)) for key, value in apps.items())
    return sessions


def fmt_mem(mb):
    """Format resident memory in compact MiB/GiB units."""
    return f"{mb / 1024:.1f}G" if mb >= 1024 else f"{mb:.0f}M"


def is_working(session):
    """Whether a session is using the CPU right now. Copilot app sessions are
    only listed while they run."""
    kind, _, _, cpu, _ = session
    return kind == COPILOT_SESSION_KIND or cpu >= WORKING_CPU


def is_app(session):
    """An open application, which gets a latte, rather than a session with a cup."""
    return session[0] != COPILOT_SESSION_KIND and session[1].startswith("app:")


def track_activity(state, live, now):
    """Remember when each session started brewing and when it last did any work."""
    activity = state.setdefault("activity", {})
    for pid, session in live.items():
        if is_app(session):
            continue
        brew_start, last_active = activity.get(pid, (None, None))
        if is_working(session):
            if last_active is None or now - last_active >= IDLE_AFTER_S:
                brew_start = now
            activity[pid] = (brew_start, now)
    for pid in activity.keys() - live.keys():
        del activity[pid]


def session_state(state, pid, now):
    """("brewing" | "ready" | "idle" | "cold", since when) for a session. Agents
    use little CPU while they wait on the model, so a session keeps brewing
    until it has been quiet for IDLE_AFTER_S. Quiet after a real spell of work,
    it's most likely waiting for you: ready. Quiet without one, it's idle."""
    told = state.get("told", {}).get(pid)
    if told:  # the app said what it's doing: no need to guess
        word, since, _ = told
        cold = word != "brewing" and now - since >= COLD_S
        return ("cold" if cold else word), since
    brew_start, last_active = state.get("activity", {}).get(pid, (None, None))
    if last_active is not None and now - last_active < IDLE_AFTER_S:
        return "brewing", brew_start
    since = last_active or state["first_seen"].get(pid, now)
    if now - since >= COLD_S:
        return "cold", since
    if last_active is not None and last_active - brew_start >= MIN_TURN_S:
        return "ready", since
    return "idle", since


def brewable(state):
    """The live sessions, which brew or go idle, unlike open apps."""
    return [pid for pid, session in state["live"].items() if not is_app(session)]


def tally_counts(state, now):
    """How many sessions are ready, brewing, idle (or cold) and just served."""
    counts = dict.fromkeys(("ready", "brewing", "idle", "served"), 0)
    for pid in brewable(state):
        word = session_state(state, pid, now)[0]
        counts["idle" if word == "cold" else word] += 1
    for pid, cup in state["leaving"].items():
        if not is_app(cup) and not gone(state, pid, now):
            counts["served"] += 1
    return counts


def tally(state, now):
    """What the bar is doing, such as "1 ready · 2 brewing · 1 idle"."""
    return " · ".join(f"{n} {word}" for word, n in tally_counts(state, now).items() if n)


def fmt_dur(sec):
    sec = int(sec)
    d, rem = divmod(sec, 86400)
    if d:
        return f"{d}d {rem // 3600}h"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}h {m:02d}m" if h else (f"{m}m {s:02d}s" if m else f"{s}s")


def fmt_since(sec):
    """A duration short enough for a cup's status line: 45s, 12m, 3h or 2d."""
    sec = max(0, int(sec))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if sec >= size:
            return f"{sec // size}{unit}"
    return f"{sec}s"


def visible_len(s):
    return len(re.sub(r"\033\[[\d;]*m", "", s))


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


# ---- Drawing. Each sprite is drawn once from anti-aliased shapes and sent to
# the terminal as an image. Shapes are measured in units where a cell is 8 wide
# and 16 tall. Images get 2 pixels per unit, so they stay sharp on Retina.
CW, CH, PX = 8, 16, 2
INK, WHITE, PINK = (28, 26, 30), (255, 255, 255), (236, 150, 165)


def mix(a, b, t):
    t = min(1.0, max(0.0, t))
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


# A shape is (distance, box): distance(x, y) is negative inside the shape and
# box = (x0, y0, x1, y1) bounds it.
def circle(cx, cy, r):
    return (lambda x, y: math.hypot(x - cx, y - cy) - r), (cx - r, cy - r, cx + r, cy + r)


def ellipse(cx, cy, rx, ry):
    m = min(rx, ry)
    return (
        (lambda x, y: (math.hypot((x - cx) / rx, (y - cy) / ry) - 1) * m),
        (cx - rx, cy - ry, cx + rx, cy + ry),
    )


def capsule(ax, ay, bx, by, r):
    dx, dy = bx - ax, by - ay
    length2 = dx * dx + dy * dy or 1e-9

    def dist(x, y):
        t = max(0.0, min(1.0, ((x - ax) * dx + (y - ay) * dy) / length2))
        return math.hypot(x - ax - t * dx, y - ay - t * dy) - r

    return dist, (min(ax, bx) - r, min(ay, by) - r, max(ax, bx) + r, max(ay, by) + r)


def rbox(x0, y0, x1, y1, r):
    cx, cy, hx, hy = (x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2 - r, (y1 - y0) / 2 - r

    def dist(x, y):
        qx, qy = abs(x - cx) - hx, abs(y - cy) - hy
        return math.hypot(max(qx, 0), max(qy, 0)) + min(max(qx, qy), 0) - r

    return dist, (x0, y0, x1, y1)


def poly(*pts):
    """A convex polygon."""
    cx, cy = sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts)
    edges = []
    for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
        nx, ny = by - ay, ax - bx
        n = math.hypot(nx, ny)
        nx, ny = nx / n, ny / n
        if (cx - ax) * nx + (cy - ay) * ny > 0:
            nx, ny = -nx, -ny
        edges.append((ax, ay, nx, ny))
    xs, ys = [p[0] for p in pts], [p[1] for p in pts]
    return (
        (lambda x, y: max((x - ax) * nx + (y - ay) * ny for ax, ay, nx, ny in edges)),
        (min(xs), min(ys), max(xs), max(ys)),
    )


def union(*shapes):
    fns = [f for f, _ in shapes]
    boxes = [b for _, b in shapes]
    box = tuple(f(b[i] for b in boxes) for i, f in enumerate((min, min, max, max)))
    return (lambda x, y: min(f(x, y) for f in fns)), box


def clip(shape, mask):
    (f, box), (g, _) = shape, mask
    return (lambda x, y: max(f(x, y), g(x, y))), box


def grow(shape, d):
    f, (x0, y0, x1, y1) = shape
    return (lambda x, y: f(x, y) - d), (x0 - d, y0 - d, x1 + d, y1 + d)


def path(points, r):
    return union(*(capsule(*a, *b, r) for a, b in zip(points, points[1:])))


def curve(points, width):
    """A rounded cubic brush stroke, sampled at eight intervals."""
    a, b, c, d = points
    return path(
        [
            tuple(
                (1 - t) ** 3 * a[j]
                + 3 * (1 - t) ** 2 * t * b[j]
                + 3 * (1 - t) * t * t * c[j]
                + t**3 * d[j]
                for j in (0, 1)
            )
            for t in (i / 8 for i in range(9))
        ],
        width,
    )


class Img:
    """An RGBA sprite `cols` x `rows` cells big, with its shapes zoomed by `k`."""

    def __init__(self, cols, rows, k=1.0):
        self.cols, self.rows, self.k = cols, rows, k
        self.w, self.h = cols * CW * PX, rows * CH * PX
        self.buf = bytearray(self.w * self.h * 4)
        self.moved, self.fade = None, 1.0

    def move(self, angle, pivot, shift, scale=1.0):
        """Draw what follows turned by `angle` around `pivot`, scaled, then shifted."""
        ca, sa, (px, py), (dx, dy) = math.cos(angle), math.sin(angle), pivot, shift

        def back(x, y):  # from the image to where the shape was drawn
            x, y = (x - dx - px) / scale, (y - dy - py) / scale
            return ca * x + sa * y + px, -sa * x + ca * y + py

        def there(x, y):
            x, y = x - px, y - py
            return (ca * x - sa * y) * scale + px + dx, (sa * x + ca * y) * scale + py + dy

        self.moved = back, there, scale

    def fill(self, shape, color, alpha=1.0):
        """Paint a shape. `color` and `alpha` may also be functions of (x, y)."""
        if self.moved:
            shape, color, alpha = self._moved(shape, color, alpha)
        dist, (x0, y0, x1, y1) = shape
        s, buf, w, fade = PX * self.k, self.buf, self.w, self.fade
        for py in range(max(0, int(y0 * s) - 1), min(self.h, math.ceil(y1 * s) + 1)):
            y = (py + 0.5) / s
            for px in range(max(0, int(x0 * s) - 1), min(w, math.ceil(x1 * s) + 1)):
                x = (px + 0.5) / s
                a = min(1.0, 0.5 - dist(x, y) * s)
                if a <= 0:
                    continue
                a *= (alpha(x, y) if callable(alpha) else alpha) * fade
                if a <= 0.004:  # (also keeps a fully faded shape off empty pixels)
                    continue
                rgb = color(x, y) if callable(color) else color
                i = (py * w + px) * 4
                under = buf[i + 3] / 255 * (1 - a)
                total = a + under
                buf[i] = round((rgb[0] * a + buf[i] * under) / total)
                buf[i + 1] = round((rgb[1] * a + buf[i + 1] * under) / total)
                buf[i + 2] = round((rgb[2] * a + buf[i + 2] * under) / total)
                buf[i + 3] = round(total * 255)

    def _moved(self, shape, color, alpha):
        back, there, scale = self.moved
        (dist, (x0, y0, x1, y1)) = shape
        corners = [there(x, y) for x in (x0, x1) for y in (y0, y1)]
        xs, ys = [c[0] for c in corners], [c[1] for c in corners]

        def undo(f):
            return (lambda x, y: f(*back(x, y))) if callable(f) else f

        def moved_dist(x, y):  # distances shrink and grow with the shape
            return dist(*back(x, y)) * scale

        return (moved_dist, (min(xs), min(ys), max(xs), max(ys))), undo(color), undo(alpha)

    def mirror(self):
        row = self.w * 4
        for y in range(self.h):
            line = self.buf[y * row : (y + 1) * row]
            px = [line[i : i + 4] for i in range(0, row, 4)]
            self.buf[y * row : (y + 1) * row] = b"".join(reversed(px))
        return self


# ---- Drinks, seen from the side and a little above, like the cat: you see the
# cup, its handle and saucer, and look down onto the coffee. A drink is 6 cols x
# 3 rows, a 48-unit square. Brewing coffee swirls as it's stirred and steams;
# finished coffee gets latte art, a ready order a biscuit, cold coffee a skin.
SAUCER, SAUCER_RING = (238, 233, 224), (222, 215, 203)
COFFEE, FOAM = (58, 34, 22), (248, 238, 220)
BISCUIT = (214, 160, 96)
CUP_X, CUP_Y = 22, 24  # the middle of a drink's picture
SQUASH = 0.28  # how flat a coffee surface looks from this angle
STIR_FRAMES, POUR_FRAMES = 16, 12
LOOKS = ("brewing", "idle", "ready", "cold", "pour", "drain", "empty")


def ring(cx, cy, r, width):
    """A circle's outline, `width` thick."""
    reach = r + width
    return (
        lambda x, y: abs(math.hypot(x - cx, y - cy) - r) - width / 2,
        (cx - reach, cy - reach, cx + reach, cy + reach),
    )


def swirl(img, centre, frame, r, color=FOAM):
    """A swirl of foam on a surface seen at an angle, turning with `frame`."""
    cx, cy = centre
    turn = frame / STIR_FRAMES * 2 * math.pi
    for arm in (0, math.pi):
        pts = [
            (cx + math.cos(a) * d, cy + math.sin(a) * d * SQUASH)
            for a, d in ((turn + arm + t * 0.55, 1 + t * r / 9) for t in range(9))
        ]
        img.fill(path(pts, 0.75), color, 0.9)


def foam_heart(cx, cy, s):
    """A heart of foam on a surface seen at an angle."""
    return union(
        ellipse(cx - 1.25 * s, cy - 0.15 * s, 1.5 * s, 0.6 * s),
        ellipse(cx + 1.25 * s, cy - 0.15 * s, 1.5 * s, 0.6 * s),
        poly((cx - 2.7 * s, cy), (cx + 2.7 * s, cy), (cx, cy + 1.1 * s)),
    )


def steam(img, cx, span, frame, wisps=2):
    """Wisps rising from a hot drink, over the rows of units in `span`."""
    top, bottom = span
    phase = frame / STIR_FRAMES * 2 * math.pi
    tall = bottom - top
    for j in range(wisps):
        base = cx + (j - (wisps - 1) / 2) * 5.5

        def dist(x, y, base=base, off=j * 2.3):
            h = bottom - y
            centre = base + math.sin(h * 0.38 - phase + off) * (0.6 + h * 0.09)
            return abs(x - centre) - (0.9 + h * 0.03)

        def alpha(_x, y):
            h = (bottom - y) / tall
            return 0.5 * min(1.0, h * 4) * max(0.0, 1 - h) ** 0.9

        img.fill((dist, (base - 6, top, base + 6, bottom)), (246, 242, 238), alpha)


def cup_sprite(glaze, look, frame=0, k=1.0):
    """A cup in the agent's colour, as `look` (one of LOOKS) at animation `frame`."""
    img = Img(math.ceil(6 * k), math.ceil(3 * k), k)
    draw_cup(img, glaze, look, frame)
    return img


def draw_cup(img, glaze, look, frame):
    cx, rim = CUP_X, 23
    cream = (248, 235, 211)
    shade = (195, 170, 137)
    if glaze == SERVED_GLAZE:
        cream, shade = (205, 205, 206), (145, 145, 151)
    img.fill(ellipse(cx + 1, 44.5, 18, 2.5), INK, 0.28)
    img.fill(ellipse(cx, 43, 18, 3.5), mix(glaze, cream, 0.65))
    img.fill(ellipse(cx, 42, 17.5, 3), cream)
    img.fill(ellipse(cx, 41.5, 11, 1.7), shade, 0.35)
    handle = curve(((cx + 10, 26), (cx + 23, 20), (cx + 23, 39), (cx + 9, 35)), 2.6)
    img.fill(grow(handle, 0.5), shade)
    img.fill(handle, cream)
    bowl = clip(ellipse(cx, 28, 13, 12.5), rbox(0, rim, 48, 42, 0))

    def ceramic(x, y):
        color = glaze if 31 < y < 36 else cream
        return mix(color, shade, max(0, (x - cx + 1) / 28) * 0.42)

    img.fill(bowl, ceramic)
    img.fill(ellipse(cx, 40, 6.2, 1.5), shade)
    img.fill(ellipse(cx, 39.5, 6, 1), cream)
    img.fill(ellipse(cx, rim, 13, 4.4), shade)
    img.fill(ellipse(cx, rim - 0.5, 12.7, 4.2), cream)
    inside = ellipse(cx, rim - 0.1, 11.3, 3.3)
    img.fill(inside, (124, 87, 58))
    full = {
        "pour": (frame + 1) / POUR_FRAMES,
        "drain": (0.65, 0.25, 0)[min(frame, 2)],
        "empty": 0,
    }.get(look, 1)
    if full:
        coffee = COFFEE if look == "cold" else mix((96, 55, 31), (199, 145, 83), full)
        surface = clip(inside, ellipse(cx, rim + (1 - full) * 2, 11.3, 3.3 * full))
        img.fill(surface, coffee)
        if look == "cold":
            img.fill(ellipse(cx - 3, rim - 0.3, 3.5, 0.8), (141, 105, 74), 0.5)
        if full == 1 and look not in ("pour", "drain", "cold"):
            if look == "brewing":
                swirl(img, (cx, rim), frame, 8.5)
                steam(img, cx, (1, 17), frame)
            else:
                img.fill(foam_heart(cx, rim - 0.3, 1.7), FOAM)
    else:
        img.fill(inside, (217, 194, 162))
        img.fill(ellipse(cx, rim + 1.2, 6.5, 1.2), (159, 117, 80), 0.55)
    if look == "pour":
        strength = min(1, (1 - full) * 5)
        img.fill(capsule(cx - 2, 0, cx, rim, 0.9), (112, 69, 39), strength)
        img.fill(ellipse(cx, rim, 2.5, 0.7), FOAM, strength * 0.7)
    if look == "ready":
        img.fill(rbox(5, 40, 14, 44.5, 1.6), (185, 123, 65))
        img.fill(rbox(5, 39.5, 14, 43.5, 1.5), BISCUIT)
        for x in (7, 11.5):
            img.fill(circle(x, 41, 0.5), (126, 81, 46))


KNOCK_FRAMES, KNOCK_S = 16, 1.0
LATTE_FOAM = (250, 236, 210)
GLASS_TOP, GLASS_BOTTOM = 13.0, 41.5


def latte_sprite(glaze, look, frame=0, k=1.0):
    """Layered coffee in a rounded glass on a coloured coaster."""
    img = Img(math.ceil(6 * k), math.ceil(3 * k), k)
    draw_latte(img, glaze, look, frame)
    return img


def draw_latte(img, glaze, look, frame):
    cx, top, bottom = CUP_X, GLASS_TOP, GLASS_BOTTOM
    img.fill(ellipse(cx + 1, 45, 17, 2.6), INK, 0.28)
    coaster = poly((4, 40.5), (22, 36), (41, 41.5), (23, 47))
    img.fill(grow(coaster, 0.5), mix(glaze, INK, 0.3))
    img.fill(coaster, glaze)
    glass = union(
        poly((cx - 11, top), (cx + 11, top), (cx + 9.5, bottom - 2), (cx - 9.5, bottom - 2)),
        ellipse(cx, bottom - 2, 9.5, 3),
    )
    img.fill(grow(glass, 0.5), (221, 228, 222), 0.4)
    img.fill(glass, (190, 206, 207), 0.16)
    full = {
        "pour": (frame + 1) / POUR_FRAMES,
        "drain": (0.65, 0.25, 0)[min(frame, 2)],
        "empty": 0,
    }.get(look, 1)
    surface = bottom - (bottom - top) * full
    if full:
        filled = clip(glass, rbox(0, surface, 48, 48, 0))

        def coffee(_x, y):
            # The espresso diffuses into milk, with a darker layer at the foot.
            return mix((241, 214, 169), (131, 82, 51), ((y - top) / (bottom - top)) ** 1.7)

        img.fill(filled, coffee)
        img.fill(clip(filled, rbox(0, surface, 48, surface + 4, 0)), LATTE_FOAM)
        img.fill(clip(glass, ellipse(cx, surface, 10.4, 3.1)), LATTE_FOAM)
    # Reflections follow the sides; the coffee remains visible through the glass.
    img.fill(capsule(cx - 8, top + 6, cx - 7, bottom - 3, 0.65), WHITE, 0.7)
    img.fill(capsule(cx + 9, top + 5, cx + 8.3, bottom - 4, 0.35), WHITE, 0.4)
    img.fill(ellipse(cx, top, 11, 3.8), (224, 232, 225), 0.65)
    img.fill(ellipse(cx, top, 9.7, 2.9), LATTE_FOAM if full == 1 else (65, 69, 66))
    if look == "pour":
        strength = min(1, (1 - full) * 5)
        img.fill(capsule(cx - 1, 0, cx, top, 0.9), FOAM, strength)
        img.fill(clip(glass, capsule(cx, top, cx, surface, 0.9)), FOAM, strength * 0.6)
    if full == 1 and look not in ("pour", "drain"):
        if look == "busy":
            swirl(img, (cx, top), frame, 8, (174, 121, 72))
        else:
            for i in range(4):
                img.fill(ellipse(cx, top - 1.3 + i * 0.8, 4 - i * 0.8, 0.5), (190, 141, 88))
            img.fill(capsule(cx, top - 2, cx, top + 2, 0.4), FOAM)


def knock_sprite(glaze, frame, k=1.0, drink="cup"):
    """A drink the cat pushed: it tips over to the left and drops off the table.
    The picture is 4 cols wider than a drink, which starts at its right."""
    img = Img(math.ceil(10 * k), math.ceil(3 * k), k)
    t = frame / (KNOCK_FRAMES - 1)
    fall = max(0.0, t - 0.45) / 0.55
    tip = min(1.0, t / 0.45)
    img.move(-1.5 * tip, (CUP_X - 10, 44), (32 - 14 * tip, 26 * fall * fall))
    img.fade = 1 - fall
    (draw_latte if drink == "latte" else draw_cup)(img, glaze, "empty", 0)
    return img


# ---- The barista cat, drawn with rounded brush strokes and a teal neckerchief.
# It walks facing right (mirrored to go left), and naps curled up.
# Each coat: name, fur, markings, light fur, eyes, pattern.
COATS = [
    ("orange tabby", (218, 164, 108), (168, 112, 65), (255, 237, 205), (132, 190, 72), "tabby"),
    ("tuxedo", (54, 54, 62), (54, 54, 62), (240, 240, 236), (232, 200, 70), None),
    ("grey tabby", (160, 160, 170), (112, 112, 124), (224, 224, 230), (226, 172, 62), "tabby"),
    ("calico", (246, 242, 232), (64, 56, 52), (250, 248, 242), (132, 190, 72), "calico"),
    ("siamese", (240, 228, 206), (100, 76, 62), (248, 240, 226), (92, 160, 232), "points"),
    ("white", (246, 246, 248), (216, 216, 224), (255, 255, 255), (92, 160, 232), None),
]
CAT_NAMES = ["Mocha", "Miso", "Biscotti", "Pixel", "Bean", "Cortado", "Nibs", "Ristretto"]
CALICO_ORANGE = (232, 140, 60)


def cat_face(cx, cy, *, side=False, closed=False):
    """A broad face, small ears and an ink-dot expression."""
    rx, ry = (8.8, 8) if side else (12.2, 10)
    eyes = [(cx + 3.4, cy - 0.3)] if side else [(cx - 4.7, cy), (cx + 4.7, cy)]
    muzzle_x = cx + 6 if side else cx
    ears = [
        grow(poly((cx - rx + 1, cy - 3), (cx - rx + 1, cy - 12), (cx - 2, cy - 8)), 0.5),
        grow(poly((cx + 2, cy - 8), (cx + rx - 1, cy - 12), (cx + rx - 1, cy - 3)), 0.5),
    ]
    return {
        "head": ellipse(cx, cy, rx, ry),
        "ears": ears,
        "inner": [
            poly((cx - rx + 3, cy - 5), (cx - rx + 2.5, cy - 9.5), (cx - 5, cy - 7)),
            poly((cx + 5, cy - 7), (cx + rx - 2.5, cy - 9.5), (cx + rx - 3, cy - 5)),
        ],
        "light": [ellipse(muzzle_x, cy + 4, 4 if side else 6, 3.2)],
        "nose": ellipse(muzzle_x, cy + 2.8, 1.15, 0.8),
        "eyes": [] if closed else eyes,
        "eye": 0.85,
        "closed": [
            curve(((x - 1.5, y), (x - 0.5, y + 1.5), (x + 0.5, y + 1.5), (x + 1.5, y)), 0.5)
            for x, y in eyes
        ],
        "stripes": [capsule(cx + x, cy - 8, cx + x * 0.7, cy - 5, 0.7) for x in (-3, 0, 3)],
        "patches": [(ellipse(cx - 4, cy - 4, 5, 5), CALICO_ORANGE)],
        "whiskers": [
            capsule(muzzle_x + s * 3, cy + 4 + j, muzzle_x + s * 8, cy + 3 + 2 * j, 0.32)
            for s in (-1, 1)
            for j in (0, 1)
        ],
    }


def cat_sit(tail=0, closed=False, groom=0, yawn=False, slap=0):  # noqa: PLR0913
    pose = cat_face(28, 22, closed=closed or bool(groom) or yawn)
    sway = 3 * math.sin(tail * math.pi / 4)
    pose.update(
        tail=curve(((35, 42), (50 + sway, 45), (48 + sway, 28), (43, 31)), 2.5),
        body=ellipse(28, 35.5, 10.5, 9.4),
        paws=[ellipse(23, 44, 3.2, 1.8), ellipse(33, 44, 3.2, 1.8)],
        scarf=poly((20, 31), (36, 31), (30, 37)),
    )
    pose["light"].insert(0, ellipse(28, 38, 6.5, 5.3))
    pose["patches"].append((ellipse(21, 36, 5, 5), CALICO_ORANGE))
    if groom:
        pose["legs"] = [capsule(33, 40, 34, 28 - groom, 2.3)]
        pose["paws"][1] = ellipse(34, 28 - groom, 2.8, 2.4)
    if slap in (1, 2):
        px, py = (18, 29) if slap == 1 else (9, 35)
        pose["legs"] = [capsule(22, 36, px, py, 2.5)]
        pose["paws"][0] = ellipse(px, py, 3.2, 2.2)
    if yawn:
        pose["mouth"] = ellipse(28, 28, 2.2, 2.8)
    return pose


def cat_hiss():
    pose = cat_sit()
    pose["ears"] = [
        poly((16, 20), (11, 12), (23, 14)),
        poly((33, 14), (45, 12), (40, 20)),
    ]
    pose["inner"] = []
    pose["mouth"] = ellipse(28, 28, 2, 2.5)
    return pose


def cat_walk(step):
    phase = step * math.pi / 4
    swing = 4 * math.cos(phase)
    lift = 3 * max(0, math.sin(phase))
    other = 3 * max(0, -math.sin(phase))
    pose = cat_face(42, 25, side=True)
    pose.update(
        tail=curve(((15, 33), (1, 34), (3, 14), (10, 19 + math.sin(phase))), 2.5),
        body=capsule(17, 33, 33, 32, 8),
        far=[capsule(18, 35, 18 - swing, 44 - other, 2), capsule(33, 35, 33 + swing, 44 - lift, 2)],
        legs=[
            path(((17, 35), (15, 40), (16 + swing, 44 - lift)), 2.3),
            path(((32, 35), (34, 40), (34 - swing, 44 - other)), 2.3),
        ],
        paws=[ellipse(16 + swing, 44.5 - lift, 3, 1.5), ellipse(34 - swing, 44.5 - other, 3, 1.5)],
        scarf=poly((34, 29), (39, 31), (34, 37)),
    )
    pose["light"].insert(0, ellipse(25, 37.5, 10, 2.6))
    pose["stripes"] += [capsule(x, 25, x - 1, 29, 0.8) for x in (19, 24, 29)]
    pose["patches"].append((ellipse(21, 31, 6.5, 6), CALICO_ORANGE))
    return pose


def cat_crouch():
    pose = cat_sit()
    pose["body"] = ellipse(28, 38, 12, 7)
    # The same face lowers into the shoulders before the spring.
    face = cat_face(28, 27)
    for key in ("head", "ears", "inner", "nose", "eyes", "closed", "stripes", "whiskers"):
        pose[key] = face[key]
    pose["light"] = [ellipse(28, 40, 7, 4), *face["light"]]
    pose["patches"] = [*face["patches"], (ellipse(21, 38, 5, 4), CALICO_ORANGE)]
    pose["scarf"] = poly((21, 35), (35, 35), (29, 40))
    return pose


def cat_leap(up=True, stage=1):
    del up  # The whole sprite tilts in cat_sprite.
    reach = (3, 10, 7, 2)[stage]
    pose = cat_face(42, 23, side=True)
    pose.update(
        tail=curve(((15, 31), (8, 30), (3, 25), (4, 20)), 2.5),
        body=capsule(17, 31, 33, 29, 7.5),
        far=[capsule(18, 32, 13 - reach, 39, 2), capsule(33, 31, 36 + reach, 36, 2)],
        legs=[capsule(17, 33, 11 - reach, 36, 2.4), capsule(32, 32, 37 + reach, 32, 2.4)],
        paws=[ellipse(14 - reach, 36, 3, 1.7), ellipse(38 + reach, 32, 3, 1.7)],
        scarf=poly((34, 27), (39, 29), (31, 34)),
    )
    pose["light"].insert(0, ellipse(25, 35, 10, 2.4))
    pose["stripes"] += [capsule(x, 23, x - 1, 27, 0.8) for x in (19, 24, 29)]
    pose["patches"].append((ellipse(21, 29, 6, 5), CALICO_ORANGE))
    return pose


def cat_nap(breath):
    swell = 0.35 * (1 - math.cos(breath * math.pi / 4))
    pose = cat_face(35, 33, closed=True)
    pose.update(
        tail=curve(((13, 34), (8, 44), (28, 48), (34, 40)), 3.1),
        body=ellipse(25, 33, 16 + swell, 11 + swell),
        paws=[ellipse(31, 41, 3.1, 1.8), ellipse(39, 41, 3, 1.8)],
        front_tail=True,
    )
    pose["patches"].append((ellipse(17, 31, 7, 6), CALICO_ORANGE))
    return pose


CAT_POSES = {
    "sit": cat_sit,
    "groom": lambda paw: cat_sit(groom=paw),
    "slap": lambda stage: cat_sit(slap=stage),
    "yawn": lambda: cat_sit(yawn=True),
    "hiss": cat_hiss,
    "walk": cat_walk,
    "nap": cat_nap,
    "crouch": cat_crouch,
    "leap": cat_leap,
}


def cat_sprite(coat, pose_key, flip, k):
    _, fur, dark, light, eye, pattern = COATS[coat]
    p = CAT_POSES[pose_key[0]](*pose_key[1:])
    img = Img(math.ceil(7 * k), math.ceil(3 * k), k)
    if pose_key[0] == "leap":  # nose up to leap up the table, nose down to hop down
        stage = pose_key[2] if len(pose_key) > 2 else 1
        tilt = (0.2, 0.32, 0.15, 0.0)[stage]
        img.move(-tilt if pose_key[1] else tilt, (28, 26), (0, 0))
    dark_fur = sum(fur) < 300
    edge = (119, 119, 133) if dark_fur else mix(fur, INK, 0.38)
    outer = [p["tail"], p["body"], p["head"], *p["ears"], *p.get("legs", []), *p.get("far", [])]
    silhouette = union(*outer)
    img.fill(grow(union(p["body"], p["head"]), 3.5), INK, 0.22)  # its shadow on the table
    img.fill(grow(silhouette, 0.7), edge)
    for leg in p.get("far", []):
        img.fill(leg, mix(fur, INK, 0.3))
    for part in (p["tail"], p["body"], *p.get("legs", [])):
        img.fill(part, fur)
    img.fill(grow(p["head"], 0.7), edge, 0.6)
    img.fill(p["head"], fur)
    for ear in p["ears"]:
        img.fill(ear, fur)
    cat_markings(img, p, pattern, dark, silhouette)
    for part in (*p["light"], *p.get("paws", [])):
        img.fill(part, dark if pattern == "points" and part in p.get("paws", []) else light)
    cat_details(img, p, fur, edge)
    for part in p["inner"]:
        img.fill(part, PINK)
    img.fill(p["nose"], (133, 83, 72))
    for whisker in p.get("whiskers", []):
        img.fill(whisker, light if dark_fur else (105, 77, 62), 0.8)
    if "mouth" in p:
        img.fill(p["mouth"], (120, 40, 52))
    size = p.get("eye", 1.0)
    for x, y in p.get("eyes", []):
        img.fill(ellipse(x, y, 1.35 * size, 1.8 * size), eye if dark_fur else INK)
        img.fill(circle(x - 0.35, y - 0.6, 0.4), WHITE)
    if not p.get("eyes"):
        for lid in p.get("closed", []):
            img.fill(lid, (170, 170, 182) if dark_fur else INK)
    return img.mirror() if flip else img


def cat_details(img, pose, fur, edge):
    if pose.get("front_tail"):
        img.fill(grow(pose["tail"], 0.6), edge)
        img.fill(pose["tail"], fur)
    if "scarf" in pose:
        img.fill(pose["scarf"], (75, 133, 122))


def cat_markings(img, p, pattern, dark, silhouette):
    if pattern == "tabby":
        for stripe in p["stripes"]:
            img.fill(clip(stripe, silhouette), dark)
    elif pattern == "calico":
        for shape, color in p["patches"]:
            img.fill(clip(shape, silhouette), color or dark)
    elif pattern == "points":
        for part in (p["tail"], *p["ears"], *p.get("legs", [])):
            img.fill(part, dark, 0.85)
        img.fill(clip(grow(union(*p["light"][-1:]), 2.5), p["head"]), dark, 0.7)


HEART_FRAMES = 16


def heart(cx, cy, s):
    return union(
        circle(cx - s * 0.9, cy, s),
        circle(cx + s * 0.9, cy, s),
        poly((cx - s * 1.85, cy + s * 0.35), (cx + s * 1.85, cy + s * 0.35), (cx, cy + s * 2.4)),
    )


def hearts_sprite(frame):
    """Two little hearts floating up from a purring cat."""
    img = Img(4, 3)
    for j in (0, 1):
        p = (frame / HEART_FRAMES + j * 0.5) % 1
        x = 16 + (j * 2 - 1) * 4 + 2 * math.sin(p * 6 + j)
        img.fill(heart(x, 42 - p * 36, 1.6 + p), (240, 92, 124), math.sin(math.pi * p))
    return img


def ground_img(cols, k):
    """A one-row sprite whose shapes sit on the bottom row of the cat's strip of table."""
    img = Img(math.ceil(cols * k), 1, k)
    img.move(0, (0, 0), (0, CH / k - CH))
    return img


def mouse_sprite(step, flip, k):
    """A little grey mouse from above, scurrying right."""
    img, fur = ground_img(3, k), (150, 140, 136)
    wag = 1.2 if step else -1.2
    img.fill(path(((7, 9.5), (3.5, 9.5 + wag), (0.8, 9.5 - wag)), 0.5), PINK)
    for x, y in (
        ((10, 6.6), (10, 12.4), (16, 6.8), (16, 12.2))
        if step
        else ((12, 6.6), (12, 12.4), (14, 6.8), (14, 12.2))
    ):
        img.fill(ellipse(x, y, 1.2, 0.8), mix(fur, INK, 0.3))
    img.fill(ellipse(12, 9.5, 6, 3.6), fur)
    img.fill(poly((16, 6.8), (22.5, 9.5), (16, 12.2)), fur)
    for y in (6.6, 12.4):
        img.fill(circle(16.5, y, 1.9), fur)
        img.fill(circle(16.5, y, 1.1), PINK)
    img.fill(circle(22.4, 9.5, 0.75), PINK)
    for y in (8.4, 10.6):
        img.fill(circle(19.6, y, 0.55), INK)
    return img.mirror() if flip else img


def treat_sprite(bites, k):
    """A fish-shaped treat, eaten head first by the cat on its right."""
    img = ground_img(2, k)
    fish = union(ellipse(9, 12.6, 4.6, 2.4), poly((5, 12.6), (1.5, 10), (1.5, 15.2)))
    eaten = rbox(0, 0, 14.5 - bites * 3.5, 16, 0)
    img.fill(clip(grow(fish, 0.8), eaten), INK, 0.25)
    img.fill(clip(fish, eaten), (214, 160, 96))
    if bites == 0:
        img.fill(circle(11.8, 12, 0.5), INK)
    return img


def bun_sprite(kind, bites=0):
    """Fika: a kanelbulle, or a saffron lussekatt in December, on a little plate.
    The cat sits to its left, so the bites come out of that side."""
    img = Img(6, 3)
    cx, cy = CUP_X, CUP_Y
    img.fill(circle(cx + 1.4, cy + 2, 16), INK, 0.3)
    img.fill(circle(cx, cy, 15.5), SAUCER)
    img.fill(ring(cx, cy, 12, 0.7), SAUCER_RING)
    marks = [circle(cx - 11 + i * 5, cy + (2.5 if i % 2 else -2.5), 5.5) for i in range(bites)]

    def fill(shape, *paint):
        if marks:
            shape = clip(shape, (lambda x, y: max(-m[0](x, y) for m in marks), shape[1]))
        img.fill(shape, *paint)

    if kind == "lussekatt":
        # An S: a strand coiled one way at the top, and the other way at the bottom.
        coil = [
            (a * 0.75 * math.cos(a), a * 0.75 * math.sin(a)) for a in (i / 3 for i in range(19))
        ]
        strand = [(cx - 4 + x, cy - 4 + y) for x, y in coil] + [
            (cx + 4 - x, cy + 4 - y) for x, y in coil[::-1]
        ]
        fill(path(strand, 2.8), (196, 128, 36))
        fill(path(strand, 2.1), (240, 182, 62))
        for x, y in ((cx - 4, cy - 4), (cx + 4, cy + 4)):
            fill(circle(x, y, 1.3), (70, 30, 30))
        return img
    fill(circle(cx, cy, 10.5), (206, 140, 70))
    spiral = [
        (cx + a * 0.95 * math.cos(a), cy + a * 0.95 * math.sin(a))
        for a in (i / 3 for i in range(3, 31))
    ]
    fill(path(spiral, 0.9), (140, 82, 38))
    for x, y in ((-4, -5), (3, -6), (6, 2), (-2, 6), (-7, 1), (1, 0)):
        fill(rbox(cx + x - 0.7, cy + y - 0.4, cx + x + 0.7, cy + y + 0.4, 0.3), WHITE)
    return img


SPRITES = {
    "mouse": mouse_sprite,
    "treat": treat_sprite,
    "bun": bun_sprite,
    "hearts": hearts_sprite,
    "cup": cup_sprite,
    "latte": latte_sprite,
    "knock": knock_sprite,
    "cat": cat_sprite,
}


class Gallery:
    """Sends each sprite to the terminal once (kitty graphics protocol) and keeps
    the pictures on screen in sync with what render() asks for."""

    BASE_ID = 0xCAFE00

    def __init__(self, cell=None):
        self.images, self.uploads, self.sent, self.objects, self.shown = {}, {}, set(), {}, {}
        self.cell = cell  # a cell's (width, height) in pixels, to place pictures between cells

    def image(self, key, out):
        if key not in self.images:
            img = SPRITES[key[0]](*key[1:])
            iid = self.BASE_ID + len(self.images)
            data = base64.standard_b64encode(zlib.compress(bytes(img.buf))).decode()
            chunks = [data[i : i + 4096] for i in range(0, len(data), 4096)] or [""]
            self.uploads[key] = "".join(
                f"\033_G{f'a=t,q=2,f=32,o=z,i={iid},s={img.w},v={img.h},' if n == 0 else ''}"
                f"m={int(n < len(chunks) - 1)};{chunk}\033\\"
                for n, chunk in enumerate(chunks)
            )
            self.images[key] = (iid, img.cols, img.rows)
        if key not in self.sent:
            out.append(self.uploads[key])
            self.sent.add(key)
        return self.images[key]

    def reset(self):
        """Start over after a resize: terminals may drop pictures, image data included."""
        self.sent, self.shown = set(), {}
        return "\033_Ga=d,d=A,q=2\033\\"

    def sync(self, want):
        """want: {object: (sprite key, col, row, z)}. Returns the escape codes.
        Positions may fall between cells."""
        out, shown = [], {}
        for obj, (key, col, row, z) in want.items():
            pid = self.objects.setdefault(obj, len(self.objects) + 1)
            iid, cols, rows = self.image(key, out)
            c, r, x, y = self.cell_at(col, row)
            spot = (iid, c, r, x, y, z)
            old = self.shown.get(pid)
            if old != spot:
                nudge = f"X={x},Y={y}," if x or y else ""
                out.append(
                    f"\033[{r + 1};{c + 1}H"
                    f"\033_Ga=p,i={iid},p={pid},c={cols},r={rows},{nudge}z={z},C=1,q=2\033\\"
                )
                if old and old[0] != iid:
                    out.append(f"\033_Ga=d,d=i,i={old[0]},p={pid},q=2\033\\")
            shown[pid] = spot
        for pid in self.shown.keys() - shown.keys():
            out.append(f"\033_Ga=d,d=i,i={self.shown[pid][0]},p={pid},q=2\033\\")
        self.shown = shown
        return "".join(out)

    def cell_at(self, col, row):
        """The cell a position starts in, and how many pixels into it. Without
        the terminal's cell size, the nearest cell."""
        col, row = max(0.0, col), max(0.0, row)
        if not self.cell:
            return round(col), round(row), 0, 0
        (w, h), c, r = self.cell, math.floor(col), math.floor(row)
        return c, r, min(w - 1, round((col - c) * w)), min(h - 1, round((row - r) * h))


class Cat:
    """The barista cat. It lives on the strip of table below the cards: walks,
    grooms, yawns, and naps when the bar is quiet. It goes up to the cards to
    sniff new orders, check on ready ones and knock finished cups off the
    table. `x` is the column of its middle, `y` how many rows above the strip
    it is."""

    MIN_X = 5  # how close its middle gets to the frame's sides

    def __init__(self, now, home, key="cat"):
        self.key = key  # its pictures' names, so a visiting cat can share the bar
        self.coat = random.randrange(len(COATS))
        self.name = random.choice(CAT_NAMES)
        self.x = self.goal = float(home)
        self.y = self.goal_y = 0.0
        self.leap = None  # where from and to, while it leaps between table and cards
        self.dir, self.last, self.speed = 1, now, 7.0  # cols/s
        self.distance = 0.0  # the walking cycle follows the paws' distance over the table
        self.plan, self.mode, self.until = [], "nap", now + 4
        self.pets, self.petted_at, self.target = 0, 0.0, None
        self.fed, self.chasing, self.sleepy = [], False, False

    @property
    def title(self):
        return f"{self.name} the {COATS[self.coat][0]} cat"

    def go(self, x, y=0):
        self.goal, self.goal_y, self.mode, self.plan, self.chasing = (
            float(x),
            float(y),
            "walk",
            [],
            False,
        )

    def moving(self):
        return self.mode in ("walk", *BUSY_MODES)

    def free(self):
        """Not busy with a cup, a mouse, a treat or a pet."""
        return self.target is None and not self.chasing and self.mode not in BUSY_MODES

    def do(self, mode, now, dur, *plan):
        """Switch to `mode` for `dur` seconds, then follow the `plan`."""
        self.mode, self.until, self.plan = mode, now + dur, list(plan)

    def slap(self, now):
        # Among the cards, it doesn't linger: the others close up the gap.
        self.do("slap", now, 1.6, ("sit", 0.6 if self.y else 2.5))

    def hiss(self, now):
        self.do("hiss", now, 1.5, ("sit", 2))

    def pet(self, now):
        """Stop whatever it's doing and purr for a bit."""
        self.pets += 1
        self.target, self.chasing = None, False  # it got distracted on its way to a cup
        self.petted_at = now
        self.do("purr", now, 3, ("sit", 1.5))

    def feed(self, now):
        """Eat a treat, unless it's had plenty lately. Returns whether it ate."""
        if sum(now - t < 600 for t in self.fed) >= TREATS_PER_10_MIN:
            return False
        self.fed.append(now)
        self.target, self.chasing = None, False
        self.do("eat", now, 2.4, ("sit", 1.5))
        return True

    def pampered(self, now):
        """Petted or fed in the last 10 minutes: in a good mood."""
        return bool(self.pets or self.fed) and now - max([self.petted_at, *self.fed]) < 600

    def _arrive(self, now, calm, free_x, home, *, waiting=False):
        u = random.uniform
        if self.y and self.target is None:  # nothing to do up among the cards: back down
            self.go(self.x)
            return
        if home is not None:
            self.plan = [("nap", u(20, 40)), ("sit", 1.5), ("groom", u(2, 4))]
        elif self.target is not None:
            self.plan = [("sit", u(1.5, 2.5))]  # a sniff at the cup
        elif waiting:  # an order is ready: it sits up and looks at you
            self.plan = [("sit", u(4, 8)), ("groom", u(1, 2))]
        elif calm and self.x >= free_x and random.random() < (0.8 if self.sleepy else 0.5):
            self.plan = [("nap", u(8, 16)), ("yawn", 1.2)]
        else:
            self.plan = random.choice(
                [
                    [("sit", u(2, 5))],
                    [("groom", u(2, 3)), ("sit", u(1, 3))],
                    [("sit", u(2, 4)), ("yawn", 1.2)],
                ]
            )
        self._next(now)

    def _next(self, now):
        self.mode, dur = self.plan.pop(0)
        self.until = now + dur

    def step(self, now, lane_w, calm, free_x, *, home=None, waiting=False):  # noqa: PLR0913
        dt = min(0.5, max(0.0, now - self.last))  # the clock may jump, even backwards
        self.last = now
        max_x = float(max(self.MIN_X, lane_w - self.MIN_X))
        if home is not None and (abs(self.goal - home) > 0.5 or self.goal_y):
            self.go(home)
        if self.mode == "walk":
            if self._walk(dt, max_x, now):
                self._arrive(now, calm, free_x, home, waiting=waiting)
        elif self.mode == "crouch" and now >= self.until:
            self.mode, self.leap["start"] = "leap", now
        elif self.mode == "leap":
            self._fly(now)
        elif now >= self.until:
            if self.plan:
                self._next(now)
            elif home is not None or (waiting and not self.y):
                self._arrive(now, calm, free_x, home, waiting=waiting)
            elif free_x <= max_x and random.random() < 0.6:
                self.go(random.uniform(free_x, max_x))
            else:
                self.go(random.uniform(self.MIN_X, max_x))
        self.x = min(max(self.x, self.MIN_X), max_x)

    def _walk(self, dt, max_x, now):
        """A step towards its goal along the table. To get up to a card, it
        walks until it's below it, then crouches to leap. Returns whether it
        got there."""
        goal = min(max(self.goal, self.MIN_X), max_x)
        speed = CHASE_SPEED if self.chasing else self.speed
        if self.target is not None:  # off to see to a cup: it trots
            speed = max(speed, ERRAND_SPEED)
        if self.goal_y != self.y:
            if not self.y and abs(goal - self.x) > speed * dt:
                self._stride(goal, speed * dt)
                return False
            # Up: from right below the card. Down: straight down, then walk.
            to_x = goal if self.goal_y else self.x
            self.leap = {
                "from": (self.x, self.y),
                "to": (to_x, self.goal_y),
                "time": 0.35 + 0.025 * abs(self.goal_y - self.y),
                "up": self.goal_y < self.y,
            }
            self.mode, self.until = "crouch", now + CROUCH_S
            return False
        if abs(goal - self.x) <= speed * dt:
            self._stride(goal, abs(goal - self.x))
            return True
        self._stride(goal, speed * dt)
        return False

    def _stride(self, goal, step):
        if step == 0:
            return
        self.dir = 1 if goal > self.x else -1
        self.x += self.dir * step
        self.distance += step

    def _fly(self, now):
        """Along its leap, easing off and landing softly, then on its way."""
        leap = self.leap
        t = min(1.0, (now - leap["start"]) / leap["time"])
        (x0, y0), (x1, y1) = leap["from"], leap["to"]
        # Lift off quickly, arc above the landing spot, then fall onto the paws.
        self.x = x0 + (x1 - x0) * t
        self.y = y0 + (y1 - y0) * t - 1.2 * 4 * t * (1 - t)
        if t >= 1:
            self.mode, self.leap = "walk", None

    def pose(self, now):
        """The sprite pose for this moment, and whether to mirror it."""
        mirrored = self.dir < 0
        flight = self.leap
        stage = (
            min(3, max(0, int((now - flight["start"]) / flight["time"] * 4)))
            if flight and self.mode == "leap"
            else 0
        )
        chew = (("yawn",) if int(now * 4) % 2 else ("sit", 0, True), False)
        poses = {
            "walk": (("walk", int(self.distance / 0.8) % 8), mirrored),
            "crouch": (("crouch",), False),
            "leap": (("leap", bool(flight and flight["up"]), stage), mirrored),
            "nap": (("nap", int(now * 2) % 8), mirrored),
            "groom": (("groom", 1 + int(now * 3) % 2), False),
            "yawn": (("yawn",), False),
            "purr": (("sit", int(now * 4) % 8, True), False),
            "eat": chew,
            "nibble": chew,
            "hiss": (("hiss",), False),
            "slap": (
                ("slap", 1 if self.until - now > 1.3 else (2 if self.until - now > 1 else 3)),
                False,
            ),
        }
        return poses.get(self.mode, (("sit", int(now * 1.5) % 8, now % 5 < 0.25), False))

    def place(self, frame, art, top, k, now):
        """Put the cat's picture in `frame`, and its zZ in the strip's text `art` rows."""
        pose, flip = self.pose(now)
        cols, rows, cat_rows = math.ceil(7 * k), len(art), math.ceil(3 * k)
        left, row = self.x - cols // 2, top + rows - cat_rows + self.y
        frame.pics[self.key] = (("cat", self.coat, pose, flip, k), left, row, 3)
        if self.mode == "purr":
            beat = int((now - self.petted_at) / 0.1) % HEART_FRAMES
            frame.pics[(self.key, "hearts")] = (("hearts", beat), left + 2, max(0, row - 2), 4)
        if self.mode == "eat":
            bites = min(3, int((now - self.fed[-1]) / 0.6))
            frame.pics[(self.key, "treat")] = (("treat", bites, k), left, row + cat_rows - 1, 3)
        if pose[0] == "nap" and not self.y:
            for i, ch in enumerate("zZ"):
                r = rows - cat_rows - (int(now * 1.5) + i) % 2
                col = round(left) + (cols - 2 if not flip else 1) + i
                if 0 <= r < rows and 0 <= col < len(art[r]):
                    art[r][col] = f"{DIM}{ch}{RESET}"


# ---- The table. Each session is a card: its cup, and three lines beside it
# (name and project, status, a note). The cat lives on a strip of table below.
# card size: (card width, rows per card with the gap below, cup zoom, text lines)
# card size: (narrowest card, rows per card with the gap below, cup zoom, text lines)
CARDS = {"full": (30, 4, 1.0, 3), "compact": (22, 3, 2 / 3, 2), "text": (25, 4, None, 3)}
TOP_ROWS, LANE_ROWS = 3, 3  # the top edge, news and a gap; the cat's strip of table
HOME_X = 13
COLD, EDGE = c256(67), c256(240)


def pick_cards(count, width, rows, gfx):
    """The roomiest card size whose cards all fit in `width` columns and `rows`
    rows, how many go in a row, and how wide each is: as many as fit, spread
    evenly across the width."""
    for size in ("full", "compact") if gfx else ("text",):
        narrowest, card_h, *_ = CARDS[size]
        per_row = max(1, width // narrowest)
        if -(-count // per_row) * card_h <= rows:
            break
    return size, per_row, max(width // per_row, 1)


def trim(text, width):
    """Plain text cut to fit `width` columns, with an ellipsis if it was cut."""
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def fit(line, width):
    """A coloured line cut to fit `width` columns, keeping its colours."""
    if visible_len(line) <= width:
        return line
    out, seen = "", 0
    for part in re.split(r"(\033\[[\d;]*m)", line):
        if part.startswith("\033["):
            out += part
            continue
        kept = part[: max(0, width - 1 - seen)]
        out, seen = out + kept, seen + len(kept)
    return out + "…" + RESET


def card_order(state, now):
    """Ready orders first, then the other sessions in the order they arrived,
    then the open apps. Finished cups keep their place until the cat clears them."""
    cards = {p: (is_app(s), s[2]) for p, s in state["live"].items()}
    cards.update(
        (p, (is_app(cup), cup[3])) for p, cup in state["leaving"].items() if not gone(state, p, now)
    )

    def key(pid):
        ready = pid in state["live"] and session_state(state, pid, now)[0] == "ready"
        app, started = cards[pid]
        return app, not ready, started

    return sorted(cards, key=key)


def poured(state, pid, now):
    """How far into pouring a new cup is, or None once it's full. Sessions and
    apps already there at startup are served full."""
    seen = state["first_seen"].get(pid, 0)
    if state["live"][pid][0] == COPILOT_SESSION_KIND or seen <= state["start"] + 1:
        return None
    return (now - seen) / POUR_S if now - seen < POUR_S else None


def cup_look(state, pid, now, k):
    """The sprite key for a card's cup, or an app's latte, at this moment."""
    if pid in state["leaving"]:
        cup = state["leaving"][pid]
        drink, ended = ("latte" if is_app(cup) else "cup"), cup[2]
        knocked = state["knocked"].get(pid, now + 1)
        if knocked <= now:
            frame = min(KNOCK_FRAMES - 1, int((now - knocked) / KNOCK_S * KNOCK_FRAMES))
            return ("knock", SERVED_GLAZE, frame, k, drink)
        return (drink, SERVED_GLAZE, "drain", min(2, int((now - ended) / DRAIN_S * 3)), k)
    session = state["live"][pid]
    kind, _, _, cpu, _ = session
    glaze = DRINKS["copilot" if kind == COPILOT_SESSION_KIND else kind][2]
    drink = "latte" if is_app(session) else "cup"
    pour = poured(state, pid, now)
    if pour is not None:
        return (drink, glaze, "pour", int(pour * POUR_FRAMES), k)
    stir = int(now / (0.075 if cpu >= BUSY_CPU else 0.15)) % STIR_FRAMES  # faster when busier
    if drink == "latte":
        return (
            ("latte", glaze, "busy", stir, k)
            if cpu >= WORKING_CPU
            else ("latte", glaze, "open", 0, k)
        )
    word = session_state(state, pid, now)[0]
    return ("cup", glaze, word, stir if word == "brewing" else 0, k)


def card_lines(state, pid, now, width):
    """A card's three lines: name and project, status, and a note."""
    leaving = pid in state["leaving"]
    cup = state["leaving"][pid] if leaving else state["live"][pid]
    title, app = card_title(state, pid, cup, width), is_app(cup)
    if leaving:
        ended, started = cup[2], cup[3]
        done = "closed" if app else "served"
        return [title, f"{GOLD}✔ {done}{RESET} {DIM}{fmt_since(ended - started)}{RESET}", ""]
    if poured(state, pid, now) is not None:
        return [title, f"{GOLD}pouring…{RESET}", f"{DIM}{'opened' if app else 'new order'}{RESET}"]
    if app:
        busy = "busy" if cup[3] >= WORKING_CPU else "open"
        return [title, f"{DIM}{busy} {cup[3]:.0f}% · {fmt_mem(cup[4])}{RESET}", ""]
    word, since = session_state(state, pid, now)
    took = fmt_since(now - since)
    status = {
        "brewing": f"brewing {DIM}{took}{RESET}",
        "ready": f"{GOLD}{BOLD}ready{RESET} {DIM}{took}{RESET}",
        "idle": f"{DIM}idle {took}{RESET}",
        "cold": f"{COLD}cold{RESET} {DIM}{took}{RESET}",
    }[word]
    return [title, status, card_note(state, pid, cup, word, since)]


def card_title(state, pid, cup, width):
    """A card's first line: the agent or app, then its project, title or "app"."""
    kind, source = cup[:2]
    name, color, _ = DRINKS["copilot" if kind == COPILOT_SESSION_KIND else kind]
    if kind == COPILOT_SESSION_KIND:
        name, where = "Agent", source
    elif str(pid).startswith("t3:"):
        where = source  # a T3 Code session's title
    elif is_app(cup):
        where = "app"
    else:
        where = state.get("projects", {}).get(pid) or source.replace("ttys", "s")
    name = trim(name, width)
    title = f"{color}{BOLD}{name}{RESET}"
    if width - len(name) > 2:
        title += f" {DIM}{trim(where, width - len(name) - 1)}{RESET}"
    return title


def card_note(state, pid, cup, word, since):
    """A card's last line: what its app says it's doing, or what the bar can tell."""
    told = state.get("told", {}).get(pid)
    if cup[0] == COPILOT_SESSION_KIND:
        return f"{DIM}Copilot app{RESET}"
    if told:
        return f"{GOLD if word == 'ready' else DIM}{told[2]}{RESET}"
    if word == "ready":
        return f"{GOLD}waiting for you{RESET}"
    if word == "brewing":
        return f"{DIM}{cup[3]:.0f}% cpu{RESET}"
    return f"{DIM}quiet since {time.strftime('%H:%M', time.localtime(since))}{RESET}"


def runs(cells):
    """One line from (column, text) pieces."""
    out, at = "", 0
    for col, text in sorted(cells, key=lambda cell: cell[0]):
        out += " " * max(0, col - at) + text
        at = max(at, col) + visible_len(text)
    return out


class Frame:
    """One screen being built: text lines, and the pictures to show on them."""

    def __init__(self, width, gfx):
        self.width, self.gfx, self.out, self.pics = width, gfx, [], {}

    def art(self, rows):
        return [[" "] * self.width for _ in range(rows)]

    def add(self, art):
        self.out += ["".join(row).rstrip() for row in art]


def cat_visit(state, now):
    """When the cat reaches a finished cup, it swats it off the table. At a
    ready order that went cold, it helps itself to the biscuit."""
    cat = state["cat"]
    if cat.target is None or cat.mode in ("walk", "crouch", "leap"):  # not there yet
        return
    pid = cat.target
    if pid in state["leaving"] and pid not in state["knocked"]:
        cat.slap(now)
        state["knocked"][pid] = now + 0.3  # the paw lands a moment after the swing starts
        state["broken"] += 1
        cup = state["leaving"][pid]
        drink = "latte" if is_app(cup) else "cup"
        state["toast"] = (
            f"{cat.name} knocked {DRINKS[cup[0]][0]}'s {drink} off the table.",
            now + 4,
        )
    elif pid not in state["knocked"]:
        cat.target = None
        if pid in state.get("biscuits", ()):
            state["biscuits"].discard(pid)
            cat.do("nibble", now, 1.6, ("sit", 0.8))
            who = DRINKS[state["live"][pid][0]][0] if pid in state["live"] else "a"
            state["toast"] = (
                f"{cat.name} ate the biscuit off {who}'s saucer. It went cold.",
                now + 4,
            )


def bar_life(state, now, frame, art, *, top, k, free_x, home=None):  # noqa: PLR0913
    """What goes on around the barista: mice, visiting cats and fika buns.
    With a `home`, the bar is empty and the barista sleeps through mice."""
    cat, lane = state["cat"], frame.width
    lane_ends = Cat.MIN_X, max(Cat.MIN_X, lane - Cat.MIN_X)
    due = state.setdefault("due", set())
    on_table = cat.free() and not cat.y  # not off checking on a card
    if "mouse" in due and "guest" not in state and on_table:
        due.discard("mouse")
        side = 1 if cat.x < lane / 2 else -1
        x, speed = cat.x + side * random.uniform(6, 10), random.uniform(10, 20)
        state["mouse"] = {"x": x, "dir": side, "speed": speed, "last": now}
        cat.chasing = home is None and cat.mode != "nap"  # an empty bar's cat stays home
        quip = "gives chase" if cat.chasing else "just watches"
        quip = "sleeps right through it" if cat.mode == "nap" else quip
        state["toast"] = (f"A mouse! {cat.name} {quip}.", now + 3)
    if "mouse" in state:
        run_mouse(state, now, frame, (top + len(art) - 1, k), lane_ends)
    if "guest" in due and "mouse" not in state and on_table and lane >= 40:
        due.discard("guest")
        guest = Cat(now, lane_ends[0] if cat.x > lane / 2 else lane_ends[1], key="guest")
        guest.coat = random.choice([c for c in range(len(COATS)) if c != cat.coat])
        guest.name = random.choice([n for n in CAT_NAMES if n != cat.name])
        guest.mode, guest.speed = "walk", 6.0
        state["guest"] = {"cat": guest, "phase": "enter"}
        state["toast"] = (f"{guest.title} wanders in.", now + 4)
    if "guest" in state:
        run_guest(state, now, lane_ends)
        if "guest" in state:
            state["guest"]["cat"].place(frame, art, top, k, now)
    bites = state.get("bun_bites", 0)
    if daypart(now) == "fika" and free_x <= lane - 8 and bites < BUN_BITES:
        bun = fika_bun(now)
        if home is None:
            nibble(state, now, bun, lane - 12)  # just left of the plate
        frame.pics["bun"] = (("bun", bun, bites), lane - 8, top, 2)


def nibble(state, now, bun, spot):
    """Now and then at fika, the cat walks over to the bun at the end of the
    table and takes a bite."""
    cat, due = state["cat"], state["due"]
    if "nibble" in due and "mouse" not in state and "guest" not in state and cat.free():
        due.discard("nibble")
        cat.go(spot)
        state["snack"] = True
    elif state.get("snack") and cat.mode != "walk":
        del state["snack"]
        if abs(cat.x - spot) < 1 and cat.free():  # it got there without being distracted
            cat.do("nibble", now, 2.4, ("sit", 1.5))
            state["bun_bites"] = bites = state.get("bun_bites", 0) + 1
            done = f"{cat.name} finished the {bun}." if bites >= BUN_BITES else ""
            state["toast"] = (done or f"{cat.name} takes a bite of the {bun}.", now + 3)


def run_mouse(state, now, frame, spot, lane_ends):
    """The mouse dashes for the edge of the table. The cat runs at CHASE_SPEED,
    so it catches slower mice; faster ones get away."""
    (row, k), cat, mouse = spot, state["cat"], state["mouse"]
    mouse["x"] += mouse["dir"] * mouse["speed"] * min(0.5, now - mouse["last"])
    mouse["last"] = now
    if cat.chasing and abs(cat.x - mouse["x"]) < 2.5:
        del state["mouse"]
        state["mice"] = state.get("mice", 0) + 1
        cat.chasing = False
        cat.do("sit", now, 2, ("groom", 2.5))
        state["toast"] = (f"{cat.name} caught the mouse, then let it go.", now + 4)
    elif not lane_ends[0] <= mouse["x"] <= lane_ends[1]:
        del state["mouse"]
        if cat.chasing:
            cat.chasing = False
            cat.do("sit", now, 1.5, ("yawn", 1.2))
            state["toast"] = (f"The mouse got away. {cat.name} pretends not to care.", now + 4)
    else:
        if cat.chasing:
            cat.goal, cat.goal_y, cat.mode, cat.plan = mouse["x"], 0.0, "walk", []
        left = mouse["x"] - math.ceil(3 * k) / 2
        frame.pics["mouse"] = (("mouse", int(now * 10) % 2, mouse["dir"] < 0, k), left, row, 1)


def run_guest(state, now, lane_ends):
    """A stray walks up to the barista. A cat in a good mood shares the table
    for a while; a grumpy one hisses it out."""
    cat, visit = state["cat"], state["guest"]
    guest = visit["cat"]
    dt, guest.last = min(0.5, now - guest.last), now
    if visit["phase"] == "enter":
        guest.dir = 1 if cat.x > guest.x else -1
        if abs(cat.x - guest.x) - 9 > guest.speed * dt:
            guest.x += guest.dir * guest.speed * dt
            return
        state["visitors"] = state.get("visitors", 0) + 1
        if random.random() < (0.8 if cat.pampered(now) else 0.4):
            visit.update(phase="stay", leave_at=now + random.uniform(20, 40))
            guest.do("purr", now, 3)
            if cat.free():
                cat.do("purr", now, 3, ("sit", 6))  # purring, though not petted
            state["toast"] = (f"{guest.name} and {cat.name} share the table. ♥", now + 4)
        else:
            visit["phase"], guest.mode, guest.speed, guest.dir = "leave", "walk", 18.0, -guest.dir
            if cat.free():
                cat.hiss(now)
                state["toast"] = (f"{cat.name} hisses. {guest.name} bolts!", now + 4)
            else:
                state["toast"] = (f"{guest.name} thinks better of it.", now + 4)
    elif visit["phase"] == "stay":
        if guest.mode == "purr" and now >= guest.until:
            guest.mode = "sit"
        if now >= visit["leave_at"]:
            visit["phase"], guest.mode = "leave", "walk"
            guest.dir = -1 if guest.x < cat.x else 1
            state["toast"] = (f"{guest.name} heads home.", now + 3)
    else:
        guest.x += guest.dir * guest.speed * dt
        if not lane_ends[0] <= guest.x <= lane_ends[1]:
            del state["guest"]


def render_cards(state, now, frame, room_rows):
    """The grid of cards. Returns where each visible card is, as {pid: (col,
    row, text col)}."""
    pids = card_order(state, now)
    if not pids:
        render_empty(state, now, frame)
        state["hidden"] = set()
        return {}
    size, per_row, card_w = pick_cards(len(pids), frame.width - 4, room_rows, frame.gfx)
    _, card_h, k, n_lines = CARDS[size]
    room = max(1, room_rows // card_h) * per_row
    visible = pids[:room]
    state["hidden"] = set(pids[room:])
    text_at = 0 if k is None else math.ceil(6 * k) + (2 if k == 1 else 1)
    top = len(frame.out)
    rows = [[] for _ in range(-(-len(visible) // per_row) * card_h)]
    spots = {}
    for i, pid in enumerate(visible):
        x, y = 2 + (i % per_row) * card_w, (i // per_row) * card_h
        spots[pid] = (x, top + y, x + text_at)
        if frame.gfx:
            look = cup_look(state, pid, now, k)
            left = x - round(4 * k) if look[0] == "knock" else x
            frame.pics[("cup", pid)] = (look, left, top + y, 2)
        lines = card_lines(state, pid, now, card_w - text_at - 1)
        for j, line in enumerate(lines[:n_lines]):
            rows[y + j].append((x + text_at, fit(line, card_w - text_at - 1)))
    frame.out += [runs(cells).rstrip() for cells in rows]
    return spots


def render_empty(state, now, frame):
    """No orders: a clean cup, waiting."""
    top = len(frame.out)
    if frame.gfx:
        frame.pics["idle"] = (("cup", SERVED_GLAZE, "empty", 0, 1.0), 2, top, 2)
    quip = random.Random(int(now // 10)).choice(IDLE_QUIPS)
    at = 10 if frame.gfx else 2
    room = frame.width - at - 2
    frame.out += [
        " " * at + fit(f"{BOLD}No orders yet{RESET}", room),
        " " * at + fit(f"{DIM}{quip}{RESET}", room),
        "",
        "",
    ]


def footer(state, frame):
    """A line below the cards, if some didn't fit."""
    more = len(state.get("hidden", ()))
    if more:
        frame.out.append(f"  {DIM}+{more} more order{'s' * (more > 1)}{RESET}")


def aim_cat(state, now, spots, lane_top):
    """Send the cat up to a finished cup to knock it off, or to a card it wants
    to check on."""
    cat = state["cat"]
    # When the cards reflow, the strip moves. A cat on it moves along; one up
    # among the cards stays where it is on screen, though never above them.
    moved = lane_top - state.get("lane_top", lane_top)
    if cat.leap:  # mid-leap: shift the ends of it that are up among the cards
        for end in ("from", "to"):
            x, y = cat.leap[end]
            cat.leap[end] = (x, y - moved if y else y)
    elif cat.y:
        cat.y -= moved
        cat.y = min(0.0, max(cat.y, float(TOP_ROWS - lane_top)))
    state["lane_top"] = lane_top
    visit = state.pop("visit", None)
    if cat.target not in spots:
        cat.target = None
    if cat.mode in BUSY_MODES:
        return
    pending = [p for p in spots if p in state["leaving"] and p not in state["knocked"]]
    target = cat.target if cat.target in pending else next(iter(pending), visit)
    if target in spots:
        _, row, text_at = spots[target]
        goal = (text_at + 3, row - lane_top)  # beside the cup, over the card's words
        if cat.target != target or (cat.goal, cat.goal_y) != goal:
            cat.go(*goal)
        cat.target = target


def render_lane(state, now, frame, home=None):
    """The strip of table below the cards, where the cat lives."""
    cat = state["cat"]
    top, art = len(frame.out), frame.art(LANE_ROWS)
    words = {session_state(state, p, now)[0] for p in brewable(state)}
    bar_life(state, now, frame, art, top=top, k=1.0, free_x=Cat.MIN_X, home=home)
    calm, waiting = "brewing" not in words, "ready" in words
    cat.step(now, frame.width, calm, Cat.MIN_X, home=home, waiting=waiting)
    cat_visit(state, now)
    cat.place(frame, art, top, 1.0, now)
    frame.add(art)


def gone(state, pid, now):
    """Whether a finished cup has left the table. With graphics, the cat swats
    every cup it can reach; the rest leave on their own."""
    if pid in state["knocked"]:
        return now > state["knocked"][pid] + KNOCK_S
    waits_for_cat = state["gfx"] and pid not in state.get("hidden", ())
    return not waits_for_cat and now > state["leaving"][pid][2] + SERVED_S


def summary(state, now):
    """The tally in colour, for the frame's top edge."""
    words = {
        "ready": f"{GOLD}{BOLD}{{}} ready{RESET}",
        "brewing": "{} brewing",
        "idle": f"{DIM}{{}} idle{RESET}",
        "served": f"{GOLD}{{}} served{RESET}",
    }
    counts = tally_counts(state, now)
    return f"{DIM} · {RESET}".join(words[w].format(n) for w, n in counts.items() if n)


def edge(left, right, width, corners):
    """A rounded edge of the frame, with words set into it on the left and
    right. None if they don't fit."""
    fill = width - 6 - visible_len(left) - (visible_len(right) + 2 if right else 0)
    fill -= left.count("☕")  # the cup emoji takes two cells
    if fill < 1:
        return None
    line = f"{EDGE}{corners[0]}─{RESET} {left} {EDGE}{'─' * fill}{RESET}"
    return line + (f" {right} " if right else "") + f"{EDGE}─{corners[1]}{RESET}"


def top_edge(state, now, width):
    """The frame's top edge: caffe, how long the Mac's been awake, and the
    tally. In a narrow pane, the less important words go first."""
    title, awake = f"{BOLD}☕ caffe{RESET}", f"{BOLD}{fmt_dur(now - state['start'])}{RESET}"
    battery = state.get("battery")
    if battery and battery[0] and battery[1] is not None:
        awake += f" {GOLD if state.get('saver') else DIM}battery {battery[1]}%{RESET}"
    tally_line, dash = summary(state, now), f" {EDGE}─{RESET} "
    lefts = (f"{title}{dash}{DIM}awake{RESET} {awake}", f"{title}{dash}{awake}", title)
    for left, right in [(left, tally_line) for left in lefts] + [(title, "")]:
        line = edge(left, right, width, "╭╮")
        if line:
            return line
    return f"{EDGE}╭{'─' * (width - 2)}╮{RESET}"


def bottom_edge(state, width):
    """The frame's bottom edge, with the longest key hint that fits."""
    name = state["cat"].name
    for hint in (f"p to pet {name} · f to feed · q to close", "p pet · f feed · q quit", "q quit"):
        line = edge(f"{DIM}{hint}{RESET}", "", width, "╰╯")
        if line:
            return line
    return f"{EDGE}╰{'─' * (width - 2)}╯{RESET}"


def framed(line, width):
    """A line inside the frame, between its sides."""
    body = line[1:] if line[:1] == " " else line  # the first column is the frame's side
    return f"{EDGE}│{RESET}{body}{' ' * max(0, width - 2 - visible_len(body))}{EDGE}│{RESET}"


def render(state, now, size=None):
    """The text lines for this moment, and the pictures to show on top of them.
    `size` is (columns, rows), by default the terminal's. Everything sits in a
    frame as wide as the pane, and as tall as it needs."""
    cols, term_rows = size or shutil.get_terminal_size((80, 24))
    width = cols - 1  # some terminals don't show the last column
    frame = Frame(width, state["gfx"])
    if state["toast"] and now < state["toast"][1]:
        news = f"  {GOLD}{trim(state['toast'][0], width - 4)}{RESET}"
    else:
        quips = DAY_QUIPS.get(daypart(now), QUIPS)
        news = f"  {DIM}{trim(f'“{quips[int(now // 8) % len(quips)]}”', width - 4)}{RESET}"
    frame.out = ["", news, ""]  # the first line becomes the top edge
    room = term_rows - 1 - TOP_ROWS - 1 - (LANE_ROWS if frame.gfx else 0) - 1
    spots = render_cards(state, now, frame, room)
    footer(state, frame)
    if frame.gfx:
        aim_cat(state, now, spots, len(frame.out))
        render_lane(state, now, frame, home=None if spots else width - 9)
    inside = [framed(line, width) for line in frame.out[1:]]
    frame.out = [top_edge(state, now, width), *inside, bottom_edge(state, width)]
    return frame.out, frame.pics


def frame_delay(state):
    """Animate smoothly while something moves; tick slowly while everything naps."""
    if not state["gfx"]:
        return IDLE_FRAME_S
    now = time.time()
    stirring = any(session_state(state, p, now)[0] == "brewing" for p in brewable(state))
    pouring = any(now - seen < POUR_S + 0.5 for seen in state["first_seen"].values())
    busy = stirring or pouring or state["leaving"] or "mouse" in state or "guest" in state
    if busy or state["cat"].moving():
        return FRAME_S
    return IDLE_FRAME_S


def who(state, pid, kind):
    """An order's name for the news line, such as "Claude in caffe"."""
    project = state.get("projects", {}).get(pid)
    return DRINKS[kind][0] + (f" in {project}" if project else "")


def update(state):
    now = time.time()
    for pid in [p for p in state["leaving"] if gone(state, p, now)]:
        del state["leaving"][pid]
        state["knocked"].pop(pid, None)
        state.get("projects", {}).pop(pid, None)
    live = scan_agents()
    if live is None:
        return
    sessions = scan_copilot_sessions()
    if sessions is None:
        sessions = {
            pid: record
            for pid, record in state["live"].items()
            if record[0] == COPILOT_SESSION_KIND
        }
    live.update(sessions)
    told = {}
    if any(session[0] == "t3" and is_app(session) for session in live.values()):
        t3 = scan_t3_sessions(now)
        if t3 is None:  # couldn't read them this time: keep what we had
            keep = {p: r for p, r in state["live"].items() if str(p).startswith("t3:")}
            t3 = keep, {p: state.get("told", {})[p] for p in keep if p in state.get("told", {})}
        live.update(t3[0])
        told = t3[1]
    take_orders(state, live, now)
    state["told"] = told
    state["live"] = live
    state["initialized"] = True
    track_activity(state, live, now)
    notice_turns(state, now)
    # Rush hour: lots of agents working at once. The cat hurries.
    working = sum(word == "brewing" for word in state["words"].values())
    if working >= RUSH_AT and not state["rush"]:
        state["toast"] = (f"Rush hour! {working} agents brewing at once.", now + 5)
    state["rush"] = working >= RUSH_AT
    bar_clock(state, now)


def take_orders(state, live, now):
    """New sessions pour in; finished ones are served. Open apps get a latte and
    run a tab, which they settle when they close."""
    fresh = live.keys() - state["live"].keys()
    projects = state.setdefault("projects", {})
    terminal = [p for p in fresh if isinstance(p, int)]  # sessions in a terminal
    projects.update((p, project_name(path)) for p, path in scan_cwds(terminal).items())
    for pid in sorted(fresh, key=lambda p: not is_app(live[p])):  # an order beats its app
        state["first_seen"][pid] = now
        if not state["initialized"]:
            continue
        state["visit"] = pid
        kind, source = live[pid][:2]
        if kind == COPILOT_SESSION_KIND:
            message = f"New session: {source} ☕"
        elif str(pid).startswith("t3:"):
            message = f"New order: {DRINKS[kind][0]} in T3 Code ☕"
        elif is_app(live[pid]):
            message = f"{DRINKS[kind][0]} opened a tab ☕"
        else:
            where = f" in {projects[pid]}" if pid in projects else f" on {source}"
            message = f"New order: {DRINKS[kind][0]}{where} ☕"
        state["toast"] = (message, now + 4)
    for pid in state["live"].keys() - live.keys():
        kind, tty_name, started, _, _ = state["live"][pid]
        state["first_seen"].pop(pid, None)
        forgotten = state.get("words", {}).get(pid) == "cold" and str(pid).startswith("t3:")
        if kind == COPILOT_SESSION_KIND or forgotten:  # it just leaves, unserved
            if state["cat"].target == pid:
                state["cat"].target = None
            continue
        dur = now - started
        state["leaving"][pid] = (kind, tty_name, now, started)
        state["visit"] = pid
        name = DRINKS[kind][0]
        if tty_name.startswith("app:"):  # an app's latte goes, but it's no order
            state["toast"] = (f"{name} settled its tab ✔", now + 5)
            continue
        state["orders"][name] = state["orders"].get(name, 0) + 1
        state["agent_time"] += now - max(started, state["start"])  # while the bar was open
        state["longest"] = max(state["longest"], (dur, name))
        state["toast"] = (f"Served: {who(state, pid, kind)}, after {fmt_dur(dur)} ✔", now + 5)


def notice_turns(state, now):
    """A session that finished its turn is ready: the cat goes to have a look.
    Left until it goes cold, the cat helps itself to the biscuit."""
    before = state.get("words", {})  # each session's state at the last poll
    biscuits = state.setdefault("biscuits", set())
    words = {p: session_state(state, p, now)[0] for p in brewable(state)}
    for pid, word in words.items():
        was, kind = before.get(pid), state["live"][pid][0]
        if word == "ready" and was not in (None, "ready"):
            state["visit"] = pid
            state["toast"] = (f"Order up! {who(state, pid, kind)} is waiting for you.", now + 6)
        elif word == "cold" and was == "ready":
            state["visit"] = pid
            biscuits.add(pid)
    biscuits.intersection_update(state["live"])
    state["words"] = words


def bar_clock(state, now):
    """Time of day: fika, a sleepier cat at night, and the odd mouse or stray."""
    cat, part = state["cat"], daypart(now)
    if part == "fika" and state.get("daypart") not in (None, "fika"):
        bun = fika_bun(now)
        state["toast"] = (f"Fika! {cat.name} sets out a {bun}.", now + 6)
        state["bun_bites"] = 0
    state["daypart"] = part
    cat.sleepy = part == "night"
    cat.speed = 12.0 if state["rush"] else (5.0 if cat.sleepy else 7.0)
    due = state.setdefault("due", set())
    if part != "fika":
        due.discard("nibble")
        state.pop("snack", None)
    elif random.random() < NIBBLE_ODDS:
        due.add("nibble")
    if random.random() < MOUSE_ODDS * (2 if cat.sleepy else 1):  # mice prefer the night
        due.add("mouse")
    if random.random() < GUEST_ODDS:
        due.add("guest")


def receipt(state, now):
    """The bill printed on quit: what was served, what broke, and the tip."""
    w, cat = 34, state["cat"]
    awake = now - state["start"]
    brewing = [
        s
        for s in state["live"].values()
        if s[0] != COPILOT_SESSION_KIND and not s[1].startswith("app:")
    ]
    agent_time = state["agent_time"] + sum(now - max(s[2], state["start"]) for s in brewing)
    orders = sorted(state["orders"].items(), key=lambda order: -order[1])
    items = [(f"Espresso · {name}", f"×{n}") for name, n in orders] or [("Cups served", "0")]
    if state["broken"]:
        items.append((f"Cups broken by {cat.name}", str(state["broken"])))
    if state.get("mice"):
        items.append((f"Mice caught by {cat.name}", str(state["mice"])))
    stats = [("Mac kept awake", fmt_dur(awake))]
    if agent_time >= 1:
        stats.append(("Agent time", f"{fmt_dur(agent_time)} ({agent_time / awake:.1f}×)"))
    if state["longest"][0] > 0:
        stats.append(("Longest pour", f"{fmt_dur(state['longest'][0])} ({state['longest'][1]})"))
    if brewing:
        stats.append(("Still brewing", str(len(brewing))))
    stats.append(("Barista", cat.name))
    if state.get("visitors"):
        stats.append(("Visiting cats", str(state["visitors"])))
    sections = [items, stats]
    tips = [f"{cat.pets} pet{'s' * (cat.pets > 1)} ♥"] if cat.pets else []
    if cat.fed:
        tips.append(f"{len(cat.fed)} treat{'s' * (len(cat.fed) > 1)}")
    if tips:  # one tip line, with the treats below the pets
        sections.append([(f"Tip for {cat.name}", tips[0]), *(("", t) for t in tips[1:])])
    order = f"Order #{state['order']:04d}"
    rule = f"  {'-' * w}"
    out = ["", rule, f"  {'CAFFE RECEIPT':^{w}}"]
    out.append(f"  {order}{time.strftime('%d %b %Y %H:%M', time.localtime(now)):>{w - len(order)}}")
    for rows in sections:
        out.append(rule)
        out += [f"  {k}{' ' * max(1, w - len(k) - len(v))}{v}" for k, v in rows]
    out += [rule, f"  {'Thanks, come again ☕':^{w}}", rule, ""]
    print("\n".join(out))


def start_caffeinate(saver=False):
    # -w ties caffeinate to our pid, so it stops even if caffe is killed. To save
    # battery, drop -d and -u so the display can sleep while the system stays up.
    flags = "-ims" if saver else "-dimsu"
    return subprocess.Popen(["/usr/bin/caffeinate", flags, "-w", str(os.getpid())])


def parse_battery(text):
    """(on battery, charge %) from `pmset -g batt`. Charge is None without a battery."""
    pct = re.search(r"(\d+)%", text)
    return "'Battery Power'" in text, int(pct[1]) if pct else None


def read_battery():
    try:
        out = subprocess.run(
            ["/usr/bin/pmset", "-g", "batt"], capture_output=True, text=True, timeout=5, check=False
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return parse_battery(out)


def check_power(state, caf):
    """On a low battery, let the display sleep; once plugged in, keep it on again.
    Returns the caffeinate process now running."""
    state["battery"] = battery = read_battery()
    if battery is None:  # couldn't tell: leave things as they are
        return caf
    saver = battery[0] and battery[1] is not None and battery[1] <= LOW_BATTERY
    if saver == state.get("saver", False):
        return caf
    state["saver"] = saver
    message = (
        f"Battery at {battery[1]}%. The display may sleep; agents keep brewing."
        if saver
        else "Plugged in. The display stays awake again."
    )
    state["toast"] = (message, time.time() + 6)
    caf.terminate()
    caf.wait()
    return start_caffeinate(saver)


def ask_terminal(fd, query):
    """Send `query` and return the terminal's reply. The device-attributes query
    after it is answered by every terminal, so we never wait longer than needed."""
    sys.stdout.write(query + "\033[c")
    sys.stdout.flush()
    reply, deadline = b"", time.time() + 1.0
    while time.time() < deadline and not re.search(rb"\033\[\?[\d;]*c", reply):
        if select.select([fd], [], [], 0.05)[0]:
            reply += os.read(fd, 1024)
    return reply


def kitty_graphics(fd):
    """Ask the terminal whether it can show pictures (kitty graphics protocol)."""
    if os.environ.get("TMUX"):
        return False
    return b"_Gi=31;OK" in ask_terminal(fd, "\033_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\033\\")


def cell_pixels(fd):
    """A cell's (width, height) in pixels, so pictures can move smoothly
    between cells. None if the terminal doesn't say."""
    size = re.search(rb"\033\[6;(\d+);(\d+)t", ask_terminal(fd, "\033[16t"))
    return (int(size[2]), int(size[1])) if size and int(size[1]) and int(size[2]) else None


def draw(state, now, gallery, shown):
    """Put this moment on screen. Returns the text lines now showing."""
    lines, pics = render(state, now)
    height = shutil.get_terminal_size((80, 24)).lines - 1
    lines = lines[:height]
    # Only rewrite lines that changed, so a quiet bar costs almost nothing.
    out = [
        f"\033[{y + 1};1H{line}\033[K"
        for y, line in enumerate(lines)
        if y >= len(shown) or shown[y] != line
    ]
    if len(lines) < len(shown):
        out.append(f"\033[{len(lines) + 1};1H\033[J")
    # The tab title tells you how the bar is doing while you're in another tab.
    title = f"☕ {tally(state, now) or 'caffe'}"
    if title != state.get("title"):
        state["title"] = title
        out.append(f"\033]2;{title}\007")
    if state["gfx"]:
        out.append(gallery.sync({o: p for o, p in pics.items() if p[2] < height}))
    if out:
        sys.stdout.write("".join(out))
        sys.stdout.flush()
    return lines


def on_key(state, key):
    """Handle a key press. Returns True to close the bar."""
    cat, now = state["cat"], time.time()
    if key == "p":
        cat.pet(now)
        state["toast"] = (f"{cat.name} purrs. ♥", now + 3)
    elif key == "f":
        ate = cat.feed(now)
        treat = f"{cat.name} munches a treat." if ate else f"{cat.name} is full. Maybe later."
        state["toast"] = (treat, now + 3)
    return key == "q"


INSTALL_URL = "https://raw.githubusercontent.com/alexgnq/caffe/main/install.sh"


def self_update():
    """Run the install script over this copy, wherever it was installed.
    Returns the exit code."""
    try:
        script = subprocess.run(
            ["/usr/bin/curl", "-fsSL", INSTALL_URL], check=True, capture_output=True, timeout=30
        ).stdout
    except (OSError, subprocess.SubprocessError):
        print("caffe update: couldn't download the installer.", file=sys.stderr)
        return 1
    bin_dir = os.path.dirname(os.path.abspath(sys.argv[0]))
    env = {**os.environ, "CAFFE_BIN_DIR": bin_dir}
    return subprocess.run(["/bin/sh"], input=script, env=env, check=False).returncode


def check_args():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        sys.exit(0)
    if sys.argv[1:] == ["update"]:
        sys.exit(self_update())
    if sys.argv[1:]:
        sys.exit("usage: caffe [update]   (press q to quit)")
    if not sys.stdin.isatty():
        sys.exit("caffe needs an interactive terminal.")


def main():
    check_args()
    caf = start_caffeinate()
    cat = Cat(time.time(), HOME_X)
    state = {
        "start": time.time(),
        "live": {},
        "leaving": {},
        "knocked": {},
        "first_seen": {},
        "orders": {},  # agent name: sessions served
        "agent_time": 0.0,
        "broken": 0,
        "order": random.randrange(1, 10000),
        "longest": (0, ""),
        "cat": cat,
        "toast": (
            GREETINGS.get(daypart(time.time()), "{} is on shift today.").format(
                cat.title, bun=fika_bun(time.time())
            ),
            time.time() + 6,
        ),
        "initialized": False,
        "gfx": False,
        "rush": False,
    }

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    resized = [False]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    gallery = Gallery()
    # Save the tab title, then switch to the alternate screen with no cursor and no
    # autowrap: a line too long for a narrow pane is cut off instead of spilling
    # onto the next row.
    sys.stdout.write("\033[22;2t\033[?1049h\033[?25l\033[?7l")
    try:
        tty.setcbreak(fd)
        state["gfx"] = kitty_graphics(fd)
        gallery.cell = cell_pixels(fd) if state["gfx"] else None
        last_poll, last_power, shown = 0.0, 0.0, []
        while True:
            now = time.time()
            if now - last_poll >= POLL_S:
                update(state)
                last_poll = now
            if now - last_power >= BATTERY_POLL_S:  # after update, so its toast stays up
                caf, last_power = check_power(state, caf), now
            if resized[0]:
                resized[0], shown = False, []
                sys.stdout.write((gallery.reset() if state["gfx"] else "") + "\033[2J")
                if state["gfx"]:  # a new font size changes the cells, too
                    gallery.cell = cell_pixels(fd)
            shown = draw(state, now, gallery, shown)
            r, _, _ = select.select([sys.stdin], [], [], frame_delay(state))
            if r and on_key(state, sys.stdin.read(1).lower()):
                break
            if caf.poll() is not None:
                caf = start_caffeinate(state.get("saver", False))
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if state["gfx"]:
            sys.stdout.write("\033_Ga=d,d=A,q=2\033\\")
        sys.stdout.write("\033[?7h\033[?25h\033[?1049l\033[23;2t")
        sys.stdout.flush()
        caf.terminate()
        receipt(state, time.time())


if __name__ == "__main__":
    main()
