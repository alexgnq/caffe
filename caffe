def cat_nap(breath):
    """Curled up asleep, tail wrapped round, head tucked in."""
    cx, cy, grow_by = 27, 27, breath * 0.5
    hx, hy = cx + 8, cy + 2.5
    tail = [(cx + 14.6 * math.cos(a / 10), cy + 12.4 * math.sin(a / 10)) for a in range(3, 31, 3)]
    return {
        "tail": path(tail, 2.5),
        "body": ellipse(cx, cy, 15.5 + grow_by, 13 + grow_by),
