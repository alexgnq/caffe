def cat_sprite(coat, pose_key, flip, k):
    _, fur, dark, light, eye, pattern = COATS[coat]
    p = CAT_POSES[pose_key[0]](*pose_key[1:])
    img = Img(math.ceil(7 * k), math.ceil(3 * k), k)
    dark_fur = sum(fur) < 300
    edge = (128, 128, 142) if dark_fur else mix(fur, INK, 0.55)
    outer = [p["tail"], p["body"], p["head"], *p["ears"], *p.get("legs", []), *p.get("far", [])]
    silhouette = union(*outer)
    img.fill(grow(union(p["body"], p["head"]), 3.5), INK, 0.22)  # its shadow on the table
    img.fill(grow(silhouette, 1.1), edge)
    for leg in p.get("far", []):
        img.fill(leg, mix(fur, INK, 0.3))
    for part in (p["tail"], p["body"], *p.get("legs", [])):
        img.fill(part, fur)
    img.fill(grow(p["head"], 0.7), edge, 0.6)
    img.fill(p["head"], fur)
    for ear in p["ears"]:
        img.fill(ear, fur)
    cat_markings(img, p, pattern, dark, silhouette)
    for part in (*p["light"], *p.get("paws", [])):
        img.fill(part, dark if pattern == "points" and part in p.get("paws", []) else light)
    for part in p["inner"]:
        img.fill(part, PINK)
    img.fill(p["nose"], PINK)
    if "mouth" in p:
        img.fill(p["mouth"], (120, 40, 52))
    size = p.get("eye", 1.0)
    for x, y in p.get("eyes", []):
        img.fill(ellipse(x, y, 1.9 * size, 2.3 * size), eye)
        img.fill(ellipse(x + 0.1, y + 0.2, 0.85 * size, 1.9 * size), INK)
        img.fill(circle(x + 0.6 * size, y - 0.8 * size, 0.55 * size), WHITE)
    if not p.get("eyes"):
        for lid in p.get("closed", []):
            img.fill(lid, (170, 170, 182) if dark_fur else INK)
    return img.mirror() if flip else img


def cat_markings(img, p, pattern, dark, silhouette):
    if pattern == "tabby":
        for stripe in p["stripes"]:
            img.fill(clip(stripe, silhouette), dark)
    elif pattern == "calico":
        for shape, color in p["patches"]:
            img.fill(clip(shape, silhouette), color or dark)
    elif pattern == "points":
        for part in (p["tail"], *p["ears"], *p.get("legs", [])):
            img.fill(part, dark, 0.85)
        img.fill(clip(grow(union(*p["light"][-1:]), 2.5), p["head"]), dark, 0.7)


HEART_FRAMES = 16


def heart(cx, cy, s):
    return union(
        circle(cx - s * 0.9, cy, s),
        circle(cx + s * 0.9, cy, s),
        poly((cx - s * 1.85, cy + s * 0.35), (cx + s * 1.85, cy + s * 0.35), (cx, cy + s * 2.4)),
    )


def hearts_sprite(frame):
    """Two little hearts floating up from a purring cat."""
    img = Img(4, 3)
    for j in (0, 1):
        p = (frame / HEART_FRAMES + j * 0.5) % 1
        x = 16 + (j * 2 - 1) * 4 + 2 * math.sin(p * 6 + j)
        img.fill(heart(x, 42 - p * 36, 1.6 + p), (240, 92, 124), math.sin(math.pi * p))
    return img


def ground_img(cols, k):
    """A one-row sprite whose shapes sit on the bottom row of the cat's strip of table."""
    img = Img(math.ceil(cols * k), 1, k)
    img.move(0, (0, 0), (0, CH / k - CH))
    return img


def mouse_sprite(step, flip, k):
