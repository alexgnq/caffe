class Gallery:
    """Sends each sprite to the terminal once (kitty graphics protocol) and keeps
    the pictures on screen in sync with what render() asks for."""

    BASE_ID = 0xCAFE00

    def __init__(self):
        self.images, self.uploads, self.sent, self.objects, self.shown = {}, {}, set(), {}, {}

    def image(self, key, out):
        if key not in self.images:
            img = SPRITES[key[0]](*key[1:])
            iid = self.BASE_ID + len(self.images)
            data = base64.standard_b64encode(zlib.compress(bytes(img.buf))).decode()
            chunks = [data[i : i + 4096] for i in range(0, len(data), 4096)] or [""]
            self.uploads[key] = "".join(
                f"\033_G{f'a=t,q=2,f=32,o=z,i={iid},s={img.w},v={img.h},' if n == 0 else ''}"
                f"m={int(n < len(chunks) - 1)};{chunk}\033\\"
                for n, chunk in enumerate(chunks)
            )
            self.images[key] = (iid, img.cols, img.rows)
        if key not in self.sent:
            out.append(self.uploads[key])
            self.sent.add(key)
        return self.images[key]

    def reset(self):
        """Start over after a resize: terminals may drop pictures, image data included."""
        self.sent, self.shown = set(), {}
        return "\033_Ga=d,d=A,q=2\033\\"

    def sync(self, want):
        """want: {object: (sprite key, col, row, z)}. Returns the escape codes."""
        out, shown = [], {}
        for obj, (key, col, row, z) in want.items():
            pid = self.objects.setdefault(obj, len(self.objects) + 1)
            iid, cols, rows = self.image(key, out)
            spot = (iid, col, row, z)
            old = self.shown.get(pid)
            if old != spot:
                out.append(
                    f"\033[{row + 1};{max(0, col) + 1}H"
                    f"\033_Ga=p,i={iid},p={pid},c={cols},r={rows},z={z},C=1,q=2\033\\"
                )
                if old and old[0] != iid:
                    out.append(f"\033_Ga=d,d=i,i={old[0]},p={pid},q=2\033\\")
            shown[pid] = spot
        for pid in self.shown.keys() - shown.keys():
            out.append(f"\033_Ga=d,d=i,i={self.shown[pid][0]},p={pid},q=2\033\\")
        self.shown = shown
        return "".join(out)


class Cat:
    """The barista cat. It walks along the counter behind the cups, goes over to
    new and finished cups, grooms, yawns, and naps when the bar is quiet. `x` is
    the column of its middle."""

    MIN_X = 4  # how close its middle gets to the edges

    def __init__(self, now, home):
        self.coat = random.randrange(len(COATS))
        self.name = random.choice(CAT_NAMES)
        self.x = self.goal = float(home)
        self.dir, self.last, self.speed = 1, now, 7.0  # cols/s
        self.plan, self.mode, self.until = [], "nap", now + 4
        self.pets, self.petted_at, self.target = 0, 0.0, None

    @property
    def title(self):
        return f"{self.name} the {COATS[self.coat][0]} cat"

    def go(self, x):
        self.goal, self.mode, self.plan = float(x), "walk", []

    def moving(self):
        return self.mode in ("walk", "purr", "slap")

    def slap(self, now):
        self.mode, self.until, self.plan = "slap", now + 1.6, [("sit", 2.5)]

    def pet(self, now):
        """Stop whatever it's doing and purr for a bit."""
        self.pets += 1
        self.target = None  # it got distracted on its way to a cup
        self.mode, self.until, self.plan, self.petted_at = "purr", now + 3, [("sit", 1.5)], now

    def _arrive(self, now, calm, free_x, home):
        u = random.uniform
        if home is not None:
            self.plan = [("nap", u(20, 40)), ("sit", 1.5), ("groom", u(2, 4))]
        elif calm and self.x >= free_x and random.random() < 0.5:
            self.plan = [("nap", u(8, 16)), ("yawn", 1.2)]
        else:
            self.plan = random.choice(
                [
                    [("sit", u(2, 5))],
                    [("groom", u(2, 3)), ("sit", u(1, 3))],
                    [("sit", u(2, 4)), ("yawn", 1.2)],
                ]
            )
        self._next(now)

    def _next(self, now):
        self.mode, dur = self.plan.pop(0)
        self.until = now + dur

    def step(self, now, lane_w, calm, free_x, home=None):
        dt = min(0.5, now - self.last)
        self.last = now
        max_x = float(max(self.MIN_X, lane_w - self.MIN_X))
        if home is not None and abs(self.goal - home) > 0.5:
            self.go(home)
        if self.mode == "walk":
            goal = min(max(self.goal, self.MIN_X), max_x)
            if abs(goal - self.x) <= self.speed * dt:
                self.x = goal
                self._arrive(now, calm, free_x, home)
            else:
                self.dir = 1 if goal > self.x else -1
                self.x += self.dir * self.speed * dt
        elif now >= self.until:
            if self.plan:
                self._next(now)
            elif home is not None:
                self._arrive(now, calm, free_x, home)
            elif free_x <= max_x and random.random() < 0.6:
                self.go(random.uniform(free_x, max_x))
            else:
                self.go(random.uniform(self.MIN_X, max_x))
        self.x = min(max(self.x, self.MIN_X), max_x)

    def pose(self, now):
        """The sprite pose for this moment, and whether to mirror it."""
        mirrored = self.dir < 0
        poses = {
            "walk": (("walk", int(now * 8) % 4), mirrored),
            "nap": (("nap", int(now / 1.2) % 2), mirrored),
            "groom": (("groom", 1 + int(now * 3) % 2), False),
            "yawn": (("yawn",), False),
            "purr": (("sit", int(now * 4) % 3, True), False),
            "slap": (
                ("slap", 1 if self.until - now > 1.3 else (2 if self.until - now > 1 else 3)),
                False,
            ),
        }
        return poses.get(self.mode, (("sit", int(now * 1.5) % 3, now % 5 < 0.25), False))

    def place(self, frame, art, top, k, now):
        """Put the cat's picture in `frame`, and its zZ in the text `art` rows."""
        pose, flip = self.pose(now)
        cols, rows, cat_rows = math.ceil(7 * k), len(art), math.ceil(3 * k)
        left = round(self.x) - cols // 2
        frame.pics["cat"] = (("cat", self.coat, pose, flip, k), left, top + rows - cat_rows, 1)
        if self.mode == "purr":
            beat = int((now - self.petted_at) / 0.1) % HEART_FRAMES
            row = max(top, top + rows - cat_rows - 2)
            frame.pics["hearts"] = (("hearts", beat), left + 2, row, 4)
        if pose[0] == "nap":
            for i, ch in enumerate("zZ"):
                r = rows - cat_rows - (int(now * 1.5) + i) % 2
                col = left + (cols - 2 if not flip else 1) + i
                if 0 <= r < rows and 0 <= col < len(art[r]):
                    art[r][col] = f"{DIM}{ch}{RESET}"


# name, cell width per cup, art rows, mug zoom, steam rows
LAYOUTS = (("full", 14, 6, 1.0, 4), ("short", 14, 4, 1.0, 2), ("mini", 8, 2, 2 / 3, 0))
TEXT_LAYOUT = ("text", 14, 0, 1.0, 0)
HOME_X = 13


def pick_layout(count, width, rows, gfx):
    """The roomiest layout whose counters all fit on screen."""
    for layout in LAYOUTS if gfx else (TEXT_LAYOUT,):
        per_row = max(1, (width - 2) // layout[1])
        if -(-count // per_row) * (layout[2] + 4) <= rows:
            break
    return layout, per_row


def cup_activity(session, now):
    """Steam level and status for a settled drink."""
    kind, source, started, cpu, ram_mb = session
    if kind == COPILOT_SESSION_KIND:
        return 1, f"{DIM}working{RESET}"
    if source.startswith("app:"):
        return app_steam_level(cpu, ram_mb), f"{DIM}{cpu:.0f}% · {fmt_mem(ram_mb)}{RESET}"
    level = 2 if cpu >= BUSY_CPU else (1 if cpu >= WORKING_CPU else 0)
    return level, f"{DIM}{fmt_dur(now - started)}{RESET}"


def cup_label(kind, source, k):
    style_kind = "copilot" if kind == COPILOT_SESSION_KIND else kind
    name, color, _ = DRINKS[style_kind]
    if kind == COPILOT_SESSION_KIND:
        name = "Agent"
    label = f"{color}{name}{RESET}"
    if k == 1 and not source.startswith("app:") and kind != COPILOT_SESSION_KIND:
        label += f" {DIM}{source.replace('ttys', 's')}{RESET}"
    return label


def cup_cell(state, pid, now, layout, spot):
    """Pictures and two label lines for one cup on the counter at (col, top)."""
    _, _, art_h, k, steam_rows = layout
    col, top = spot
    mug_row = top + art_h - math.ceil(3 * k)
    pics = {}
    leaving = pid in state["leaving"]
    session = state["leaving"][pid] if leaving else state["live"][pid]
    kind, tty_name = session[:2]
    drink = "latte" if kind != COPILOT_SESSION_KIND and tty_name.startswith("app:") else "espresso"
    over = mug_row + DRINK_RIMS[drink] // CH + 1 - steam_rows
    if isinstance(pid, str):
        seed = zlib.crc32(pid.encode())
    else:
        seed = pid if isinstance(pid, int) else pid[0] + sum(map(ord, pid[1]))
    style = drink, seed % 3
    if leaving:
        ended = session[2]
        fill = 2 - min(2, int((now - ended) / DRAIN_S * 3))
        pics[("mug", pid)] = (("mug", SERVED_GLAZE, fill, k, style, 4), col, mug_row, 2)
        knocked = state["knocked"].get(pid, now + 1)
        if knocked <= now:
            frame = min(KNOCK_FRAMES - 1, int((now - knocked) / KNOCK_S * KNOCK_FRAMES))
            up = math.ceil(4 * k) - math.ceil(3 * k)
            knock = ("knock", SERVED_GLAZE, frame, k, style)
            pics[("mug", pid)] = (knock, col - round(4 * k), mug_row - up, 2)
        status = f"{GOLD}✔ served{RESET}" if k == 1 else f"{GOLD}✔{RESET}"
    else:
        style_kind = "copilot" if kind == COPILOT_SESSION_KIND else kind
        glaze = DRINKS[style_kind][2]
        seen = state["first_seen"].get(pid, 0)
        # Sessions already running at startup are served full; new ones pour in.
        poured = min(1.0, (now - seen) / POUR_S) if seen > state["start"] + 1 else 1.0
        if kind == COPILOT_SESSION_KIND:
            poured = 1.0
        level, status = cup_activity(session, now)
        if poured < 1:
            pics[("mug", pid)] = (("mug", glaze, int(poured * 2), k, style, 4), col, mug_row, 2)
            if steam_rows:
                pics[("pour", pid)] = (("pour", int(now * 10) % 4, steam_rows, drink), col, over, 3)
            if drink != "latte":
                status = f"{GOLD}pouring…{RESET}"
        else:
            settled = now - seen - POUR_S
            wobble = min(4, max(0, int(settled / 0.12))) if seen > state["start"] + 1 else 4
            pics[("mug", pid)] = (("mug", glaze, 2, k, style, wobble), col, mug_row, 2)
            if steam_rows:
                frame = (int(now / 0.12) + seed) % STEAM_FRAMES
                pics[("steam", pid)] = (("steam", level, frame, steam_rows, drink), col, over, 3)
    return pics, cup_label(kind, tty_name, k), status


class Frame:
    """One screen being built: text lines, and the pictures to show on them."""

    def __init__(self, width, gfx):
        self.width, self.gfx, self.out, self.pics = width, gfx, [], {}

    def art(self, rows):
        return [[" "] * self.width for _ in range(rows)]

    def add(self, art):
        self.out += ["".join(row).rstrip() for row in art]

    def counter(self):
        if self.gfx:
            self.pics[("counter", len(self.out))] = (("counter", self.width), 0, len(self.out), 0)
            self.out.append("")
        else:
            self.out.append(f"{WOOD}{'▀' * self.width}{RESET}")


def render_idle(state, now, frame):
    """An empty bar: a clean cup and a napping cat."""
    if frame.gfx:
        top, art = len(frame.out), frame.art(6)
        frame.pics["idle"] = (("mug", SERVED_GLAZE, 0, 1.0), 2, top + 3, 2)
        state["cat"].step(now, frame.width, calm=True, free_x=HOME_X, home=HOME_X)
        state["cat"].place(frame, art, top, 1.0, now)
        frame.add(art)
    frame.counter()
    quip = random.Random(int(now // 10)).choice(IDLE_QUIPS)
    frame.out += [f"  {DIM}{quip}{RESET}", ""]


def cat_visit(state, now):
    """When the cat reaches a finished cup, it swats it off the bar."""
    cat = state["cat"]
    if cat.target is None or cat.mode == "walk":
        return
    pid = cat.target
    if pid in state["leaving"] and pid not in state["knocked"]:
        cat.slap(now)
        state["knocked"][pid] = now + 0.3  # the paw lands a moment after the swing starts
        state["broken"] += 1
        who = DRINKS[state["leaving"][pid][0]][0]
        state["toast"] = (f"{cat.name} knocked {who}'s cup off the bar.", now + 4)
    elif pid not in state["knocked"]:
        cat.target = None


def gone(state, pid, now):
    """Whether a finished cup has left the counter. With graphics, the cat swats
    every cup it can reach; the rest leave on their own."""
    if pid in state["knocked"]:
        return now > state["knocked"][pid] + KNOCK_S
    waits_for_cat = state["gfx"] and pid not in state.get("hidden", ())
    return not waits_for_cat and now > state["leaving"][pid][2] + SERVED_S


def render_cups(state, now, pids, frame, room_rows):
    """Rows of cups on counters, with the cat behind the last row."""
    cat = state["cat"]
    calm = not any(is_working(session) for session in state["live"].values())
    layout, per_row = pick_layout(len(pids), frame.width, room_rows, frame.gfx)
    _, cell, art_h, k, _ = layout
    # Even mini cups can run out of room: show what fits and count the rest.
    room = max(1, room_rows // (art_h + 4)) * per_row
    hidden = max(0, len(pids) - room)
    groups = [pids[i : i + per_row] for i in range(0, min(room, len(pids)), per_row)]
    visible = pids[:room]
    state["hidden"] = set(pids[room:])
    visit = state.pop("visit", None)
    if cat.target not in visible:
        cat.target = None
    if frame.gfx and cat.mode not in ("purr", "slap"):
        pending = [p for p in visible if p in state["leaving"] and p not in state["knocked"]]
        target = cat.target if cat.target in pending else next(iter(pending), visit)
        if target in visible:
            index = visible.index(target) % per_row
            goal = 2 + index * cell + math.ceil(6 * k) + 3
            if cat.target != target or cat.goal != goal:
                cat.go(goal)
            cat.target = target
    cat_row = next((i for i, group in enumerate(groups) if cat.target in group), len(groups) - 1)
    for gi, group in enumerate(groups):
        top, art, cells = len(frame.out), frame.art(art_h), []
        for ci, pid in enumerate(group):
            pics, label, status = cup_cell(state, pid, now, layout, (2 + ci * cell, top))
            if frame.gfx:
                frame.pics.update(pics)
            cells.append((label, status))
        if frame.gfx and gi == cat_row:
            cat.step(now, frame.width, calm, free_x=2 + len(group) * cell + 3)
            cat_visit(state, now)
            cat.place(frame, art, top, k, now)
        frame.add(art)
        frame.counter()
        frame.out.append("  " + "".join(pad(label, cell) for label, _ in cells))
        frame.out.append("  " + "".join(pad(status, cell) for _, status in cells))
        frame.out.append("")
    if hidden:
        frame.out[-1] = f"  {DIM}+{hidden} more cups behind the counter{RESET}"


def header(state, now, width):
    """The title line, with the longest key hint that fits."""
    awake = (
        f"{BOLD}☕ caffe{RESET}  {DIM}Mac awake for{RESET} {BOLD}{fmt_dur(now - state['start'])}"
    )
    for hint in (f"p to pet {state['cat'].name} · q to close", "p pet · q quit", ""):
        line = f"{awake}{RESET}   {DIM}{hint}{RESET}" if hint else f"{awake}{RESET}"
        if visible_len(line) + 1 <= width:  # +1: the cup emoji takes two cells
            break
    return line


def render(state, now):
    """The text lines for this moment, and the pictures to show on top of them."""
    cols, term_rows = shutil.get_terminal_size((80, 24))
    frame = Frame(min(cols, 96), state["gfx"])
    frame.out = [header(state, now, frame.width), DIM + "─" * frame.width + RESET]
    # Cups keep their place on the counter, oldest session first.
    started = {p: session[2] for p, session in state["live"].items()}
    started.update((p, c[3]) for p, c in state["leaving"].items() if not gone(state, p, now))
    pids = sorted(started, key=started.get)
    if pids:
        render_cups(state, now, pids, frame, term_rows - 5)
    else:
        render_idle(state, now, frame)
    if state["toast"] and now < state["toast"][1]:
        frame.out.append(f"  {GOLD}{state['toast'][0]}{RESET}")
    else:
        frame.out.append(f"  {DIM}“{QUIPS[int(now // 8) % len(QUIPS)]}”{RESET}")
    return frame.out, frame.pics


def frame_delay(state):
    """Animate smoothly while something moves; tick slowly while everything naps."""
    if not state["gfx"]:
        return IDLE_FRAME_S
    if state["live"] or state["leaving"] or state["cat"].moving():
        return FRAME_S
    return IDLE_FRAME_S


def update(state):
    now = time.time()
    for pid in [p for p in state["leaving"] if gone(state, p, now)]:
        del state["leaving"][pid]
        state["knocked"].pop(pid, None)
    live = scan_agents()
    if live is None:
        return
    sessions = scan_copilot_sessions()
    if sessions is None:
        sessions = {
            pid: record
            for pid, record in state["live"].items()
            if record[0] == COPILOT_SESSION_KIND
        }
    live.update(sessions)
    for pid in live.keys() - state["live"].keys():
        state["first_seen"][pid] = now
        if state["initialized"]:
            state["visit"] = pid
            kind, source = live[pid][:2]
            if kind == COPILOT_SESSION_KIND:
                message = f"New session: {source} ☕"
            else:
                where = "" if source.startswith("app:") else f" on {source}"
                message = f"New order: {DRINKS[kind][0]}{where} ☕"
            state["toast"] = (message, now + 4)
    for pid in state["live"].keys() - live.keys():
        kind, tty_name, started, _, _ = state["live"][pid]
        if kind == COPILOT_SESSION_KIND:
            state["first_seen"].pop(pid, None)
            if state["cat"].target == pid:
                state["cat"].target = None
            continue
        dur = now - started
        state["leaving"][pid] = (kind, tty_name, now, started)
        state["visit"] = pid
        name = DRINKS[kind][0]
        # Only sessions count on the receipt: an open app would always be the longest pour.
        if not tty_name.startswith("app:"):
            state["orders"][name] = state["orders"].get(name, 0) + 1
            state["agent_time"] += dur
            state["longest"] = max(state["longest"], (dur, name))
        state["toast"] = (f"Order up: {name} served after {fmt_dur(dur)} ✔", now + 5)
        state["first_seen"].pop(pid, None)
    state["live"] = live
    state["initialized"] = True
    # Rush hour: lots of agents working at once. The cat hurries.
    working = sum(is_working(session) for session in live.values())
    if working >= RUSH_AT and not state["rush"]:
        state["toast"] = (f"Rush hour! {working} agents brewing at once.", now + 5)
    state["rush"] = working >= RUSH_AT
    state["cat"].speed = 12.0 if state["rush"] else 7.0


def receipt(state, now):
    """The bill printed on quit: what was served, what broke, and the tip."""
    w, cat = 34, state["cat"]
    awake = now - state["start"]
    brewing = [
        s
        for s in state["live"].values()
        if s[0] != COPILOT_SESSION_KIND and not s[1].startswith("app:")
    ]
    agent_time = state["agent_time"] + sum(now - session[2] for session in brewing)
    orders = sorted(state["orders"].items(), key=lambda order: -order[1])
    items = [(f"Espresso · {name}", f"×{n}") for name, n in orders] or [("Cups served", "0")]
    if state["broken"]:
        items.append((f"Cups broken by {cat.name}", str(state["broken"])))
    stats = [("Mac kept awake", fmt_dur(awake))]
    if agent_time >= 1:
        stats.append(("Agent time", f"{fmt_dur(agent_time)} ({agent_time / awake:.1f}×)"))
    if state["longest"][0] > 0:
        stats.append(("Longest pour", f"{fmt_dur(state['longest'][0])} ({state['longest'][1]})"))
    if brewing:
        stats.append(("Still brewing", str(len(brewing))))
    stats.append(("Barista", cat.name))
    sections = [items, stats]
    if cat.pets:
        sections.append([(f"Tip for {cat.name}", f"{cat.pets} pet{'s' * (cat.pets > 1)} ♥")])
    order = f"Order #{state['order']:04d}"
    rule = f"  {'-' * w}"
    out = ["", rule, f"  {'CAFFE RECEIPT':^{w}}"]
    out.append(f"  {order}{time.strftime('%d %b %Y %H:%M', time.localtime(now)):>{w - len(order)}}")
    for rows in sections:
        out.append(rule)
        out += [f"  {k}{' ' * max(1, w - len(k) - len(v))}{v}" for k, v in rows]
    out += [rule, f"  {'Thanks, come again ☕':^{w}}", rule, ""]
    print("\n".join(out))


def start_caffeinate():
    # -w ties caffeinate to our pid, so it stops even if caffe is killed.
    return subprocess.Popen(["/usr/bin/caffeinate", "-dimsu", "-w", str(os.getpid())])


def kitty_graphics(fd):
    """Ask the terminal whether it can show pictures (kitty graphics protocol).
    The device-attributes query after it is answered by every terminal, so we
    never wait longer than needed."""
    if os.environ.get("TMUX"):
        return False
    sys.stdout.write("\033_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\033\\\033[c")
    sys.stdout.flush()
    reply, deadline = b"", time.time() + 1.0
    while time.time() < deadline and not re.search(rb"\033\[\?[\d;]*c", reply):
        if select.select([fd], [], [], 0.05)[0]:
            reply += os.read(fd, 1024)
    return b"_Gi=31;OK" in reply


def draw(state, now, gallery, shown):
    """Put this moment on screen. Returns the text lines now showing."""
    lines, pics = render(state, now)
    height = shutil.get_terminal_size((80, 24)).lines - 1
    lines = lines[:height]
    # Only rewrite lines that changed, so a quiet bar costs almost nothing.
    out = [
        f"\033[{y + 1};1H{line}\033[K"
        for y, line in enumerate(lines)
        if y >= len(shown) or shown[y] != line
    ]
    if len(lines) < len(shown):
        out.append(f"\033[{len(lines) + 1};1H\033[J")
    if state["gfx"]:
        out.append(gallery.sync({o: p for o, p in pics.items() if p[2] < height}))
    if out:
        sys.stdout.write("".join(out))
        sys.stdout.flush()
    return lines


def on_key(state, key):
    """Handle a key press. Returns True to close the bar."""
    if key == "p":
        state["cat"].pet(time.time())
        state["toast"] = (f"{state['cat'].name} purrs. ♥", time.time() + 3)
    return key == "q"


INSTALL_URL = "https://raw.githubusercontent.com/alexgnq/caffe/main/install.sh"


def self_update():
    """Run the install script over this copy, wherever it was installed.
    Returns the exit code."""
    try:
        script = subprocess.run(
            ["/usr/bin/curl", "-fsSL", INSTALL_URL], check=True, capture_output=True, timeout=30
        ).stdout
    except (OSError, subprocess.SubprocessError):
        print("caffe update: couldn't download the installer.", file=sys.stderr)
        return 1
    bin_dir = os.path.dirname(os.path.abspath(sys.argv[0]))
    env = {**os.environ, "CAFFE_BIN_DIR": bin_dir}
    return subprocess.run(["/bin/sh"], input=script, env=env, check=False).returncode


def check_args():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        sys.exit(0)
    if sys.argv[1:] == ["update"]:
        sys.exit(self_update())
    if sys.argv[1:]:
        sys.exit("usage: caffe [update]   (press q to quit)")
    if not sys.stdin.isatty():
        sys.exit("caffe needs an interactive terminal.")


def main():
    check_args()
    caf = start_caffeinate()
    cat = Cat(time.time(), HOME_X)
    state = {
        "start": time.time(),
        "live": {},
        "leaving": {},
        "knocked": {},
        "first_seen": {},
        "orders": {},  # agent name: sessions served
        "agent_time": 0.0,
        "broken": 0,
        "order": random.randrange(1, 10000),
        "longest": (0, ""),
        "cat": cat,
        "toast": (f"{cat.title} is on shift today.", time.time() + 6),
        "initialized": False,
        "gfx": False,
        "rush": False,
    }

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    resized = [False]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    gallery = Gallery()
    # Alternate screen, no cursor, and no autowrap: a line too long for a narrow
    # pane is cut off instead of spilling onto the next row.
    sys.stdout.write("\033[?1049h\033[?25l\033[?7l")
    try:
        tty.setcbreak(fd)
        state["gfx"] = kitty_graphics(fd)
        last_poll, shown = 0.0, []
        while True:
            now = time.time()
            if now - last_poll >= POLL_S:
                update(state)
                last_poll = now
            if resized[0]:
                resized[0], shown = False, []
                sys.stdout.write((gallery.reset() if state["gfx"] else "") + "\033[2J")
            shown = draw(state, now, gallery, shown)
            r, _, _ = select.select([sys.stdin], [], [], frame_delay(state))
            if r and on_key(state, sys.stdin.read(1).lower()):
                break
            if caf.poll() is not None:
                caf = start_caffeinate()
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if state["gfx"]:
            sys.stdout.write("\033_Ga=d,d=A,q=2\033\\")
        sys.stdout.write("\033[?7h\033[?25h\033[?1049l")
        sys.stdout.flush()
        caf.terminate()
        receipt(state, time.time())


if __name__ == "__main__":
    main()
