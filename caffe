#!/usr/bin/env python3
"""caffe: keep the Mac awake, with a coffee bar of your running agent sessions.

Every interactive Copilot CLI / Codex CLI / Claude Code session is a cup on the
counter. When a session ends, its cup is stamped on the loyalty card.
Press q (or Ctrl-C) to close the bar and get your receipt.
"""

import json
import os
import random
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty

AGENTS = {
    "copilot": ("Copilot", "\033[38;5;141m"),
    "codex": ("Codex", "\033[38;5;78m"),
    "claude": ("Claude", "\033[38;5;209m"),
}
RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
BROWN, STEAM, GOLD = "\033[38;5;130m", "\033[38;5;250m", "\033[38;5;220m"
STATS = os.environ.get("CAFFE_STATS") or os.path.expanduser("~/.local/state/caffe/stats.json")
CARD = 10
POLL_S, FRAME_S, POUR_S = 2.0, 0.25, 2.5

QUIPS = [
    "Brewing tokens, one sip at a time.",
    "Sleep is for laptops without agents.",
    "Espresso yourself.",
    "Decaf? Never heard of it.",
    "This display is held open by pure caffeine.",
    "Your agents are working. Your Mac is vibing.",
    "Bean there, done that.",
    "Mocha progress today.",
    "Latte work getting done.",
    "Frothing the context window.",
]
IDLE_QUIPS = [
    "No orders. The barista polishes an empty cup.",
    "Quiet bar. Start an agent and I'll pour.",
    "Counter's clean. Mac's still awake, as you asked.",
]

STEAM_FRAMES = [
    ("  ) (  ", " ( ) ) "),
    (" ( (   ", "  ) ) )"),
    ("   ) ) ", " ( ( ( "),
    ("  ( (  ", " ) ) ) "),
]


def parse_etime(s):
    days, rest = s.split("-", 1) if "-" in s else ("0", s)
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts
    return int(days) * 86400 + h * 3600 + m * 60 + sec


def agent_kind(args):
    for tok in args.split()[:2]:
        name = os.path.basename(tok)
        if name in AGENTS:
            return name
    return None


def scan_agents():
    """Return {pid: (kind, tty, started_at)} for interactive agent sessions."""
    try:
        out = subprocess.run(
            ["/bin/ps", "-axo", "pid=,ppid=,tty=,etime=,args="],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    now, found = time.time(), {}
    for line in out.splitlines():
        cols = line.split(None, 4)
        if len(cols) < 5 or cols[2] == "??":
            continue
        kind = agent_kind(cols[4])
        if kind:
            found[int(cols[0])] = (kind, int(cols[1]), cols[2], now - parse_etime(cols[3]))
    # Drop helper processes whose parent is itself an agent session.
    return {pid: (k, t, st) for pid, (k, ppid, t, st) in found.items() if ppid not in found}


def fmt_dur(sec):
    sec = int(sec)
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}h {m:02d}m" if h else (f"{m}m {s:02d}s" if m else f"{s}s")


def load_stats():
    stats = {"lifetime_cups": 0, "free_coffees": 0}
    try:
        with open(STATS) as f:
            loaded = json.load(f)
    except (OSError, ValueError):
        return stats
    if isinstance(loaded, dict):
        for key in stats:
            value = loaded.get(key)
            if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
                stats[key] = value
    return stats


def save_stats(stats):
    os.makedirs(os.path.dirname(STATS), exist_ok=True)
    with open(STATS, "w") as f:
        json.dump(stats, f)


def cup_lines(kind, frame, fill):
    color = AGENTS[kind][1]
    s1, s2 = STEAM_FRAMES[frame % len(STEAM_FRAMES)]
    liquid = "~~~~~" if fill >= 1 else ("_____" if fill >= 0.5 else "     ")
    steam = (s1, s2) if fill >= 1 else ("       ", "       ")
    return [
        f"{STEAM}{steam[0]} {RESET}",
        f"{STEAM}{steam[1]} {RESET}",
        f"{color}.-----. {RESET}",
        f"{color}|{BROWN}{liquid}{color}|]{RESET}",
        f"{color}`-----' {RESET}",
    ]


def visible_len(s):
    out, esc = 0, False
    for ch in s:
        if ch == "\033":
            esc = True
        elif esc and ch == "m":
            esc = False
        elif not esc:
            out += 1
    return out


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


def render(state, frame):
    cols, rows = shutil.get_terminal_size((80, 24))
    now = time.time()
    out = []
    awake = fmt_dur(now - state["start"])
    out.append(
        f"{BOLD}☕ caffe{RESET}  {DIM}Mac awake for{RESET} {BOLD}{awake}{RESET}"
        f"   {DIM}q to close the bar{RESET}"
    )
    out.append(DIM + "─" * min(cols, 72) + RESET)
    out.append("")

    sessions = sorted(state["live"].items(), key=lambda kv: kv[1][2])
    if not sessions:
        out.append(f"   {DIM}.-----.{RESET}")
        out.append(f"   {DIM}|     |]  {random.Random(int(now // 10)).choice(IDLE_QUIPS)}{RESET}")
        out.append(f"   {DIM}`-----'{RESET}")
        out.append("")
    else:
        cell = 14
        per_row = max(1, (cols - 2) // cell)
        for i in range(0, len(sessions), per_row):
            chunk = sessions[i : i + per_row]
            arts, labels, ages = [], [], []
            for pid, (kind, tty_name, started) in chunk:
                seen = state["first_seen"].get(pid, 0)
                # Sessions already running at startup are served full; new ones pour in.
                fill = min(1.0, (now - seen) / POUR_S) if seen > state["start"] + 1 else 1.0
                arts.append(cup_lines(kind, frame + pid, fill))
                name, color = AGENTS[kind]
                labels.append(f"{color}{name}{RESET} {DIM}{tty_name.replace('ttys', 's')}{RESET}")
                ages.append(
                    f"{DIM}{fmt_dur(now - started)}{RESET}"
                    if fill >= 1
                    else f"{GOLD}pouring…{RESET}"
                )
            for line_i in range(5):
                out.append("  " + "".join(pad(a[line_i], cell) for a in arts))
            out.append("  " + "".join(pad(label, cell) for label in labels))
            out.append("  " + "".join(pad(a, cell) for a in ages))
            out.append("")

    stamps = state["stats"]["lifetime_cups"] % CARD
    card = "".join(f"{GOLD}●{RESET}" if i < stamps else f"{DIM}○{RESET}" for i in range(CARD))
    out.append(
        f"  Loyalty card {card}  {DIM}{stamps}/{CARD}, the next free coffee is on the house{RESET}"
    )
    stats = state["stats"]
    out.append(
        f"  {DIM}On the counter: {len(sessions)}  ·  served this shift: {state['served']}"
        f"  ·  lifetime: {stats['lifetime_cups']}  ·  free coffees: {stats['free_coffees']}{RESET}"
    )
    out.append("")
    if state["toast"] and now < state["toast"][1]:
        out.append(f"  {GOLD}{state['toast'][0]}{RESET}")
    else:
        out.append(f"  {DIM}“{QUIPS[int(now // 8) % len(QUIPS)]}”{RESET}")

    out = out[: rows - 1]
    sys.stdout.write("\033[H" + "\n".join(line + "\033[K" for line in out) + "\033[J")
    sys.stdout.flush()


def update(state):
    live = scan_agents()
    if live is None:
        return
    now = time.time()
    for pid in live.keys() - state["live"].keys():
        state["first_seen"][pid] = now
        if state["initialized"]:
            state["toast"] = (f"New order: {AGENTS[live[pid][0]][0]} on {live[pid][1]} ☕", now + 4)
    for pid in state["live"].keys() - live.keys():
        kind, _, started = state["live"][pid]
        dur = now - started
        state["served"] += 1
        state["longest"] = max(state["longest"], (dur, AGENTS[kind][0]))
        state["stats"]["lifetime_cups"] += 1
        if state["stats"]["lifetime_cups"] % CARD == 0:
            state["stats"]["free_coffees"] += 1
            state["toast"] = ("🎉 Card full! Free coffee earned. Go get a real one.", now + 8)
        else:
            state["toast"] = (f"Order up: {AGENTS[kind][0]} served after {fmt_dur(dur)} ✔", now + 5)
        state["first_seen"].pop(pid, None)
        save_stats(state["stats"])
    state["live"] = live
    state["initialized"] = True


def receipt(state):
    now = time.time()
    w = 34
    line = "-" * w
    rows = [
        ("Mac kept awake", fmt_dur(now - state["start"])),
        ("Cups served", str(state["served"])),
        ("Still brewing", str(len(state["live"]))),
    ]
    if state["longest"][0] > 0:
        rows.append(("Longest pour", f"{fmt_dur(state['longest'][0])} ({state['longest'][1]})"))
    rows.append(("Lifetime cups", str(state["stats"]["lifetime_cups"])))
    print(f"\n  {line}\n  {'CAFFE RECEIPT':^{w}}\n  {line}")
    for k, v in rows:
        print(f"  {k:<{w - len(v) - 1}} {v}")
    print(f"  {line}\n  {'Thanks, come again ☕':^{w}}\n  {line}\n")


def start_caffeinate():
    # -w ties caffeinate to our pid, so it stops even if caffe is killed.
    return subprocess.Popen(["/usr/bin/caffeinate", "-dimsu", "-w", str(os.getpid())])


def main():
    if not sys.stdin.isatty():
        sys.exit("caffe needs an interactive terminal.")
    caf = start_caffeinate()
    state = {
        "start": time.time(),
        "live": {},
        "first_seen": {},
        "served": 0,
        "longest": (0, ""),
        "stats": load_stats(),
        "toast": None,
        "initialized": False,
    }

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sys.stdout.write("\033[?1049h\033[?25l")
    try:
        tty.setcbreak(fd)
        frame, last_poll = 0, 0.0
        while True:
            if time.time() - last_poll >= POLL_S:
                update(state)
                last_poll = time.time()
            render(state, frame)
            frame += 1
            r, _, _ = select.select([sys.stdin], [], [], FRAME_S)
            if r and sys.stdin.read(1).lower() == "q":
                break
            if caf.poll() is not None:
                caf = start_caffeinate()
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        caf.terminate()
        receipt(state)


if __name__ == "__main__":
    main()
