def fika_bun(t):
    """A kanelbulle, or a saffron lussekatt in December."""
    return "lussekatt" if time.localtime(t).tm_mon == 12 else "kanelbulle"


def daypart(t):
    """night (23–05), morning (05–10), fika (14:30–15:00) or day, in local time."""
    lt = time.localtime(t)
    minute = lt.tm_hour * 60 + lt.tm_min
    if lt.tm_hour < 5 or lt.tm_hour >= 23:
        return "night"
    if lt.tm_hour < 10:
        return "morning"
    return "fika" if 14 * 60 + 30 <= minute < 15 * 60 else "day"


def parse_etime(s):
    days, rest = s.split("-", 1) if "-" in s else ("0", s)
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts
    return int(days) * 86400 + h * 3600 + m * 60 + sec


def agent_kind(args):
    for tok in args.split()[:2]:
        name = os.path.basename(tok)
        if name in AGENTS:
            return name
    return None


