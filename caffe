def parse_etime(s):
    days, rest = s.split("-", 1) if "-" in s else ("0", s)
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts
    return int(days) * 86400 + h * 3600 + m * 60 + sec


def agent_kind(args):
    for tok in args.split()[:2]:
        name = os.path.basename(tok)
        if name in AGENTS:
            return name
    return None


UI_APPS = {
    "Visual Studio Code": "vscode",
    "Codex": "codex",
    "ChatGPT": "codex",
    "GitHub Copilot": "copilot",
    "Claude": "claude",
}


def ui_host(pid, processes, names):
    """Find the outer application owning a backend, through its helper processes."""
    host, seen = None, set()
    while pid in processes and pid not in seen:
        seen.add(pid)
        match = re.search(r"/([^/]+)\.app/Contents/MacOS/[^/]+$", names.get(pid, ""))
        if match and match[1] in UI_APPS:
            host = pid, UI_APPS[match[1]]
        pid = int(processes[pid][1])
    return host


def parse_session_timestamp(value):
    """Convert the session database's ISO timestamp to an epoch value."""
    try:
        timestamp = datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if timestamp.tzinfo is None:
            timestamp = timestamp.astimezone()
        return timestamp.timestamp()
    except (OverflowError, OSError, TypeError, ValueError):
        return time.time()


def scan_copilot_sessions():
    """Read running local Copilot session metadata, never conversation history."""
    try:
        uri = COPILOT_SESSION_DB.resolve().as_uri() + "?mode=ro"
        with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
            connection.execute("PRAGMA query_only = ON")
            rows = connection.execute(
                """
                SELECT id, title, created_at
                FROM sessions
                WHERE execution_location = 'local'
                  AND session_type IN ('project', 'agent', 'general_chat')
                  AND is_running = 1
                  AND archived_at IS NULL
                ORDER BY created_at
                """
            )
            sessions = {}
            for raw_id, raw_title, created_at in rows:
                session_id = str(raw_id)
                title = re.sub(r"\s+", " ", str(raw_title or "")).strip()
                title = re.sub(r"[\x00-\x1f\x7f]", "", title)
                if not title:
                    title = f"Session {session_id[:8]}"
                key = f"{COPILOT_SESSION_KIND}:{session_id}"
                sessions[key] = (
                    COPILOT_SESSION_KIND,
                    title,
                    parse_session_timestamp(created_at),
                    0.0,
                    0.0,
                )
            return sessions
    except (OSError, sqlite3.Error):
        # The app's metadata index is optional and its schema is undocumented.
        return None


def scan_agents():
    """CLI sessions by PID, and UI applications by (application PID, app kind)."""
    try:
        out = subprocess.run(
            ["/bin/ps", "-axo", "pid=,ppid=,tty=,%cpu=,rss=,etime=,args="],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
        commands = subprocess.run(
            ["/bin/ps", "-axo", "pid=,comm="],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return agent_sessions(out, commands, time.time())


def agent_sessions(out, commands, now):
    """Classify a process snapshot without counting renderers as agent sessions."""
    names = {
        int(parts[0]): parts[1]
        for parts in (line.split(None, 1) for line in commands.splitlines())
        if len(parts) == 2
    }
    processes = {
        int(cols[0]): cols
        for cols in (line.split(None, 6) for line in out.splitlines())
        if len(cols) == 7
    }
    found, apps = {}, {}
    # UI cups belong to applications, regardless of their underlying agents.
    for pid, cols in processes.items():
        match = re.search(r"/([^/]+)\.app/Contents/MacOS/[^/]+$", names.get(pid, ""))
        if match and match[1] in UI_APPS:
            kind = UI_APPS[match[1]]
            apps[pid, kind] = [kind, f"app:{DRINKS[kind][0]}", now - parse_etime(cols[5]), 0, 0]
    for pid, cols in processes.items():
        try:
            cpu = float(cols[3].replace(",", "."))
        except ValueError:
            cpu = 0.0
        ram_mb = int(cols[4]) / 1024
        host = ui_host(pid, processes, names)
        if host:
            owner, kind = host
            key = owner, kind
            if key not in apps:
                apps[key] = [
                    kind,
                    f"app:{DRINKS[kind][0]}",
                    now - parse_etime(processes[owner][5]),
                    0,
                    0,
                ]
            apps[key][3] += cpu
            apps[key][4] += ram_mb
        kind = agent_kind(cols[6]) or agent_kind(names.get(pid, ""))
        if os.path.basename(names.get(pid, "")) == "copilot-runtime":
            kind = "copilot"
        # CLI sessions in VS Code's terminal still get individual espressos.
        if kind and cols[2] != "??" and (not host or host[1] == "vscode"):
            found[pid] = [kind, int(cols[1]), cols[2], now - parse_etime(cols[5]), cpu, ram_mb]
    # Fold helper processes whose parent is itself an agent session into that session.
    for _kind, ppid, _tty, _started, cpu, ram_mb in list(found.values()):
        if ppid in found:
            found[ppid][4] += cpu
            found[ppid][5] += ram_mb
    sessions = {
        pid: (kind, tty_name, started, cpu, ram_mb)
        for pid, (kind, ppid, tty_name, started, cpu, ram_mb) in found.items()
        if ppid not in found
    }
    sessions.update((key, tuple(value)) for key, value in apps.items())
    return sessions


def fmt_mem(mb):
    """Format resident memory in compact MiB/GiB units."""
    return f"{mb / 1024:.1f}G" if mb >= 1024 else f"{mb:.0f}M"


def app_steam_level(cpu, ram_mb):
    """Map app CPU and resident memory use to the three steam levels."""
    if cpu >= BUSY_CPU or ram_mb >= BUSY_RAM_MB:
        return 2
    if cpu >= WORKING_CPU or ram_mb >= WORKING_RAM_MB:
        return 1
    return 0


def is_working(session):
    kind, source, _, cpu, ram_mb = session
    if kind == COPILOT_SESSION_KIND:
        return True
    return bool(app_steam_level(cpu, ram_mb)) if source.startswith("app:") else cpu >= WORKING_CPU


def fmt_dur(sec):
    sec = int(sec)
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}h {m:02d}m" if h else (f"{m}m {s:02d}s" if m else f"{s}s")


def visible_len(s):
    return len(re.sub(r"\033\[[\d;]*m", "", s))


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


# ---- Drawing. Each sprite is drawn once from anti-aliased shapes and sent to
# the terminal as an image. Shapes are measured in units where a cell is 8 wide
# and 16 tall. Images get 2 pixels per unit, so they stay sharp on Retina.
CW, CH, PX = 8, 16, 2
INK, WHITE, PINK = (28, 26, 30), (255, 255, 255), (236, 150, 165)


def mix(a, b, t):
    t = min(1.0, max(0.0, t))
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


# A shape is (distance, box): distance(x, y) is negative inside the shape and
# box = (x0, y0, x1, y1) bounds it.
def circle(cx, cy, r):
    return (lambda x, y: math.hypot(x - cx, y - cy) - r), (cx - r, cy - r, cx + r, cy + r)


def ellipse(cx, cy, rx, ry):
    m = min(rx, ry)
    return (
        (lambda x, y: (math.hypot((x - cx) / rx, (y - cy) / ry) - 1) * m),
        (cx - rx, cy - ry, cx + rx, cy + ry),
    )


def capsule(ax, ay, bx, by, r):
    dx, dy = bx - ax, by - ay
    length2 = dx * dx + dy * dy or 1e-9

    def dist(x, y):
        t = max(0.0, min(1.0, ((x - ax) * dx + (y - ay) * dy) / length2))
        return math.hypot(x - ax - t * dx, y - ay - t * dy) - r

    return dist, (min(ax, bx) - r, min(ay, by) - r, max(ax, bx) + r, max(ay, by) + r)


def rbox(x0, y0, x1, y1, r):
    cx, cy, hx, hy = (x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2 - r, (y1 - y0) / 2 - r

    def dist(x, y):
        qx, qy = abs(x - cx) - hx, abs(y - cy) - hy
        return math.hypot(max(qx, 0), max(qy, 0)) + min(max(qx, qy), 0) - r

    return dist, (x0, y0, x1, y1)


def poly(*pts):
    """A convex polygon."""
    cx, cy = sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts)
    edges = []
    for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
        nx, ny = by - ay, ax - bx
        n = math.hypot(nx, ny)
        nx, ny = nx / n, ny / n
        if (cx - ax) * nx + (cy - ay) * ny > 0:
            nx, ny = -nx, -ny
        edges.append((ax, ay, nx, ny))
    xs, ys = [p[0] for p in pts], [p[1] for p in pts]
    return (
        (lambda x, y: max((x - ax) * nx + (y - ay) * ny for ax, ay, nx, ny in edges)),
        (min(xs), min(ys), max(xs), max(ys)),
    )


def union(*shapes):
    fns = [f for f, _ in shapes]
    boxes = [b for _, b in shapes]
    box = tuple(f(b[i] for b in boxes) for i, f in enumerate((min, min, max, max)))
    return (lambda x, y: min(f(x, y) for f in fns)), box


def clip(shape, mask):
    (f, box), (g, _) = shape, mask
    return (lambda x, y: max(f(x, y), g(x, y))), box


def grow(shape, d):
    f, (x0, y0, x1, y1) = shape
    return (lambda x, y: f(x, y) - d), (x0 - d, y0 - d, x1 + d, y1 + d)


def path(points, r):
    return union(*(capsule(*a, *b, r) for a, b in zip(points, points[1:])))


class Img:
    """An RGBA sprite `cols` x `rows` cells big, with its shapes zoomed by `k`."""

    def __init__(self, cols, rows, k=1.0):
        self.cols, self.rows, self.k = cols, rows, k
        self.w, self.h = cols * CW * PX, rows * CH * PX
        self.buf = bytearray(self.w * self.h * 4)
        self.moved = None

    def move(self, angle, pivot, shift):
        """Draw what follows turned by `angle` around `pivot`, then shifted."""
        ca, sa, (px, py), (dx, dy) = math.cos(angle), math.sin(angle), pivot, shift

        def back(x, y):  # from the image to where the shape was drawn
            x, y = x - dx - px, y - dy - py
            return ca * x + sa * y + px, -sa * x + ca * y + py

        def there(x, y):
            x, y = x - px, y - py
            return ca * x - sa * y + px + dx, sa * x + ca * y + py + dy

        self.moved = back, there

    def fill(self, shape, color, alpha=1.0):
        """Paint a shape. `color` and `alpha` may also be functions of (x, y)."""
        if self.moved:
            shape, color, alpha = self._moved(shape, color, alpha)
        dist, (x0, y0, x1, y1) = shape
        s, buf, w = PX * self.k, self.buf, self.w
        for py in range(max(0, int(y0 * s) - 1), min(self.h, math.ceil(y1 * s) + 1)):
            y = (py + 0.5) / s
            for px in range(max(0, int(x0 * s) - 1), min(w, math.ceil(x1 * s) + 1)):
                x = (px + 0.5) / s
                a = min(1.0, 0.5 - dist(x, y) * s)
                if a <= 0:
                    continue
                a *= alpha(x, y) if callable(alpha) else alpha
                if a <= 0.004:  # (also keeps a fully faded shape off empty pixels)
                    continue
                rgb = color(x, y) if callable(color) else color
                i = (py * w + px) * 4
                under = buf[i + 3] / 255 * (1 - a)
                total = a + under
                buf[i] = round((rgb[0] * a + buf[i] * under) / total)
                buf[i + 1] = round((rgb[1] * a + buf[i + 1] * under) / total)
                buf[i + 2] = round((rgb[2] * a + buf[i + 2] * under) / total)
                buf[i + 3] = round(total * 255)

    def _moved(self, shape, color, alpha):
        back, there = self.moved
        (dist, (x0, y0, x1, y1)) = shape
        corners = [there(x, y) for x in (x0, x1) for y in (y0, y1)]
        xs, ys = [c[0] for c in corners], [c[1] for c in corners]

        def undo(f):
            return (lambda x, y: f(*back(x, y))) if callable(f) else f

        return (undo(dist), (min(xs), min(ys), max(xs), max(ys))), undo(color), undo(alpha)

    def mirror(self):
        row = self.w * 4
        for y in range(self.h):
            line = self.buf[y * row : (y + 1) * row]
            px = [line[i : i + 4] for i in range(0, row, 4)]
            self.buf[y * row : (y + 1) * row] = b"".join(reversed(px))
        return self


DRINK_RIMS = {"espresso": 24, "latte": 7}
WOBBLE = (0.055, -0.04, 0.025, -0.01, 0.0)


def mug_sprite(glaze, fill, k, style=("espresso", 0), wobble=4):
    """A drink in an agent's colour, with a stable foam pattern."""
    img = Img(math.ceil(6 * k), math.ceil(3 * k), k)
    img.fill(ellipse(21, 46.6, 17, 1.6), INK, 0.35)  # shadow on the counter
    img.move(WOBBLE[wobble], (21, 46), (0, 0))
    draw_drink(img, glaze, fill, style)
    return img


KNOCK_FRAMES, KNOCK_S = 12, 1.0


def knock_sprite(glaze, frame, k, style=("espresso", 0)):
    """A mug the cat swatted: it tips over and drops behind the bar. The picture
    is bigger than a mug (4 cols to the left, 1 row up) and ends at the counter,
    so the falling mug disappears behind it."""
    img = Img(math.ceil(10 * k), math.ceil(4 * k), k)
    t = frame / KNOCK_FRAMES
    angle = 0.12 * math.sin(t / 0.2 * math.pi) if t < 0.2 else -(t - 0.2) * 2
    left, up = round(4 * k) * CW / k - 12 * t, (img.rows - math.ceil(3 * k)) * CH / k
    img.move(angle, (6, 46.5), (left, up + max(0.0, t - 0.25) ** 2 * 200))
    draw_drink(img, glaze, 0, style)
    return img


def draw_drink(img, glaze, fill, style):
    drink, art = style
    if drink == "latte":
        draw_latte(img, glaze, fill)
    else:
        draw_espresso(img, glaze, fill)
    if fill == 2:
        rim = DRINK_RIMS[drink]
        foam = (250, 230, 198)
        if art == 0:
            img.fill(ellipse(19.5, rim + 0.2, 4.2, 1.1), foam)
        elif art == 1:
            for x in (17, 21, 25):
                img.fill(ellipse(x, rim + 0.2, 1.4, 0.8), foam)
        else:
            img.fill(path(((16, rim), (21, rim + 1), (26, rim)), 0.6), foam)


def draw_espresso(img, glaze, fill):
    shade, light = mix(glaze, INK, 0.35), mix(glaze, WHITE, 0.4)

    def glazed(x, _y):
        t = (x - 6) / 30
        return mix(light, glaze, t * 4) if t < 0.25 else mix(glaze, shade, (t - 0.45) * 2)

    handle = (
        (lambda x, y: max(abs(math.hypot(x - 32, y - 33) - 5) - 1.8, 32 - x)),
        (32, 26, 39, 40),
    )
    img.fill(ellipse(21, 45, 18, 2.2), shade)
    img.fill(ellipse(21, 44, 17, 1.8), light)
    img.fill(handle, shade)
    img.fill(union(rbox(9, 24, 33, 43, 5), rbox(9, 24, 33, 32, 0)), glazed)
    img.fill(ellipse(21, 24, 12, 3.1), light)
    inside = ellipse(21, 24.3, 10, 2.2)
    if fill == 0:
        img.fill(inside, mix(glaze, INK, 0.7))
    else:
        img.fill(inside, (88, 54, 34))
    if fill == 2:
        img.fill(ellipse(21, 24.5, 8.8, 1.7), (196, 148, 100))


def draw_latte(img, glaze, fill):
    """A tall, tinted glass with visible coffee, milk and foam layers."""
    glass = poly((8, 7), (34, 7), (31, 45), (11, 45))
    img.fill(glass, mix(glaze, WHITE, 0.65), 0.85)
    inside = poly((10, 9), (32, 9), (29.5, 42), (12.5, 42))
    img.fill(inside, mix(glaze, INK, 0.65))
    if fill:
        top = 10 if fill == 2 else 27
        img.fill(clip(inside, rbox(0, top, 48, 43, 0)), (218, 181, 137))
        img.fill(clip(inside, rbox(0, max(top, 29), 48, 43, 0)), (244, 222, 188))
        img.fill(clip(inside, rbox(0, top, 48, top + 5, 0)), (116, 73, 47))
    img.fill(ellipse(21, 7, 13, 3), mix(glaze, WHITE, 0.8))
    img.fill(ellipse(21, 7.2, 10.5, 2), (236, 209, 170) if fill == 2 else mix(glaze, INK, 0.5))
    # A broad coloured sleeve keeps the agent recognisable at terminal size.
    sleeve = clip(glass, rbox(0, 28, 48, 39, 0))
    img.fill(sleeve, glaze)
    img.fill(clip(sleeve, rbox(0, 28, 14, 39, 0)), mix(glaze, WHITE, 0.3))
    img.fill(ellipse(21, 33.5, 2, 2), WHITE, 0.85)
    img.fill(capsule(12, 13, 14, 37, 0.7), WHITE, 0.5)
    img.fill(capsule(31, 13, 29, 38, 0.5), WHITE, 0.25)
    img.fill(ellipse(21, 44, 9.5, 1.4), glaze)


STEAM_FRAMES = 12


def steam_sprite(level, frame, rows, drink="espresso"):
    """Wisps rising from a cup: one for a calm agent, three for a busy one."""
    img = Img(6, rows)
    rim = (rows - 1) * CH + DRINK_RIMS[drink] % CH
    phase = frame / STEAM_FRAMES * 2 * math.pi
    length = (rim - 2) * (0.5, 0.8, 1.0)[level]
    for j, base in enumerate(((21,), (17.5, 24.5), (15, 21, 27))[level]):

        def dist(x, y, base=base, off=j * 2.1):
            if not rim - length < y < rim - 1:
                return 9.0
            h = rim - y
            centre = base + math.sin(h * 0.16 - phase + off) * (0.6 + h * 0.06)
            return abs(x - centre) - (1.1 + h * 0.03)

        def alpha(_x, y, off=j * 2.1):
            h = (rim - y) / length
            fade = min(1.0, h * 5) * max(0.0, 1 - h) ** 0.8
            return 0.55 * fade * (0.7 + 0.3 * math.sin((rim - y) * 0.3 - 2 * phase + off))

        img.fill((dist, (base - 9, rim - length - 1, base + 9, rim)), (240, 238, 242), alpha)
    return img


def pour_sprite(frame, rows, drink="espresso"):
    """Coffee pouring into the mug below."""
    img = Img(6, rows)
    rim = (rows - 1) * CH + DRINK_RIMS[drink] % CH

    def stream(width, shift=0.0):
        def dist(x, y):
            return abs(x - 21 - shift - 0.5 * math.sin(y * 0.5 + frame * 1.6)) - width

        return clip((dist, (17, 0, 25, rim)), rbox(0, 0, 48, rim, 0))

    img.fill(stream(1.4), (104, 62, 38))
    img.fill(stream(0.4, -0.5), (170, 116, 76))
    img.fill(ellipse(21, rim + 0.4, 3.4 + frame % 2, 1.1), (126, 80, 50))
    return img


def counter_sprite(cols):
    """The wooden bar top."""
    img = Img(cols, 1)

    def wood(x, y):
        grain = math.sin(x * 0.11 + 2.5 * math.sin(x * 0.013 + y * 0.35))
        return mix(
            mix((164, 110, 66), (108, 68, 40), (y - 3) / 13), (86, 52, 30), 0.1 + 0.1 * grain
        )

    img.fill(rbox(0, 3, cols * CW, 16, 0), wood)
    img.fill(rbox(0, 1, cols * CW, 4.5, 1.2), (204, 158, 110))  # the lit top edge
    return img


# ---- The barista cat, drawn from simple shapes. Poses face right (walk, nap)
# or the viewer (sit, groom, yawn). Each coat: name, fur, markings, light fur,
