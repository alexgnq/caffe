class Gallery:
    """Sends each sprite to the terminal once (kitty graphics protocol) and keeps
    the pictures on screen in sync with what render() asks for."""

    BASE_ID = 0xCAFE00

    def __init__(self):
        self.images, self.uploads, self.sent, self.objects, self.shown = {}, {}, set(), {}, {}

    def image(self, key, out):
        if key not in self.images:
            img = SPRITES[key[0]](*key[1:])
            iid = self.BASE_ID + len(self.images)
            if isinstance(img, Png):  # the terminal decodes it
                payload, fmt = img.data, "f=100"
            else:
                payload, fmt = zlib.compress(bytes(img.buf)), f"f=32,o=z,s={img.w},v={img.h}"
            data = base64.standard_b64encode(payload).decode()
            chunks = [data[i : i + 4096] for i in range(0, len(data), 4096)] or [""]
            self.uploads[key] = "".join(
                f"\033_G{f'a=t,q=2,{fmt},i={iid},' if n == 0 else ''}"
                f"m={int(n < len(chunks) - 1)};{chunk}\033\\"
                for n, chunk in enumerate(chunks)
            )
            self.images[key] = (iid, img.cols, img.rows)
        if key not in self.sent:
            out.append(self.uploads[key])
            self.sent.add(key)
        return self.images[key]

    def reset(self):
        """Start over after a resize: terminals may drop pictures, image data included."""
        self.sent, self.shown = set(), {}
        return "\033_Ga=d,d=A,q=2\033\\"

    def sync(self, want):
        """want: {object: (sprite key, col, row, z)}. Returns the escape codes."""
        out, shown = [], {}
        for obj, (key, col, row, z) in want.items():
            pid = self.objects.setdefault(obj, len(self.objects) + 1)
            iid, cols, rows = self.image(key, out)
            spot = (iid, col, row, z)
            old = self.shown.get(pid)
            if old != spot:
                out.append(
                    f"\033[{row + 1};{max(0, col) + 1}H"
                    f"\033_Ga=p,i={iid},p={pid},c={cols},r={rows},z={z},C=1,q=2\033\\"
                )
                if old and old[0] != iid:
                    out.append(f"\033_Ga=d,d=i,i={old[0]},p={pid},q=2\033\\")
            shown[pid] = spot
        for pid in self.shown.keys() - shown.keys():
            out.append(f"\033_Ga=d,d=i,i={self.shown[pid][0]},p={pid},q=2\033\\")
        self.shown = shown
        return "".join(out)


class Cat:
    """The barista cat. It lives on the strip of table below the cards: walks,
    grooms, yawns, and naps when the bar is quiet. It goes up to the cards to
    sniff new orders, check on ready ones and knock finished cups off the
    table. `x` is the column of its middle, `y` how many rows above the strip
    it is."""

    MIN_X = 4  # how close its middle gets to the edges

    def __init__(self, now, home, key="cat"):
        self.key = key  # its pictures' names, so a visiting cat can share the bar
        self.coat = random.randrange(len(COATS))
        self.name = random.choice(CAT_NAMES)
        self.x = self.goal = float(home)
        self.y = self.goal_y = 0.0
        self.dir, self.last, self.speed = 1, now, 7.0  # cols/s
        self.plan, self.mode, self.until = [], "nap", now + 4
        self.pets, self.petted_at, self.target = 0, 0.0, None
        self.fed, self.chasing, self.sleepy = [], False, False

    @property
    def title(self):
        return f"{self.name} the {COATS[self.coat][0]} cat"

    def go(self, x, y=0):
        self.goal, self.goal_y, self.mode, self.plan, self.chasing = (
            float(x),
            float(y),
            "walk",
            [],
            False,
        )

    def moving(self):
        return self.mode in ("walk", *BUSY_MODES)

    def free(self):
        """Not busy with a cup, a mouse, a treat or a pet."""
        return self.target is None and not self.chasing and self.mode not in BUSY_MODES

    def do(self, mode, now, dur, *plan):
        """Switch to `mode` for `dur` seconds, then follow the `plan`."""
        self.mode, self.until, self.plan = mode, now + dur, list(plan)

    def slap(self, now):
        # Among the cards, it doesn't linger: the others close up the gap.
        self.do("slap", now, 1.6, ("sit", 0.6 if self.y else 2.5))

    def hiss(self, now):
        self.do("hiss", now, 1.5, ("sit", 2))

    def pet(self, now):
        """Stop whatever it's doing and purr for a bit."""
        self.pets += 1
        self.target, self.chasing = None, False  # it got distracted on its way to a cup
        self.petted_at = now
        self.do("purr", now, 3, ("sit", 1.5))

    def feed(self, now):
        """Eat a treat, unless it's had plenty lately. Returns whether it ate."""
        if sum(now - t < 600 for t in self.fed) >= TREATS_PER_10_MIN:
            return False
        self.fed.append(now)
        self.target, self.chasing = None, False
        self.do("eat", now, 2.4, ("sit", 1.5))
        return True

    def pampered(self, now):
        """Petted or fed in the last 10 minutes: in a good mood."""
        return bool(self.pets or self.fed) and now - max([self.petted_at, *self.fed]) < 600

    def _arrive(self, now, calm, free_x, home, *, waiting=False):
        u = random.uniform
        if self.y and self.target is None:  # nothing to do up among the cards: back down
            self.go(self.x)
            return
        if home is not None:
            self.plan = [("nap", u(20, 40)), ("sit", 1.5), ("groom", u(2, 4))]
        elif self.target is not None:
            self.plan = [("sit", u(1.5, 2.5))]  # a sniff at the cup
        elif waiting:  # an order is ready: it sits up and looks at you
            self.plan = [("sit", u(4, 8)), ("groom", u(1, 2))]
        elif calm and self.x >= free_x and random.random() < (0.8 if self.sleepy else 0.5):
            self.plan = [("nap", u(8, 16)), ("yawn", 1.2)]
        else:
            self.plan = random.choice(
                [
                    [("sit", u(2, 5))],
                    [("groom", u(2, 3)), ("sit", u(1, 3))],
                    [("sit", u(2, 4)), ("yawn", 1.2)],
                ]
            )
        self._next(now)

    def _next(self, now):
        self.mode, dur = self.plan.pop(0)
        self.until = now + dur

    def step(self, now, lane_w, calm, free_x, *, home=None, waiting=False):  # noqa: PLR0913
        dt = min(0.5, max(0.0, now - self.last))  # the clock may jump, even backwards
        self.last = now
        max_x = float(max(self.MIN_X, lane_w - self.MIN_X))
        if home is not None and (abs(self.goal - home) > 0.5 or self.goal_y):
            self.go(home)
        if self.mode == "walk":
            if self._walk(dt, max_x):
                self._arrive(now, calm, free_x, home, waiting=waiting)
        elif now >= self.until:
            if self.plan:
                self._next(now)
            elif home is not None or (waiting and not self.y):
                self._arrive(now, calm, free_x, home, waiting=waiting)
            elif free_x <= max_x and random.random() < 0.6:
                self.go(random.uniform(free_x, max_x))
            else:
                self.go(random.uniform(self.MIN_X, max_x))
        self.x = min(max(self.x, self.MIN_X), max_x)

    def _walk(self, dt, max_x):
        """A step towards its goal: along the table, and up or down a row at a
        time. Returns whether it got there."""
        goal = min(max(self.goal, self.MIN_X), max_x)
        speed = CHASE_SPEED if self.chasing else self.speed
        if self.target is not None:  # off to see to a cup: it trots
            speed = max(speed, ERRAND_SPEED)
        climb = speed / 2 * dt  # rows are twice as tall as columns are wide
        if abs(goal - self.x) <= speed * dt and abs(self.goal_y - self.y) <= climb:
            self.x, self.y = goal, self.goal_y
            return True
        if abs(goal - self.x) > speed * dt:
            self.dir = 1 if goal > self.x else -1
            self.x += self.dir * speed * dt
        else:
            self.x = goal
        if abs(self.goal_y - self.y) > climb:
            self.y += climb if self.goal_y > self.y else -climb
        else:
            self.y = self.goal_y
        return False

    def pose(self, now):
        """The sprite pose for this moment, and whether to mirror it."""
        mirrored = self.dir < 0
        chew = (("yawn",) if int(now * 4) % 2 else ("sit", 0, True), False)
        poses = {
            "walk": (("walk", int(now * 8) % 4), mirrored),
            "nap": (("nap", int(now / 1.2) % 2), mirrored),
            "groom": (("groom", 1 + int(now * 3) % 2), False),
            "yawn": (("yawn",), False),
            "purr": (("sit", int(now * 4) % 3, True), False),
            "eat": chew,
            "nibble": chew,
            "hiss": (("hiss",), False),
            "slap": (
                ("slap", 1 if self.until - now > 1.3 else (2 if self.until - now > 1 else 3)),
                False,
            ),
        }
        return poses.get(self.mode, (("sit", int(now * 1.5) % 3, now % 5 < 0.25), False))

    def place(self, frame, art, top, k, now):
        """Put the cat's picture in `frame`, and its zZ in the strip's text `art` rows."""
        pose, flip = self.pose(now)
        cols, rows, cat_rows = math.ceil(7 * k), len(art), math.ceil(3 * k)
        left, up = round(self.x) - cols // 2, round(self.y)
        row = top + rows - cat_rows + up
        frame.pics[self.key] = (("cat", self.coat, pose, flip, k), left, row, 3)
        if self.mode == "purr":
            beat = int((now - self.petted_at) / 0.1) % HEART_FRAMES
            frame.pics[(self.key, "hearts")] = (("hearts", beat), left + 2, max(0, row - 2), 4)
        if self.mode == "eat":
            bites = min(3, int((now - self.fed[-1]) / 0.6))
            frame.pics[(self.key, "treat")] = (("treat", bites, k), left, row + cat_rows - 1, 3)
        if pose[0] == "nap" and not up:
            for i, ch in enumerate("zZ"):
                r = rows - cat_rows - (int(now * 1.5) + i) % 2
                col = left + (cols - 2 if not flip else 1) + i
                if 0 <= r < rows and 0 <= col < len(art[r]):
                    art[r][col] = f"{DIM}{ch}{RESET}"


# ---- The table. Each session is a card: its cup, and three lines beside it
# (name and project, status, a note). The cat lives on a strip of table below.
# card size: (card width, rows per card with the gap below, cup zoom, text lines)
CARDS = {"full": (31, 4, 1.0, 3), "compact": (23, 3, 2 / 3, 2), "text": (26, 4, None, 3)}
TOP_ROWS, LANE_ROWS = 3, 3  # the header, news and a gap; the cat's strip of table
MAX_WIDTH = 2 + 4 * CARDS["full"][0]
HOME_X = 13
COLD = c256(67)


def pick_cards(count, width, rows, gfx):
    """The roomiest card size whose cards all fit on screen, and how many fit per row."""
    for size in ("full", "compact") if gfx else ("text",):
        card_w, card_h, *_ = CARDS[size]
        per_row = max(1, (width - 2) // card_w)
        if -(-count // per_row) * card_h <= rows:
            break
    return size, per_row


def trim(text, width):
    """Plain text cut to fit `width` columns, with an ellipsis if it was cut."""
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def card_order(state, now):
    """Ready orders first, then the others in the order they arrived. Finished
    cups keep their place until the cat clears them."""
    started = {p: s[2] for p, s in state["live"].items() if not is_app(s)}
    started.update(
        (p, cup[3])
        for p, cup in state["leaving"].items()
        if not is_app(cup) and not gone(state, p, now)
    )

    def key(pid):
        ready = pid in state["live"] and session_state(state, pid, now)[0] == "ready"
        return not ready, started[pid]

    return sorted(started, key=key)


def cup_look(state, pid, now, k):
    """The sprite key for a card's cup at this moment."""
    if pid in state["leaving"]:
        kind, _, ended, _ = state["leaving"][pid]
        knocked = state["knocked"].get(pid, now + 1)
        if knocked <= now:
            frame = min(KNOCK_FRAMES - 1, int((now - knocked) / KNOCK_S * KNOCK_FRAMES))
            return ("knock", SERVED_GLAZE, frame, k)
        return ("cup", SERVED_GLAZE, "drain", min(2, int((now - ended) / DRAIN_S * 3)), k)
    kind, _, _, cpu, _ = state["live"][pid]
    glaze = DRINKS["copilot" if kind == COPILOT_SESSION_KIND else kind][2]
    seen = state["first_seen"].get(pid, 0)
    # Sessions already running at startup are served full; new ones pour in.
    if kind != COPILOT_SESSION_KIND and seen > state["start"] + 1 and now - seen < POUR_S:
        return ("cup", glaze, "pour", int((now - seen) / POUR_S * POUR_FRAMES), k)
    word = session_state(state, pid, now)[0]
    if word == "brewing":  # stirred faster when the agent works harder
        frame = int(now / (0.075 if cpu >= BUSY_CPU else 0.15)) % STIR_FRAMES
        return ("cup", glaze, "brewing", frame, k)
    return ("cup", glaze, word, 0, k)


def card_lines(state, pid, now, width):
    """A card's three lines: name and project, status, and a note."""
    leaving = pid in state["leaving"]
    cup = state["leaving"][pid] if leaving else state["live"][pid]
    kind, source = cup[:2]
    style_kind = "copilot" if kind == COPILOT_SESSION_KIND else kind
    name, color, _ = DRINKS[style_kind]
    if kind == COPILOT_SESSION_KIND:
        name, where = "Agent", source
    else:
        where = state.get("projects", {}).get(pid) or source.replace("ttys", "s")
    name = trim(name, width)
    title = f"{color}{BOLD}{name}{RESET}"
    if width - len(name) > 2:
        title += f" {DIM}{trim(where, width - len(name) - 1)}{RESET}"
    if leaving:
        ended, started = cup[2], cup[3]
        return [title, f"{GOLD}✔ served{RESET} {DIM}{fmt_since(ended - started)}{RESET}", ""]
    seen = state["first_seen"].get(pid, 0)
    if kind != COPILOT_SESSION_KIND and seen > state["start"] + 1 and now - seen < POUR_S:
        return [title, f"{GOLD}pouring…{RESET}", f"{DIM}new order{RESET}"]
    word, since = session_state(state, pid, now)
    took = fmt_since(now - since)
    status = {
        "brewing": f"brewing {DIM}{took}{RESET}",
        "ready": f"{GOLD}{BOLD}ready{RESET} {DIM}{took}{RESET}",
        "idle": f"{DIM}idle {took}{RESET}",
        "cold": f"{COLD}cold{RESET} {DIM}{took}{RESET}",
    }[word]
    if kind == COPILOT_SESSION_KIND:
        note = f"{DIM}Copilot app{RESET}"
    elif word == "ready":
        note = f"{GOLD}waiting for you{RESET}"
    elif word == "brewing":
        note = f"{DIM}{cup[3]:.0f}% cpu{RESET}"
    else:
        note = f"{DIM}quiet since {time.strftime('%H:%M', time.localtime(since))}{RESET}"
    return [title, status, note]


def runs(cells):
    """One line from (column, text) pieces."""
    out, at = "", 0
    for col, text in sorted(cells, key=lambda cell: cell[0]):
        out += " " * max(0, col - at) + text
        at = max(at, col) + visible_len(text)
    return out


class Frame:
    """One screen being built: text lines, and the pictures to show on them."""

    def __init__(self, width, gfx):
        self.width, self.gfx, self.out, self.pics = width, gfx, [], {}

    def art(self, rows):
        return [[" "] * self.width for _ in range(rows)]

    def add(self, art):
        self.out += ["".join(row).rstrip() for row in art]


def cat_visit(state, now):
    """When the cat reaches a finished cup, it swats it off the table. At a
    ready order that went cold, it helps itself to the biscuit."""
    cat = state["cat"]
    if cat.target is None or cat.mode == "walk":
        return
    pid = cat.target
    if pid in state["leaving"] and pid not in state["knocked"]:
        cat.slap(now)
        state["knocked"][pid] = now + 0.3  # the paw lands a moment after the swing starts
        state["broken"] += 1
        who = DRINKS[state["leaving"][pid][0]][0]
        state["toast"] = (f"{cat.name} knocked {who}'s cup off the table.", now + 4)
    elif pid not in state["knocked"]:
        cat.target = None
        if pid in state.get("biscuits", ()):
            state["biscuits"].discard(pid)
            cat.do("nibble", now, 1.6, ("sit", 0.8))
            who = DRINKS[state["live"][pid][0]][0] if pid in state["live"] else "a"
            state["toast"] = (
                f"{cat.name} ate the biscuit off {who}'s saucer. It went cold.",
                now + 4,
            )


def bar_life(state, now, frame, art, *, top, k, free_x, home=None):  # noqa: PLR0913
    """What goes on around the barista: mice, visiting cats and fika buns.
    With a `home`, the bar is empty and the barista sleeps through mice."""
    cat, lane = state["cat"], frame.width
    lane_ends = Cat.MIN_X, max(Cat.MIN_X, lane - Cat.MIN_X)
    due = state.setdefault("due", set())
    on_table = cat.free() and not cat.y  # not off checking on a card
    if "mouse" in due and "guest" not in state and on_table:
        due.discard("mouse")
        side = 1 if cat.x < lane / 2 else -1
        x, speed = cat.x + side * random.uniform(6, 10), random.uniform(10, 20)
        state["mouse"] = {"x": x, "dir": side, "speed": speed, "last": now}
        cat.chasing = home is None and cat.mode != "nap"  # an empty bar's cat stays home
        quip = "gives chase" if cat.chasing else "just watches"
        quip = "sleeps right through it" if cat.mode == "nap" else quip
        state["toast"] = (f"A mouse! {cat.name} {quip}.", now + 3)
    if "mouse" in state:
        run_mouse(state, now, frame, (top + len(art) - 1, k), lane_ends)
    if "guest" in due and "mouse" not in state and on_table and lane >= 40:
        due.discard("guest")
        guest = Cat(now, lane_ends[0] if cat.x > lane / 2 else lane_ends[1], key="guest")
        guest.coat = random.choice([c for c in range(len(COATS)) if c != cat.coat])
        guest.name = random.choice([n for n in CAT_NAMES if n != cat.name])
        guest.mode, guest.speed = "walk", 6.0
        state["guest"] = {"cat": guest, "phase": "enter"}
        state["toast"] = (f"{guest.title} wanders in.", now + 4)
    if "guest" in state:
        run_guest(state, now, lane_ends)
        if "guest" in state:
            state["guest"]["cat"].place(frame, art, top, k, now)
    bites = state.get("bun_bites", 0)
    if daypart(now) == "fika" and free_x <= lane - 8 and bites < BUN_BITES:
        bun = fika_bun(now)
        if home is None:
            nibble(state, now, bun, lane - 12)  # just left of the plate
        frame.pics["bun"] = (("bun", bun, bites), lane - 8, top, 2)


def nibble(state, now, bun, spot):
    """Now and then at fika, the cat walks over to the bun at the end of the
    table and takes a bite."""
    cat, due = state["cat"], state["due"]
    if "nibble" in due and "mouse" not in state and "guest" not in state and cat.free():
        due.discard("nibble")
        cat.go(spot)
        state["snack"] = True
    elif state.get("snack") and cat.mode != "walk":
        del state["snack"]
        if abs(cat.x - spot) < 1 and cat.free():  # it got there without being distracted
            cat.do("nibble", now, 2.4, ("sit", 1.5))
            state["bun_bites"] = bites = state.get("bun_bites", 0) + 1
            done = f"{cat.name} finished the {bun}." if bites >= BUN_BITES else ""
            state["toast"] = (done or f"{cat.name} takes a bite of the {bun}.", now + 3)


def run_mouse(state, now, frame, spot, lane_ends):
    """The mouse dashes for the edge of the table. The cat runs at CHASE_SPEED,
    so it catches slower mice; faster ones get away."""
    (row, k), cat, mouse = spot, state["cat"], state["mouse"]
    mouse["x"] += mouse["dir"] * mouse["speed"] * min(0.5, now - mouse["last"])
    mouse["last"] = now
    if cat.chasing and abs(cat.x - mouse["x"]) < 2.5:
        del state["mouse"]
        state["mice"] = state.get("mice", 0) + 1
        cat.chasing = False
        cat.do("sit", now, 2, ("groom", 2.5))
        state["toast"] = (f"{cat.name} caught the mouse, then let it go.", now + 4)
    elif not lane_ends[0] <= mouse["x"] <= lane_ends[1]:
        del state["mouse"]
        if cat.chasing:
            cat.chasing = False
            cat.do("sit", now, 1.5, ("yawn", 1.2))
            state["toast"] = (f"The mouse got away. {cat.name} pretends not to care.", now + 4)
    else:
        if cat.chasing:
            cat.goal, cat.goal_y, cat.mode, cat.plan = mouse["x"], 0.0, "walk", []
        left = round(mouse["x"]) - math.ceil(3 * k) // 2
        frame.pics["mouse"] = (("mouse", int(now * 10) % 2, mouse["dir"] < 0, k), left, row, 1)


def run_guest(state, now, lane_ends):
    """A stray walks up to the barista. A cat in a good mood shares the table
    for a while; a grumpy one hisses it out."""
    cat, visit = state["cat"], state["guest"]
    guest = visit["cat"]
    dt, guest.last = min(0.5, now - guest.last), now
    if visit["phase"] == "enter":
        guest.dir = 1 if cat.x > guest.x else -1
        if abs(cat.x - guest.x) - 9 > guest.speed * dt:
            guest.x += guest.dir * guest.speed * dt
            return
        state["visitors"] = state.get("visitors", 0) + 1
        if random.random() < (0.8 if cat.pampered(now) else 0.4):
            visit.update(phase="stay", leave_at=now + random.uniform(20, 40))
            guest.do("purr", now, 3)
            if cat.free():
                cat.do("purr", now, 3, ("sit", 6))  # purring, though not petted
            state["toast"] = (f"{guest.name} and {cat.name} share the table. ♥", now + 4)
        else:
            visit["phase"], guest.mode, guest.speed, guest.dir = "leave", "walk", 18.0, -guest.dir
            if cat.free():
                cat.hiss(now)
                state["toast"] = (f"{cat.name} hisses. {guest.name} bolts!", now + 4)
            else:
                state["toast"] = (f"{guest.name} thinks better of it.", now + 4)
    elif visit["phase"] == "stay":
        if guest.mode == "purr" and now >= guest.until:
            guest.mode = "sit"
        if now >= visit["leave_at"]:
            visit["phase"], guest.mode = "leave", "walk"
            guest.dir = -1 if guest.x < cat.x else 1
            state["toast"] = (f"{guest.name} heads home.", now + 3)
    else:
        guest.x += guest.dir * guest.speed * dt
        if not lane_ends[0] <= guest.x <= lane_ends[1]:
            del state["guest"]


def render_cards(state, now, frame, room_rows):
    """The grid of cards. Returns where each visible card is, as {pid: (col,
    row, text col)}."""
    pids = card_order(state, now)
    if not pids:
        render_empty(state, now, frame)
        state["hidden"] = set()
        return {}
    size, per_row = pick_cards(len(pids), frame.width, room_rows, frame.gfx)
    card_w, card_h, k, n_lines = CARDS[size]
    room = max(1, room_rows // card_h) * per_row
    visible = pids[:room]
    state["hidden"] = set(pids[room:])
    text_at = 0 if k is None else math.ceil(6 * k) + (2 if k == 1 else 1)
    top = len(frame.out)
    rows = [[] for _ in range(-(-len(visible) // per_row) * card_h)]
    spots = {}
    for i, pid in enumerate(visible):
        x, y = 2 + (i % per_row) * card_w, (i // per_row) * card_h
        spots[pid] = (x, top + y, x + text_at)
        if frame.gfx:
            look = cup_look(state, pid, now, k)
            left = x - round(4 * k) if look[0] == "knock" else x
            frame.pics[("cup", pid)] = (look, left, top + y, 2)
        for j, line in enumerate(card_lines(state, pid, now, card_w - text_at - 1)[:n_lines]):
            rows[y + j].append((x + text_at, line))
    frame.out += [runs(cells).rstrip() for cells in rows]
    return spots


def render_empty(state, now, frame):
    """No orders: a clean cup, waiting."""
    top = len(frame.out)
    if frame.gfx:
        frame.pics["idle"] = (("cup", SERVED_GLAZE, "empty", 0, 1.0), 2, top, 2)
    quip = random.Random(int(now // 10)).choice(IDLE_QUIPS)
    at = 10 if frame.gfx else 2
    frame.out += [
        " " * at + f"{BOLD}No orders yet{RESET}",
        " " * at + f"{DIM}{quip}{RESET}",
        "",
        "",
    ]


def footer(state, frame):
    """A line below the cards: how many didn't fit, and the open apps, each
    with its icon."""
    row, line = len(frame.out), "  "
    if state.get("hidden"):
        more = len(state["hidden"])
        line += f"{DIM}+{more} more order{'s' * (more > 1)}{RESET}   "
    apps = sorted(
        ((key, s) for key, s in state["live"].items() if is_app(s)), key=lambda app: app[1][2]
    )
    if apps:
        line += f"{DIM}apps{RESET}"
    for key, (kind, _, _, cpu, ram_mb) in apps:
        line += "  "
        if frame.gfx:
            icon = ("icon", key[0], kind, state.get("png", True))
            frame.pics[("icon", key)] = (icon, visible_len(line), row, 2)
            line += "   "
        name, color, _ = DRINKS[kind]
        line += f"{color}{name}{RESET} {DIM}{cpu:.0f}% · {fmt_mem(ram_mb)}{RESET} "
    frame.out.append(line.rstrip())


def aim_cat(state, now, spots, lane_top):
    """Send the cat up to a finished cup to knock it off, or to a card it wants
    to check on."""
    cat = state["cat"]
    # When the cards reflow, the strip moves. A cat on it moves along; one up
    # among the cards stays where it is on screen, though never above them.
    if cat.y:
        cat.y -= lane_top - state.get("lane_top", lane_top)
        cat.y = min(0.0, max(cat.y, float(TOP_ROWS - lane_top)))
    state["lane_top"] = lane_top
    visit = state.pop("visit", None)
    if cat.target not in spots:
        cat.target = None
    if cat.mode in BUSY_MODES:
        return
    pending = [p for p in spots if p in state["leaving"] and p not in state["knocked"]]
    target = cat.target if cat.target in pending else next(iter(pending), visit)
    if target in spots:
        _, row, text_at = spots[target]
        goal = (text_at + 3, row - lane_top)  # beside the cup, over the card's words
        if cat.target != target or (cat.goal, cat.goal_y) != goal:
            cat.go(*goal)
        cat.target = target


def render_lane(state, now, frame, home=None):
    """The strip of table below the cards, where the cat lives."""
    cat = state["cat"]
    top, art = len(frame.out), frame.art(LANE_ROWS)
    words = {session_state(state, p, now)[0] for p in brewable(state)}
    bar_life(state, now, frame, art, top=top, k=1.0, free_x=Cat.MIN_X, home=home)
    calm, waiting = "brewing" not in words, "ready" in words
    cat.step(now, frame.width, calm, Cat.MIN_X, home=home, waiting=waiting)
    cat_visit(state, now)
    cat.place(frame, art, top, 1.0, now)
    frame.add(art)


def gone(state, pid, now):
    """Whether a finished cup has left the table. With graphics, the cat swats
    every cup it can reach; the rest leave on their own."""
    if pid in state["knocked"]:
        return now > state["knocked"][pid] + KNOCK_S
    waits_for_cat = state["gfx"] and pid not in state.get("hidden", ())
    return not waits_for_cat and now > state["leaving"][pid][2] + SERVED_S


def summary(state, now):
    """The tally in colour, for the header."""
    words = {
        "ready": f"{GOLD}{BOLD}{{}} ready{RESET}",
        "brewing": "{} brewing",
        "idle": f"{DIM}{{}} idle{RESET}",
        "served": f"{GOLD}{{}} served{RESET}",
    }
    counts = tally_counts(state, now)
    return f"{DIM} · {RESET}".join(words[w].format(n) for w, n in counts.items() if n)


def header(state, now, width):
    """The title line: how long the Mac's been awake on the left, the tally and
    the longest key hint that fits on the right."""
    awake = (
        f"{BOLD}☕ caffe{RESET}  {DIM}Mac awake for{RESET} {BOLD}{fmt_dur(now - state['start'])}"
    )
    battery = state.get("battery")
    if battery and battery[0] and battery[1] is not None:
        awake += f"{RESET}  {GOLD if state.get('saver') else DIM}battery {battery[1]}%"
    awake += RESET
    name, tally_line = state["cat"].name, summary(state, now)
    hints = (f"p to pet {name} · f to feed · q to close", "p pet · f feed · q quit")
    for extras in [(tally_line, f"{DIM}{hint}{RESET}") for hint in hints] + [(tally_line,), ()]:
        right = "   ".join(extra for extra in extras if extra)
        # -2: the cup emoji takes two cells, and the last column stays free
        gap = width - 2 - visible_len(awake) - visible_len(right)
        if not right or gap >= 3:
            return awake + " " * gap + right if right else awake
    return awake


def render(state, now, size=None):
    """The text lines for this moment, and the pictures to show on top of them.
    `size` is (columns, rows), by default the terminal's."""
    cols, term_rows = size or shutil.get_terminal_size((80, 24))
    frame = Frame(min(cols, MAX_WIDTH), state["gfx"])
    if state["toast"] and now < state["toast"][1]:
        news = f"  {GOLD}{state['toast'][0]}{RESET}"
    else:
        quips = DAY_QUIPS.get(daypart(now), QUIPS)
        news = f"  {DIM}“{quips[int(now // 8) % len(quips)]}”{RESET}"
    frame.out = [header(state, now, frame.width), news, ""]
    room = term_rows - 1 - TOP_ROWS - 1 - (LANE_ROWS if frame.gfx else 0)
    spots = render_cards(state, now, frame, room)
    footer(state, frame)
    if frame.gfx:
        aim_cat(state, now, spots, len(frame.out))
        render_lane(state, now, frame, home=None if spots else frame.width - 8)
    return frame.out, frame.pics


def frame_delay(state):
    """Animate smoothly while something moves; tick slowly while everything naps."""
    if not state["gfx"]:
        return IDLE_FRAME_S
    now = time.time()
    stirring = any(session_state(state, p, now)[0] == "brewing" for p in brewable(state))
    pouring = any(now - seen < POUR_S + 0.5 for seen in state["first_seen"].values())
    busy = stirring or pouring or state["leaving"] or "mouse" in state or "guest" in state
    if busy or state["cat"].moving():
        return FRAME_S
    return IDLE_FRAME_S


def who(state, pid, kind):
    """An order's name for the news line, such as "Claude in caffe"."""
    project = state.get("projects", {}).get(pid)
    return DRINKS[kind][0] + (f" in {project}" if project else "")


def update(state):
    now = time.time()
    for pid in [p for p in state["leaving"] if gone(state, p, now)]:
        del state["leaving"][pid]
        state["knocked"].pop(pid, None)
        state.get("projects", {}).pop(pid, None)
    live = scan_agents()
    if live is None:
        return
    sessions = scan_copilot_sessions()
    if sessions is None:
        sessions = {
            pid: record
            for pid, record in state["live"].items()
            if record[0] == COPILOT_SESSION_KIND
        }
    live.update(sessions)
    take_orders(state, live, now)
    state["live"] = live
    state["initialized"] = True
    track_activity(state, live, now)
    notice_turns(state, now)
    # Rush hour: lots of agents working at once. The cat hurries.
    working = sum(word == "brewing" for word in state["words"].values())
    if working >= RUSH_AT and not state["rush"]:
        state["toast"] = (f"Rush hour! {working} agents brewing at once.", now + 5)
    state["rush"] = working >= RUSH_AT
    bar_clock(state, now)


def take_orders(state, live, now):
    """New sessions pour in; finished ones are served. Apps come and go quietly."""
    fresh = live.keys() - state["live"].keys()
    projects = state.setdefault("projects", {})
    terminal = [p for p in fresh if not is_app(live[p]) and live[p][0] != COPILOT_SESSION_KIND]
    projects.update((p, project_name(path)) for p, path in scan_cwds(terminal).items())
    for pid in fresh:
        state["first_seen"][pid] = now
        if not state["initialized"] or is_app(live[pid]):
            continue
        state["visit"] = pid
        kind, source = live[pid][:2]
        if kind == COPILOT_SESSION_KIND:
            message = f"New session: {source} ☕"
        else:
            where = f" in {projects[pid]}" if pid in projects else f" on {source}"
            message = f"New order: {DRINKS[kind][0]}{where} ☕"
        state["toast"] = (message, now + 4)
    for pid in state["live"].keys() - live.keys():
        kind, tty_name, started, _, _ = state["live"][pid]
        state["first_seen"].pop(pid, None)
        if kind == COPILOT_SESSION_KIND or tty_name.startswith("app:"):
            if state["cat"].target == pid:
                state["cat"].target = None
            continue
        dur = now - started
        state["leaving"][pid] = (kind, tty_name, now, started)
        state["visit"] = pid
        name = DRINKS[kind][0]
        state["orders"][name] = state["orders"].get(name, 0) + 1
        state["agent_time"] += now - max(started, state["start"])  # while the bar was open
        state["longest"] = max(state["longest"], (dur, name))
        state["toast"] = (f"Served: {who(state, pid, kind)}, after {fmt_dur(dur)} ✔", now + 5)


def notice_turns(state, now):
    """A session that finished its turn is ready: the cat goes to have a look.
    Left until it goes cold, the cat helps itself to the biscuit."""
    before = state.get("words", {})  # each session's state at the last poll
    biscuits = state.setdefault("biscuits", set())
    words = {p: session_state(state, p, now)[0] for p in brewable(state)}
    for pid, word in words.items():
        was, kind = before.get(pid), state["live"][pid][0]
        if word == "ready" and was not in (None, "ready"):
            state["visit"] = pid
            state["toast"] = (f"Order up! {who(state, pid, kind)} is waiting for you.", now + 6)
        elif word == "cold" and was == "ready":
            state["visit"] = pid
            biscuits.add(pid)
    biscuits.intersection_update(state["live"])
    state["words"] = words


def bar_clock(state, now):
    """Time of day: fika, a sleepier cat at night, and the odd mouse or stray."""
    cat, part = state["cat"], daypart(now)
    if part == "fika" and state.get("daypart") not in (None, "fika"):
        bun = fika_bun(now)
        state["toast"] = (f"Fika! {cat.name} sets out a {bun}.", now + 6)
        state["bun_bites"] = 0
    state["daypart"] = part
    cat.sleepy = part == "night"
    cat.speed = 12.0 if state["rush"] else (5.0 if cat.sleepy else 7.0)
    due = state.setdefault("due", set())
    if part != "fika":
        due.discard("nibble")
        state.pop("snack", None)
    elif random.random() < NIBBLE_ODDS:
        due.add("nibble")
    if random.random() < MOUSE_ODDS * (2 if cat.sleepy else 1):  # mice prefer the night
        due.add("mouse")
    if random.random() < GUEST_ODDS:
        due.add("guest")


def receipt(state, now):
    """The bill printed on quit: what was served, what broke, and the tip."""
    w, cat = 34, state["cat"]
    awake = now - state["start"]
    brewing = [
        s
        for s in state["live"].values()
        if s[0] != COPILOT_SESSION_KIND and not s[1].startswith("app:")
    ]
    agent_time = state["agent_time"] + sum(now - max(s[2], state["start"]) for s in brewing)
    orders = sorted(state["orders"].items(), key=lambda order: -order[1])
    items = [(f"Espresso · {name}", f"×{n}") for name, n in orders] or [("Cups served", "0")]
    if state["broken"]:
        items.append((f"Cups broken by {cat.name}", str(state["broken"])))
    if state.get("mice"):
        items.append((f"Mice caught by {cat.name}", str(state["mice"])))
    stats = [("Mac kept awake", fmt_dur(awake))]
    if agent_time >= 1:
        stats.append(("Agent time", f"{fmt_dur(agent_time)} ({agent_time / awake:.1f}×)"))
    if state["longest"][0] > 0:
        stats.append(("Longest pour", f"{fmt_dur(state['longest'][0])} ({state['longest'][1]})"))
    if brewing:
        stats.append(("Still brewing", str(len(brewing))))
    stats.append(("Barista", cat.name))
    if state.get("visitors"):
        stats.append(("Visiting cats", str(state["visitors"])))
    sections = [items, stats]
    tips = [f"{cat.pets} pet{'s' * (cat.pets > 1)} ♥"] if cat.pets else []
    if cat.fed:
        tips.append(f"{len(cat.fed)} treat{'s' * (len(cat.fed) > 1)}")
    if tips:  # one tip line, with the treats below the pets
        sections.append([(f"Tip for {cat.name}", tips[0]), *(("", t) for t in tips[1:])])
    order = f"Order #{state['order']:04d}"
    rule = f"  {'-' * w}"
    out = ["", rule, f"  {'CAFFE RECEIPT':^{w}}"]
    out.append(f"  {order}{time.strftime('%d %b %Y %H:%M', time.localtime(now)):>{w - len(order)}}")
    for rows in sections:
        out.append(rule)
        out += [f"  {k}{' ' * max(1, w - len(k) - len(v))}{v}" for k, v in rows]
    out += [rule, f"  {'Thanks, come again ☕':^{w}}", rule, ""]
    print("\n".join(out))


def start_caffeinate(saver=False):
    # -w ties caffeinate to our pid, so it stops even if caffe is killed. To save
    # battery, drop -d and -u so the display can sleep while the system stays up.
    flags = "-ims" if saver else "-dimsu"
    return subprocess.Popen(["/usr/bin/caffeinate", flags, "-w", str(os.getpid())])


def parse_battery(text):
    """(on battery, charge %) from `pmset -g batt`. Charge is None without a battery."""
    pct = re.search(r"(\d+)%", text)
    return "'Battery Power'" in text, int(pct[1]) if pct else None


def read_battery():
    try:
        out = subprocess.run(
            ["/usr/bin/pmset", "-g", "batt"], capture_output=True, text=True, timeout=5, check=False
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return parse_battery(out)


def check_power(state, caf):
    """On a low battery, let the display sleep; once plugged in, keep it on again.
    Returns the caffeinate process now running."""
    state["battery"] = battery = read_battery()
    if battery is None:  # couldn't tell: leave things as they are
        return caf
    saver = battery[0] and battery[1] is not None and battery[1] <= LOW_BATTERY
    if saver == state.get("saver", False):
        return caf
    state["saver"] = saver
    message = (
        f"Battery at {battery[1]}%. The display may sleep; agents keep brewing."
        if saver
        else "Plugged in. The display stays awake again."
    )
    state["toast"] = (message, time.time() + 6)
    caf.terminate()
    caf.wait()
    return start_caffeinate(saver)


TINY_PNG = (
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR4nGNgAAIAAAUAAXpeqz8AAAAASUVORK5CYII="
)


def kitty_graphics(fd):
    """Ask the terminal whether it can show pictures (kitty graphics protocol),
    and whether it can decode PNGs, for app icons. Returns (pictures, png). The
    device-attributes query after them is answered by every terminal, so we
    never wait longer than needed."""
    if os.environ.get("TMUX"):
        return False, False
    sys.stdout.write(
        f"\033_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\033\\\033_Gi=32,a=q,f=100;{TINY_PNG}\033\\\033[c"
    )
    sys.stdout.flush()
    reply, deadline = b"", time.time() + 1.0
    while time.time() < deadline and not re.search(rb"\033\[\?[\d;]*c", reply):
        if select.select([fd], [], [], 0.05)[0]:
            reply += os.read(fd, 1024)
    return b"_Gi=31;OK" in reply, b"_Gi=32;OK" in reply


def draw(state, now, gallery, shown):
    """Put this moment on screen. Returns the text lines now showing."""
    lines, pics = render(state, now)
    height = shutil.get_terminal_size((80, 24)).lines - 1
    lines = lines[:height]
    # Only rewrite lines that changed, so a quiet bar costs almost nothing.
    out = [
        f"\033[{y + 1};1H{line}\033[K"
        for y, line in enumerate(lines)
        if y >= len(shown) or shown[y] != line
    ]
    if len(lines) < len(shown):
        out.append(f"\033[{len(lines) + 1};1H\033[J")
    # The tab title tells you how the bar is doing while you're in another tab.
    title = f"☕ {tally(state, now) or 'caffe'}"
    if title != state.get("title"):
        state["title"] = title
        out.append(f"\033]2;{title}\007")
    if state["gfx"]:
        out.append(gallery.sync({o: p for o, p in pics.items() if p[2] < height}))
    if out:
        sys.stdout.write("".join(out))
        sys.stdout.flush()
    return lines


def on_key(state, key):
    """Handle a key press. Returns True to close the bar."""
    cat, now = state["cat"], time.time()
    if key == "p":
        cat.pet(now)
        state["toast"] = (f"{cat.name} purrs. ♥", now + 3)
    elif key == "f":
        ate = cat.feed(now)
        treat = f"{cat.name} munches a treat." if ate else f"{cat.name} is full. Maybe later."
        state["toast"] = (treat, now + 3)
    return key == "q"


INSTALL_URL = "https://raw.githubusercontent.com/alexgnq/caffe/main/install.sh"


def self_update():
    """Run the install script over this copy, wherever it was installed.
    Returns the exit code."""
    try:
        script = subprocess.run(
            ["/usr/bin/curl", "-fsSL", INSTALL_URL], check=True, capture_output=True, timeout=30
        ).stdout
    except (OSError, subprocess.SubprocessError):
        print("caffe update: couldn't download the installer.", file=sys.stderr)
        return 1
    bin_dir = os.path.dirname(os.path.abspath(sys.argv[0]))
    env = {**os.environ, "CAFFE_BIN_DIR": bin_dir}
    return subprocess.run(["/bin/sh"], input=script, env=env, check=False).returncode


def check_args():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        sys.exit(0)
    if sys.argv[1:] == ["update"]:
        sys.exit(self_update())
    if sys.argv[1:]:
        sys.exit("usage: caffe [update]   (press q to quit)")
    if not sys.stdin.isatty():
        sys.exit("caffe needs an interactive terminal.")


def main():
    check_args()
    caf = start_caffeinate()
    cat = Cat(time.time(), HOME_X)
    state = {
        "start": time.time(),
        "live": {},
        "leaving": {},
        "knocked": {},
        "first_seen": {},
        "orders": {},  # agent name: sessions served
        "agent_time": 0.0,
        "broken": 0,
        "order": random.randrange(1, 10000),
        "longest": (0, ""),
        "cat": cat,
        "toast": (
            GREETINGS.get(daypart(time.time()), "{} is on shift today.").format(
                cat.title, bun=fika_bun(time.time())
            ),
            time.time() + 6,
        ),
        "initialized": False,
        "gfx": False,
        "rush": False,
    }

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    resized = [False]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    gallery = Gallery()
    # Save the tab title, then switch to the alternate screen with no cursor and no
    # autowrap: a line too long for a narrow pane is cut off instead of spilling
    # onto the next row.
    sys.stdout.write("\033[22;2t\033[?1049h\033[?25l\033[?7l")
    try:
        tty.setcbreak(fd)
        state["gfx"], state["png"] = kitty_graphics(fd)
        last_poll, last_power, shown = 0.0, 0.0, []
        while True:
            now = time.time()
            if now - last_poll >= POLL_S:
                update(state)
                last_poll = now
            if now - last_power >= BATTERY_POLL_S:  # after update, so its toast stays up
                caf, last_power = check_power(state, caf), now
            if resized[0]:
                resized[0], shown = False, []
                sys.stdout.write((gallery.reset() if state["gfx"] else "") + "\033[2J")
            shown = draw(state, now, gallery, shown)
            r, _, _ = select.select([sys.stdin], [], [], frame_delay(state))
            if r and on_key(state, sys.stdin.read(1).lower()):
                break
            if caf.poll() is not None:
                caf = start_caffeinate(state.get("saver", False))
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if state["gfx"]:
            sys.stdout.write("\033_Ga=d,d=A,q=2\033\\")
        sys.stdout.write("\033[?7h\033[?25h\033[?1049l\033[23;2t")
        sys.stdout.flush()
        caf.terminate()
        receipt(state, time.time())


if __name__ == "__main__":
    main()
